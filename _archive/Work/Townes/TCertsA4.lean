      have e := (hc t ⟨h1.le, ht.2⟩).1
      have hl := lower_of pt99 hσ.1 hσ.2
      rw [abs_le] at e
      linarith [e.1]
  all_goals rw [abs_le]; constructor <;> linarith [he.1.1, he.1.2, he.2.1, he.2.2]

end Work.Townes.TCertsA
