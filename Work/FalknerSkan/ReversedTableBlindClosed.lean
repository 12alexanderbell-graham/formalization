    fun h η hη => (h η hη).derivWithin (hu η hη)
  have Q : ContDiffOn ℝ 1 q (Ici 0) := by
    rw [show (1 : WithTop ℕ∞) = 0 + 1 from rfl, contDiffOn_succ_iff_derivWithin hu]
    refine ⟨fun η hη => (hq η hη).differentiableWithinAt, by simp, ?_⟩
