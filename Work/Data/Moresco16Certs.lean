/-- If √y is within ε of s and |c s − d| ≤ A, then (c √y − d)²/σ² ≤ (A + c ε)²/σ². -/
theorem term_le {c y d σ s ε A U : ℝ} (hc : 0 ≤ c) (hε0 : 0 ≤ ε) (hε : 0 ≤ s - ε) (h1 : (s - ε) ^ 2 ≤ y)
    (h2 : y ≤ (s + ε) ^ 2) (hA1 : -A ≤ c * s - d) (hA2 : c * s - d ≤ A)
    (hU : (A + c * ε) ^ 2 / σ ^ 2 ≤ U) : (c * Real.sqrt y - d) ^ 2 / σ ^ 2 ≤ U := by
  have hy : 0 ≤ y := le_trans (sq_nonneg _) h1
  have hlo : s - ε ≤ Real.sqrt y := Real.le_sqrt_of_sq_le h1
  have hhi : Real.sqrt y ≤ s + ε := by
    rw [show s + ε = Real.sqrt ((s + ε) ^ 2) by rw [Real.sqrt_sq (by linarith)]]
    exact Real.sqrt_le_sqrt h2
  have k1 : c * (s - ε) ≤ c * Real.sqrt y := mul_le_mul_of_nonneg_left hlo hc
  have k2 : c * Real.sqrt y ≤ c * (s + ε) := mul_le_mul_of_nonneg_left hhi hc
  have hsq : (c * Real.sqrt y - d) ^ 2 ≤ (A + c * ε) ^ 2 := by
    apply sq_le_sq'
    · nlinarith
    · nlinarith
  exact le_trans (div_le_div_of_nonneg_right hsq (sq_nonneg σ)) hU

