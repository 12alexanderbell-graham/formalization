theorem glue {P : ℝ → Prop} {a b : ℝ} (h1 : ∀ t ∈ Icc 0 a, P t) (h2 : ∀ t ∈ Icc a b, P t) :
    ∀ t ∈ Icc 0 b, P t := by
  intro t ht
  rcases le_total t a with h | h
  · exact h1 t ⟨ht.1, h⟩
  · exact h2 t ⟨h, ht.2⟩

/-- Every solution of g' = p, p' = q, q' = −g q − 1 + p² on [0, 15/2] (derivatives within the
interval) with g(0) = p(0) = 0, q(0) = 1.2325876569: overshoot: p > 1 at the end and q > 0 throughout. -/
theorem chain {g p q : ℝ → ℝ}
    (hg : ∀ t ∈ Icc (0 : ℝ) (15 / 2 : ℝ), HasDerivWithinAt g (p t) (Icc 0 (15 / 2 : ℝ)) t)
    (hp : ∀ t ∈ Icc (0 : ℝ) (15 / 2 : ℝ), HasDerivWithinAt p (q t) (Icc 0 (15 / 2 : ℝ)) t)
    (hq : ∀ t ∈ Icc (0 : ℝ) (15 / 2 : ℝ), HasDerivWithinAt q (-(g t * q t) - 1 + p t ^ 2) (Icc 0 (15 / 2 : ℝ)) t)
    (h0 : g 0 = 0) (h1 : p 0 = 0) (h2 : q 0 = 1.2325876569) :
    1 < p (15 / 2 : ℝ) ∧ ∀ t ∈ Icc (0 : ℝ) (15 / 2 : ℝ), 0 < q t := by
  have hX : (((15/2 : ℚ) : ℚ) : ℝ) = (15 / 2 : ℝ) := by norm_num
  have hs : Sol (((15/2 : ℚ) : ℚ) : ℝ) 0 g p q := by rw [hX]; exact ⟨hg, hp, hq⟩
  have b0 : InBox c0 g p q := by
    simp only [InBox, V, c0, List.headD_cons]; push_cast
    simp only [h0, h1, h2]; norm_num
  have z0 : ((c0.t0 : ℚ) : ℝ) = 0 := by simp [c0]

  obtain ⟨b1, P0⟩ := segS_q0 (Φ := (fun _ _ q t => 0 < q t)) (fun c hok hsd => sideO_spec c hok hsd) c6 [c1, c2, c3, c4, c5] c0 seg0_ok hs b0
  rw [z0] at P0
  obtain ⟨b2, P1⟩ := segS_q0 (Φ := (fun _ _ q t => 0 < q t)) (fun c hok hsd => sideO_spec c hok hsd) c12 [c7, c8, c9, c10, c11] c6 seg1_ok hs b1
  have A1 := glue P0 P1
  obtain ⟨b3, P2⟩ := segS_q0 (Φ := (fun _ _ q t => 0 < q t)) (fun c hok hsd => sideO_spec c hok hsd) c18 [c13, c14, c15, c16, c17] c12 seg2_ok hs b2
  have A2 := glue A1 P2
  obtain ⟨b4, P3⟩ := segS_q0 (Φ := (fun _ _ q t => 0 < q t)) (fun c hok hsd => sideO_spec c hok hsd) c24 [c19, c20, c21, c22, c23] c18 seg3_ok hs b3
  have A3 := glue A2 P3
  obtain ⟨b5, P4⟩ := segS_q0 (Φ := (fun _ _ q t => 0 < q t)) (fun c hok hsd => sideO_spec c hok hsd) c30 [c25, c26, c27, c28, c29] c24 seg4_ok hs b4
  have A4 := glue A3 P4
  obtain ⟨b6, P5⟩ := segS_q0 (Φ := (fun _ _ q t => 0 < q t)) (fun c hok hsd => sideO_spec c hok hsd) c36 [c31, c32, c33, c34, c35] c30 seg5_ok hs b5
  have A5 := glue A4 P5
  obtain ⟨b7, P6⟩ := segS_q0 (Φ := (fun _ _ q t => 0 < q t)) (fun c hok hsd => sideO_spec c hok hsd) c42 [c37, c38, c39, c40, c41] c36 seg6_ok hs b6
  have A6 := glue A5 P6
  obtain ⟨b8, P7⟩ := segS_q0 (Φ := (fun _ _ q t => 0 < q t)) (fun c hok hsd => sideO_spec c hok hsd) c48 [c43, c44, c45, c46, c47] c42 seg7_ok hs b7
  have A7 := glue A6 P7
  obtain ⟨b9, P8⟩ := segS_q0 (Φ := (fun _ _ q t => 0 < q t)) (fun c hok hsd => sideO_spec c hok hsd) c54 [c49, c50, c51, c52, c53] c48 seg8_ok hs b8
