namespace Work.Chemistry.PRReduced

open Real Set

noncomputable def g (θ x : ℝ) : ℝ := θ / (x - 1) - 1 / (x ^ 2 + 2 * x - 1)

noncomputable def ψ (θ p x : ℝ) : ℝ :=
  θ * Real.log (x - 1) + Real.sqrt 2 / 4 * (Real.log (x + 1 + Real.sqrt 2) - Real.log (x + 1 - Real.sqrt 2))
    - p * x

def q (θ x : ℝ) : ℝ := (2 * x + 2) * (x - 1) ^ 2 - θ * (x ^ 2 + 2 * x - 1) ^ 2

def dq (θ x : ℝ) : ℝ := 2 * (x - 1) * (3 * x + 1) - 4 * θ * (x ^ 2 + 2 * x - 1) * (x + 1)

