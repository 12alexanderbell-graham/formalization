        have := antiR (77543 / 100) x₂ (by linarith) hy ⟨hxa3, le_rfl⟩ hy.2
        linarith) ⟨le_rfl, hxa3⟩ ⟨hxa3, le_rfl⟩ hxa3
    have hB : ψ θ (1173 / 12500000) x₁ ≤ ψ θ (1173 / 12500000) (12148181 / 10000000)
        + (12148181 / 10000000 - 607409 / 500000) * (1173 / 12500000 - g θ (12148181 / 10000000)) := by
      rcases le_or_gt x₁ (12148181 / 10000000) with h | h
      · have m := ψ_mono (θ := θ) (p := g θ (12148181 / 10000000)) h1 (fun y hy =>
          antiL x₁ (12148181 / 10000000) h1 (by linarith) hy ⟨h, le_rfl⟩ hy.2) ⟨le_rfl, h⟩ ⟨h, le_rfl⟩ h
        have e1 := ψ_shift θ (1173 / 12500000) (g θ (12148181 / 10000000)) x₁
        have e2 := ψ_shift θ (1173 / 12500000) (g θ (12148181 / 10000000)) (12148181 / 10000000)
        have := mul_le_mul_of_nonneg_left (by linarith : (12148181 / 10000000 : ℝ) - x₁ ≤ 12148181 / 10000000 - 607409 / 500000)
          (by linarith : (0:ℝ) ≤ 1173 / 12500000 - g θ (12148181 / 10000000))
        nlinarith
      · have m := ψ_anti (θ := θ) (p := 1173 / 12500000) (by norm_num) (fun y hy => by
          have := antiL (12148181 / 10000000) x₁ (by norm_num) hx1.le ⟨le_rfl, h.le⟩ hy hy.1
          linarith) ⟨le_rfl, h.le⟩ ⟨h.le, le_rfl⟩ h.le
        have : 0 ≤ (12148181 / 10000000 - 607409 / 500000 : ℝ) * (1173 / 12500000 - g θ (12148181 / 10000000)) :=
          mul_nonneg (by norm_num) (by linarith)
