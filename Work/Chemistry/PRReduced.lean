  ⟨(Real.lt_sqrt (by norm_num)).2 (by norm_num), (Real.sqrt_lt' (by norm_num)).2 (by norm_num)⟩

lemma hasDerivAt_g (θ : ℝ) {x : ℝ} (hx : 1 < x) :
    HasDerivAt (g θ) (q θ x / ((x - 1) ^ 2 * (x ^ 2 + 2 * x - 1) ^ 2)) x := by
  have h1 : x - 1 ≠ 0 := by linarith
  have h2 : x ^ 2 + 2 * x - 1 ≠ 0 := by nlinarith
  have hA : HasDerivAt (fun y => θ / (y - 1)) (-θ / (x - 1) ^ 2) x := by
    have := (((hasDerivAt_id x).sub_const 1).inv h1).const_mul θ
    convert this using 1
    · ext y; simp [div_eq_mul_inv]
    · simp; field_simp
  have hB : HasDerivAt (fun y => 1 / (y ^ 2 + 2 * y - 1)) (-(2 * x + 2) / (x ^ 2 + 2 * x - 1) ^ 2) x := by
    have := (((hasDerivAt_pow 2 x).add ((hasDerivAt_id x).const_mul 2)).sub_const 1).inv h2
    convert this using 1
    · ext y; simp
    · simp
  have hD2 : (x ^ 2 + 2 * x - 1) ^ 2 ≠ 0 := pow_ne_zero 2 h2
  have h12 : (x - 1) ^ 2 ≠ 0 := pow_ne_zero 2 h1
  have := hA.sub hB
  convert this using 1
  · ext y; simp [g]
  · unfold q
    rw [div_sub_div _ _ h12 hD2, div_eq_div_iff (mul_ne_zero h12 hD2) (mul_ne_zero h12 hD2)]
    ring

lemma key_sqrt2 {x : ℝ} (hx : 1 < x) :
    Real.sqrt 2 / 4 * (1 / (x + 1 + Real.sqrt 2) - 1 / (x + 1 - Real.sqrt 2)) = -(1 / (x ^ 2 + 2 * x - 1)) := by
  obtain ⟨r0, r1⟩ := sqrt2_bounds
  have hr2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  set r := Real.sqrt 2 with hr
  have h2 : x + 1 + r ≠ 0 := by linarith
  have h3 : x + 1 - r ≠ 0 := by linarith
  have hD : x ^ 2 + 2 * x - 1 ≠ 0 := by nlinarith
  have hprod : (x + 1 + r) * (x + 1 - r) = x ^ 2 + 2 * x - 1 := by linear_combination (-1 : ℝ) * hr2
  rw [div_sub_div _ _ h2 h3, hprod]
  field_simp
  linear_combination (-2 / (x ^ 2 + 2 * x - 1)) * hr2

lemma hasDerivAt_ψ (θ p : ℝ) {x : ℝ} (hx : 1 < x) : HasDerivAt (ψ θ p) (g θ x - p) x := by
  obtain ⟨r0, r1⟩ := sqrt2_bounds
  have h1 : x - 1 ≠ 0 := by linarith
  have h2 : x + 1 + Real.sqrt 2 ≠ 0 := by linarith
  have h3 : x + 1 - Real.sqrt 2 ≠ 0 := by linarith
  have hL1 := ((hasDerivAt_id x).sub_const 1).log h1
  have hL2 := (((hasDerivAt_id x).add_const 1).add_const (Real.sqrt 2)).log h2
  have hL3 := (((hasDerivAt_id x).add_const 1).sub_const (Real.sqrt 2)).log h3
  have := ((hL1.const_mul θ).add ((hL2.sub hL3).const_mul (Real.sqrt 2 / 4))).sub
    ((hasDerivAt_id x).const_mul p)
  convert this using 1
  · ext y; simp [ψ]
  · have k := key_sqrt2 hx
    simp only [g, id]
    simp only [one_div] at k ⊢
    linear_combination (-1 : ℝ) * k

lemma hasDerivAt_q (θ x : ℝ) : HasDerivAt (q θ) (dq θ x) x := by
  have := ((((hasDerivAt_id x).const_mul 2).add_const 2).mul
    (((hasDerivAt_id x).sub_const 1).pow 2)).sub
    (((((hasDerivAt_pow 2 x).add ((hasDerivAt_id x).const_mul 2)).sub_const 1).pow 2).const_mul θ)
  convert this using 1
  · ext y; simp [q]
  · simp [dq]; ring

lemma continuousOn_g (θ : ℝ) {s t : ℝ} (hs : 1 < s) : ContinuousOn (g θ) (Icc s t) := fun x hx =>
  (hasDerivAt_g θ (by linarith [hx.1] : 1 < x)).continuousAt.continuousWithinAt

lemma continuousOn_ψ (θ p : ℝ) {s t : ℝ} (hs : 1 < s) : ContinuousOn (ψ θ p) (Icc s t) :=
  fun x hx => (hasDerivAt_ψ θ p (by linarith [hx.1] : 1 < x)).continuousAt.continuousWithinAt

lemma log_series' (x : ℝ) (h : |x| < 1) (n : ℕ) :
    |(∑ i ∈ Finset.range n, x ^ (i + 1) / (i + 1)) + Real.log (1 - x)| ≤ |x| ^ (n + 1) / (1 - |x|) :=
  Real.abs_log_sub_add_sum_range_le h n

