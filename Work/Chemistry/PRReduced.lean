    nlinarith
  · by_contra hgt
    push Not at hgt
    obtain ⟨gb1, ga3, gb3⟩ := num_hi hθ0 hθ1
    have hxb1 : x₁ ≤ 12148181 / 10000000 := by
      by_contra h
      push Not at h
      have := antiL (12148181 / 10000000) x₁ (by norm_num) hx1.le ⟨le_rfl, h.le⟩ ⟨h.le, le_rfl⟩ h.le
      linarith
    have hxb3 : x₂ ≤ 774927 / 1000 := by
