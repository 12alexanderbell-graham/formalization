lemma K_lo : 0 < ψ θ (1309 / 12500000) (1955529 / 2500) - ψ θ (1309 / 12500000) (1226949 / 1000000)
    - (1226949 / 1000000 - 766843 / 625000) * (1309 / 12500000 - g θ (1226949 / 1000000)) := by
  have hA := logA_lo
  have hB := logB_lo
  rw [Real.log_div (by norm_num) (by norm_num)] at hA
  rw [Real.log_div (x := (1955529 / 2500 + 1) / (1955529 / 2500))
      (y := (1226949 / 1000000 + 1) / (1226949 / 1000000)) (by norm_num) (by norm_num),
    Real.log_div (x := 1955529 / 2500 + 1) (y := 1955529 / 2500) (by norm_num) (by norm_num),
    Real.log_div (x := 1226949 / 1000000 + 1) (y := 1226949 / 1000000) (by norm_num) (by norm_num)] at hB
  set L1 := Real.log ((1955529 / 2500 : ℝ) - 1) - Real.log ((1226949 / 1000000 : ℝ) - 1) with hL1
  set L2 := (Real.log ((1955529 / 2500 : ℝ) + 1) - Real.log (1955529 / 2500)) -
    (Real.log ((1226949 / 1000000 : ℝ) + 1) - Real.log (1226949 / 1000000)) with hL2
  have e : ψ θ (1309 / 12500000) (1955529 / 2500) - ψ θ (1309 / 12500000) (1226949 / 1000000)
      - (1226949 / 1000000 - 766843 / 625000) * (1309 / 12500000 - g θ (1226949 / 1000000))
      = θ * (L1 + (1226949 / 1000000 - 766843 / 625000) / (1226949 / 1000000 - 1)) + L2
        - 1309 / 12500000 * (1955529 / 2500 - 1226949 / 1000000)
        - (1226949 / 1000000 - 766843 / 625000) * (1309 / 12500000
          + 1 / ((1226949 / 1000000) ^ 2 + 1226949 / 1000000)) := by
    rw [hL1, hL2]; unfold ψ g; ring
  rw [e]
  have hm : 830836419 / 10000000000 * (8143876001061 / 1000000000000
      + (1226949 / 1000000 - 766843 / 625000) / (1226949 / 1000000 - 1))
      ≤ θ * (L1 + (1226949 / 1000000 - 766843 / 625000) / (1226949 / 1000000 - 1)) :=
    mul_le_mul hθ0 (by linarith) (by norm_num) (by linarith)
  have hn : (0:ℝ) < 830836419 / 10000000000 * (8143876001061 / 1000000000000
      + (1226949 / 1000000 - 766843 / 625000) / (1226949 / 1000000 - 1)) + (-594824277459 / 1000000000000)
        - 1309 / 12500000 * (1955529 / 2500 - 1226949 / 1000000)
        - (1226949 / 1000000 - 766843 / 625000) * (1309 / 12500000
          + 1 / ((1226949 / 1000000) ^ 2 + 1226949 / 1000000)) := by norm_num
  linarith

lemma K_hi : ψ θ (26189 / 250000000) (7819391 / 10000) - ψ θ (26189 / 250000000) (12269489 / 10000000)
    + (7819391 / 10000 - 7819389 / 10000) * (26189 / 250000000 - g θ (7819391 / 10000)) < 0 := by
  have hC := logC_hi
