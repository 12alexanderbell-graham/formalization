        linarith) ⟨le_rfl, hxb1⟩ ⟨hxb1, le_rfl⟩ hxb1
    have hR : ψ θ (26189 / 250000000) x₂ ≤ ψ θ (26189 / 250000000) (7819391 / 10000)
