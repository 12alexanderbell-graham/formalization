  rw [e]
  norm_num at hC0
  have hm : θ * (L1 - (7819391 / 10000 - 7819389 / 10000) / (7819391 / 10000 - 1))
      ≤ 83083657 / 1000000000 * (203588189243 / 25000000000
        - (7819391 / 10000 - 7819389 / 10000) / (7819391 / 10000 - 1)) :=
    mul_le_mul hθ1 (by linarith) (by norm_num; linarith) (by norm_num)
