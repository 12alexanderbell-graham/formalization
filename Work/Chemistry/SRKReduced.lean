lemma ratio_acentric {r : ℝ} (h1 : (1018337 / 100000000) ≤ r) (h2 : r ≤ (1018689 / 100000000)) :
    RoundsTo r 0.0102 4 ∧ RoundsTo (-Real.logb 10 r - 1) 0.992 3 := by
  have hr : 0 < r := by linarith
  refine ⟨?_, ?_⟩
  · unfold RoundsTo; rw [abs_le]; constructor <;> norm_num <;> linarith
  · have a1 := logR_lo
    have a2 := logR_hi
    have a3 := log1000_lo
    have a4 := log1000_hi
    have m1 : Real.log (1018337 / 100000000) ≤ Real.log r := Real.log_le_log (by norm_num) h1
    have m2 : Real.log r ≤ Real.log (1018689 / 100000000) := Real.log_le_log hr h2
    have e : Real.log (1000 : ℝ) = 3 * Real.log 10 := by
      rw [show (1000 : ℝ) = 10 ^ 3 by norm_num, Real.log_pow]; norm_num
    have hL0 : 0 < Real.log 10 := Real.log_pos (by norm_num)
    have A : -19925 / 10000 * Real.log 10 ≤ Real.log r := by linarith
    have B : Real.log r ≤ -19915 / 10000 * Real.log 10 := by linarith
    have A' : -19925 / 10000 ≤ Real.log r / Real.log 10 := (le_div_iff₀ hL0).2 A
    have B' : Real.log r / Real.log 10 ≤ -19915 / 10000 := (div_le_iff₀ hL0).2 B
    unfold RoundsTo Real.logb
    generalize Real.log r / Real.log 10 = t at A' B' ⊢
    rw [abs_le]
    constructor <;> norm_num <;> linarith

lemma alg_cancel (A B K P : ℝ) (hB : B ≠ 0) (hK : K ≠ 0) (hP : P ≠ 0) :
    A * K ^ 2 / P / (B * K / P) ^ 2 / P = A / B ^ 2 := by
  field_simp

/-! ## The main statement, in molar volumes and pressures -/

set_option maxHeartbeats 4000000 in
/-- Core of `Work.Chemistry.SRKAcentric.srk_omega1_unique` (same statement). -/
theorem srk_unique_core (R ac b Tc vc vl vg ps : ℝ) (hac : 0 < ac) (hb : 0 < b)
    (hvc : b < vc)
    (hc : IsCriticalIsotherm (cubicP R ac b 1 0 Tc) vc)
    (hl : b < vl)
    (h : IsMaxwellCoexistence
      (cubicP R (ac * (1 + (0.480 + 1.574 * 1 - 0.176 * 1 ^ 2) *
        (1 - Real.sqrt (7 / 10))) ^ 2) b 1 0 (7 / 10 * Tc)) vl vg ps) :
    RoundsTo (ps / cubicP R ac b 1 0 Tc vc) 0.0102 4 ∧
      RoundsTo (acentric ps (cubicP R ac b 1 0 Tc vc)) 0.992 3 := by
  -- Proof: reduced variables `x = v_c/b` (root of x³ − 3x² − 3x − 1), `θ = RTb/a`, `π = p b²/a`;
  -- the window of `window_of_maxwell` for θ(0.7 T_c) = 0.7 θ_c / α, θ_c = 3x − 9 − 9/x,
  -- α = (1 + κ(1)(1 − √0.7))²; then p_s/P_c = π · α · (x/9)/(x²/3 − x − 1)² and ω from `ratio_acentric`.
  have hD : 0 < vc ^ 2 + 1 * b * vc + 0 * b ^ 2 := by nlinarith
  obtain ⟨hf, hx1, -, h2, h3⟩ := reduced R ac b 1 0 Tc vc hac hb (by norm_num) hvc hD hc
  set Pc := cubicP R ac b 1 0 Tc vc with hPc
  set x := vc / b with hx
  unfold critCubic at hf
  have hx1' : 0 < x - 1 := by linarith
  have hs2 : 0 < 2 * x + 1 := by linarith
  obtain ⟨lo, hi⟩ := root_bounds 1 x (38473221 / 10000000) (384732211 / 100000000) hx1
    (by linear_combination hf) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
  have hx0 : 0 < x := by linarith
  have e2 : ((x - 1) * (2 * x + 1) - (x ^ 2 + 1 * x + 0)) / ((x - 1) ^ 2 * (2 * x + 1))
      = x ^ 2 / 3 - x - 1 := by
    rw [div_eq_iff (by positivity)]; linear_combination (-2 * x ^ 2 / 3 + x) * hf
  have e3 : (x ^ 2 + 1 * x + 0) ^ 2 * ((x - 1) * (2 * x + 1) - (x ^ 2 + 1 * x + 0)) /
      ((x - 1) ^ 4 * (2 * x + 1) ^ 2) = x / 9 := by
    rw [div_eq_iff (by positivity)]
    linear_combination (-4 * x ^ 4 / 9 + x ^ 3 + 2 * x ^ 2 / 3 + x / 9) * hf
  rw [e2] at h2
  rw [e3] at h3
  have hOb0 : 0 < x ^ 2 / 3 - x - 1 := by nlinarith
  have hOb1 : x ^ 2 / 3 - x - 1 ≤ (384732211 / 100000000) ^ 2 / 3 - 384732211 / 100000000 - 1 := by
    nlinarith
  have hOb2 : (38473221 / 10000000) ^ 2 / 3 - 38473221 / 10000000 - 1 ≤ x ^ 2 / 3 - x - 1 := by
    nlinarith
  -- R T_c ≠ 0, P_c > 0 and R T_c > 0 are forced by the critical point
  have hRT : R * Tc ≠ 0 := by
    intro h0
    rw [h0, div_zero] at h2
    linarith
  have hR0 : R ≠ 0 := left_ne_zero_of_mul hRT
  have hTc0 : Tc ≠ 0 := right_ne_zero_of_mul hRT
  have hPc0 : 0 < Pc := by
    have : 0 < ac * Pc / (R * Tc) ^ 2 := by rw [h3]; exact div_pos hx0 (by norm_num)
    have hsq : 0 < (R * Tc) ^ 2 := by positivity
    have := (div_pos_iff_of_pos_right hsq).1 this
    exact pos_of_mul_pos_right this hac.le
  have hPcne : Pc ≠ 0 := hPc0.ne'
  -- θ at the critical point
  have hK : R * Tc * b / ac = 9 * (x ^ 2 / 3 - x - 1) / x := by
    have e : R * Tc * b / ac = (b * Pc / (R * Tc)) / (ac * Pc / (R * Tc) ^ 2) := by
      field_simp
    rw [e, h2, h3]; field_simp
  have hKe : 9 * (x ^ 2 / 3 - x - 1) / x = 3 * x - 9 - 9 / x := by
    field_simp; ring
  have hK0 : 3 * (38473221 / 10000000) - 9 - 9 / (38473221 / 10000000) ≤ 3 * x - 9 - 9 / x := by
    have : 9 / x ≤ 9 / (38473221 / 10000000) :=
      div_le_div_of_nonneg_left (by norm_num) (by norm_num) lo.le
    linarith
  have hK1 : 3 * x - 9 - 9 / x ≤ 3 * (384732211 / 100000000) - 9 - 9 / (384732211 / 100000000) := by
    have : 9 / (384732211 / 100000000) ≤ 9 / x :=
      div_le_div_of_nonneg_left (by norm_num) (by linarith) hi.le
    linarith
  have hKpos : 0 ≤ 3 * x - 9 - 9 / x := by
    have : (0 : ℝ) ≤ 3 * (38473221 / 10000000) - 9 - 9 / (38473221 / 10000000) := by norm_num
    linarith
  -- the Soave factor at 0.7 T_c
  have hS0 : (418330013 / 500000000 : ℝ) < Real.sqrt (7 / 10) :=
    (Real.lt_sqrt (by norm_num)).2 (by norm_num)
  have hS1 : Real.sqrt (7 / 10) < (836660027 / 1000000000 : ℝ) :=
    (Real.sqrt_lt' (by norm_num)).2 (by norm_num)
  set s := Real.sqrt (7 / 10) with hs
  have hk : (0.480 + 1.574 * 1 - 0.176 * 1 ^ 2 : ℝ) = 939 / 500 := by norm_num
  rw [hk] at h
  set α := (1 + 939 / 500 * (1 - s)) ^ 2 with hα
  have hα0 : (1 + 939 / 500 * (1 - (836660027 / 1000000000))) ^ 2 ≤ α :=
    pow_le_pow_left₀ (by norm_num) (by linarith) 2
  have hα1 : α ≤ (1 + 939 / 500 * (1 - (418330013 / 500000000))) ^ 2 :=
    pow_le_pow_left₀ (by linarith) (by linarith) 2
  have hαpos : 0 < α := lt_of_lt_of_le (by norm_num) hα0
  have ha0 : 0 < ac * α := mul_pos hac hαpos
  have hθ : R * (7 / 10 * Tc) * b / (ac * α) = 7 / 10 * (3 * x - 9 - 9 / x) / α := by
    rw [← hKe, ← hK]; field_simp
  have hθ0 : 830836419 / 10000000000 ≤ R * (7 / 10 * Tc) * b / (ac * α) := by
    rw [hθ]
    have m := div_le_div₀ (by positivity : (0 : ℝ) ≤ 7 / 10 * (3 * x - 9 - 9 / x))
      (mul_le_mul_of_nonneg_left hK0 (by norm_num : (0:ℝ) ≤ 7 / 10)) hαpos hα1
    have : (830836419 / 10000000000 : ℝ) ≤ 7 / 10 * (3 * (38473221 / 10000000) - 9 - 9 / (38473221 / 10000000)) /
        (1 + 939 / 500 * (1 - (418330013 / 500000000))) ^ 2 := by norm_num
    linarith
  have hθ1 : R * (7 / 10 * Tc) * b / (ac * α) ≤ 83083657 / 1000000000 := by
    rw [hθ]
    have m := div_le_div₀ (by norm_num)
      (mul_le_mul_of_nonneg_left hK1 (by norm_num : (0:ℝ) ≤ 7 / 10)) (by norm_num) hα0
    have : 7 / 10 * (3 * (384732211 / 100000000) - 9 - 9 / (384732211 / 100000000)) /
        (1 + 939 / 500 * (1 - (836660027 / 1000000000))) ^ 2 ≤ (83083657 / 1000000000 : ℝ) := by norm_num
    linarith
  obtain ⟨wlo, whi⟩ := window_of_maxwell R (ac * α) b (7 / 10 * Tc) vl vg ps ha0 hb hθ0 hθ1 hl h
  set pr := ps / (ac * α / b ^ 2) with hpr
  -- the pressure ratio
  have hps : pr * (ac * α / b ^ 2) = ps := by
    rw [hpr]; exact div_mul_cancel₀ ps (div_pos ha0 (pow_pos hb 2)).ne'
  have e1 : ac = x / 9 * (R * Tc) ^ 2 / Pc := by
    rw [← h3, div_mul_cancel₀ _ (pow_ne_zero 2 hRT), mul_div_assoc, div_self hPcne, mul_one]
  have e2' : b = (x ^ 2 / 3 - x - 1) * (R * Tc) / Pc := by
    rw [← h2, div_mul_cancel₀ _ hRT, mul_div_assoc, div_self hPcne, mul_one]
  have key : ac / b ^ 2 / Pc = (x / 9) / (x ^ 2 / 3 - x - 1) ^ 2 := by
    rw [e1, e2']
    exact alg_cancel (x / 9) (x ^ 2 / 3 - x - 1) (R * Tc) Pc hOb0.ne' hRT hPcne
  have hratio : ps / Pc = pr * α * ((x / 9) / (x ^ 2 / 3 - x - 1) ^ 2) := by
    rw [← hps]
    calc pr * (ac * α / b ^ 2) / Pc = pr * α * (ac / b ^ 2 / Pc) := by ring
      _ = _ := by rw [key]
  have hq0 : (38473221 / 10000000 / 9) / ((384732211 / 100000000) ^ 2 / 3 - 384732211 / 100000000 - 1) ^ 2
      ≤ (x / 9) / (x ^ 2 / 3 - x - 1) ^ 2 :=
    div_le_div₀ (by linarith) (by linarith) (pow_pos hOb0 2) (pow_le_pow_left₀ hOb0.le hOb1 2)
  have hq1 : (x / 9) / (x ^ 2 / 3 - x - 1) ^ 2
      ≤ (384732211 / 100000000 / 9) / ((38473221 / 10000000) ^ 2 / 3 - 38473221 / 10000000 - 1) ^ 2 :=
