  set L1 := Real.log ((7819391 / 10000 : ℝ) - 1) - Real.log ((12269489 / 10000000 : ℝ) - 1) with hL1
  set L2 := (Real.log ((7819391 / 10000 : ℝ) + 1) - Real.log (7819391 / 10000)) -
    (Real.log ((12269489 / 10000000 : ℝ) + 1) - Real.log (12269489 / 10000000)) with hL2
  have e : ψ θ (26189 / 250000000) (7819391 / 10000) - ψ θ (26189 / 250000000) (12269489 / 10000000)
      + (7819391 / 10000 - 7819389 / 10000) * (26189 / 250000000 - g θ (7819391 / 10000))
