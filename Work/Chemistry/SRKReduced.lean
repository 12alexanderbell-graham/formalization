theorem reduced_window {θ x₁ x₂ p : ℝ} (hθ0 : 830836419 / 10000000000 ≤ θ)
    (hθ1 : θ ≤ 83083657 / 1000000000) (h1 : 1 < x₁) (h12 : x₁ < x₂) (hg1 : g θ x₁ = p)
    (hg2 : g θ x₂ = p) (hψ : ψ θ p x₁ = ψ θ p x₂) : 1309 / 12500000 ≤ p ∧ p ≤ 26189 / 250000000 := by
  obtain ⟨η₁, η₂, hx1, h12', hx2, hq1, hq2⟩ := critical_points h1 h12 hg1 hg2 hψ
  obtain ⟨⟨l1, l2⟩, l3, l4⟩ := roots_loc hθ0 hθ1 (by linarith) h12' hq1 hq2
  have antiL : ∀ s t, 1 < s → t ≤ η₁ → AntitoneOn (g θ) (Icc s t) := fun s t hs ht =>
    g_anti hs (fun x hx => q_nonpos_left hθ0 hθ1 l1 l2 hq1 (by linarith [hx.1]) (by linarith [hx.2]))
  have antiR : ∀ s t, η₂ ≤ s → AntitoneOn (g θ) (Icc s t) := fun s t hs =>
    g_anti (by linarith) (fun x hx => q_nonpos_right hθ0 hθ1 l3 l4 hq2 (by linarith [hx.1]))
  constructor
  · by_contra hlt
    push Not at hlt
    obtain ⟨ga1, gb1, ga3⟩ := num_lo hθ0 hθ1
    have hxa1 : (766843 / 625000 : ℝ) ≤ x₁ := by
      by_contra h
      push Not at h
      have := antiL x₁ (766843 / 625000) h1 (by linarith) ⟨le_rfl, h.le⟩ ⟨h.le, le_rfl⟩ h.le
      linarith
    have hxa3 : (1955529 / 2500 : ℝ) ≤ x₂ := by
      by_contra h
      push Not at h
      have := antiR x₂ (1955529 / 2500) hx2.le ⟨le_rfl, h.le⟩ ⟨h.le, le_rfl⟩ h.le
      linarith
    have hA3 : ψ θ p (1955529 / 2500) ≤ ψ θ p x₂ :=
      ψ_mono (by norm_num) (fun y hy => by
        have := antiR (1955529 / 2500) x₂ (by linarith) hy ⟨hxa3, le_rfl⟩ hy.2
        linarith) ⟨le_rfl, hxa3⟩ ⟨hxa3, le_rfl⟩ hxa3
    have hB : ψ θ (1309 / 12500000) x₁ ≤ ψ θ (1309 / 12500000) (1226949 / 1000000)
        + (1226949 / 1000000 - 766843 / 625000) * (1309 / 12500000 - g θ (1226949 / 1000000)) := by
      rcases le_or_gt x₁ (1226949 / 1000000) with h | h
      · have m := ψ_mono (θ := θ) (p := g θ (1226949 / 1000000)) h1 (fun y hy =>
          antiL x₁ (1226949 / 1000000) h1 (by linarith) hy ⟨h, le_rfl⟩ hy.2) ⟨le_rfl, h⟩ ⟨h, le_rfl⟩ h
        have e1 := ψ_shift θ (1309 / 12500000) (g θ (1226949 / 1000000)) x₁
        have e2 := ψ_shift θ (1309 / 12500000) (g θ (1226949 / 1000000)) (1226949 / 1000000)
        have := mul_le_mul_of_nonneg_left (by linarith : (1226949 / 1000000 : ℝ) - x₁ ≤ 1226949 / 1000000 - 766843 / 625000)
          (by linarith : (0:ℝ) ≤ 1309 / 12500000 - g θ (1226949 / 1000000))
        nlinarith
      · have m := ψ_anti (θ := θ) (p := 1309 / 12500000) (by norm_num) (fun y hy => by
          have := antiL (1226949 / 1000000) x₁ (by norm_num) hx1.le ⟨le_rfl, h.le⟩ hy hy.1
          linarith) ⟨le_rfl, h.le⟩ ⟨h.le, le_rfl⟩ h.le
        have : 0 ≤ (1226949 / 1000000 - 766843 / 625000 : ℝ) * (1309 / 12500000 - g θ (1226949 / 1000000)) :=
          mul_nonneg (by norm_num) (by linarith)
        linarith
    have e1 := ψ_shift θ p (1309 / 12500000) x₁
    have e2 := ψ_shift θ p (1309 / 12500000) (1955529 / 2500)
    have hpos := mul_pos (sub_pos.2 hlt) (by linarith : (0:ℝ) < 1955529 / 2500 - x₁)
    have := K_lo hθ0 hθ1
    nlinarith
  · by_contra hgt
    push Not at hgt
    obtain ⟨gb1, ga3, gb3⟩ := num_hi hθ0 hθ1
    have hxb1 : x₁ ≤ 12269489 / 10000000 := by
      by_contra h
      push Not at h
      have := antiL (12269489 / 10000000) x₁ (by norm_num) hx1.le ⟨le_rfl, h.le⟩ ⟨h.le, le_rfl⟩ h.le
      linarith
    have hxb3 : x₂ ≤ 7819391 / 10000 := by
      by_contra h
      push Not at h
      have := antiR (7819391 / 10000) x₂ (by linarith) ⟨le_rfl, h.le⟩ ⟨h.le, le_rfl⟩ h.le
