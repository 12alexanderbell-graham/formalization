        - 26189 / 250000000 * (7819391 / 10000 - 12269489 / 10000000)
        + (7819391 / 10000 - 7819389 / 10000) * (26189 / 250000000
          + 1 / ((7819391 / 10000) ^ 2 + 7819391 / 10000)) < (0:ℝ) := by norm_num
