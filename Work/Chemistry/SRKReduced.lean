  rw [Real.log_div (by norm_num) (by norm_num)] at hC hC0
  rw [Real.log_div (x := (7819391 / 10000 + 1) / (7819391 / 10000))
      (y := (12269489 / 10000000 + 1) / (12269489 / 10000000)) (by norm_num) (by norm_num),
