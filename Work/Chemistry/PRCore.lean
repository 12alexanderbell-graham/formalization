lemma ratio_acentric {r : ℝ} (h1 : (114168923 / 10000000000) ≤ r) (h2 : r ≤ (114241943 / 10000000000)) :
    RoundsTo r 0.0114 4 ∧ RoundsTo (-Real.logb 10 r - 1) 0.942 3 := by
  have hr : 0 < r := by linarith
  refine ⟨?_, ?_⟩
  · unfold RoundsTo; rw [abs_le]; constructor <;> norm_num <;> linarith
  · have a1 := logR_lo
    have a2 := logR_hi
    have a3 := log1000_lo
    have a4 := log1000_hi
    have m1 : Real.log (114168923 / 10000000000) ≤ Real.log r := Real.log_le_log (by norm_num) h1
    have m2 : Real.log r ≤ Real.log (114241943 / 10000000000) := Real.log_le_log hr h2
    have e : Real.log (1000 : ℝ) = 3 * Real.log 10 := by
      rw [show (1000 : ℝ) = 10 ^ 3 by norm_num, Real.log_pow]; norm_num
    have hL0 : 0 < Real.log 10 := Real.log_pos (by norm_num)
    have A : -19425 / 10000 * Real.log 10 ≤ Real.log r := by linarith
    have B : Real.log r ≤ -19415 / 10000 * Real.log 10 := by linarith
    have A' : -19425 / 10000 ≤ Real.log r / Real.log 10 := (le_div_iff₀ hL0).2 A
    have B' : Real.log r / Real.log 10 ≤ -19415 / 10000 := (div_le_iff₀ hL0).2 B
    unfold RoundsTo Real.logb
    generalize Real.log r / Real.log 10 = t at A' B' ⊢
    rw [abs_le]
    constructor <;> norm_num <;> linarith

lemma alg_theta' (u w D N : ℝ) (hu : u ≠ 0) (hw : w ≠ 0) (hD : D ≠ 0) (hN : N ≠ 0) :
    (N / (u ^ 2 * w)) / (D ^ 2 * N / (u ^ 4 * w ^ 2)) = u ^ 2 * w / D ^ 2 := by
  field_simp

lemma alg_ratio' (u w D N : ℝ) (hu : u ≠ 0) (hw : w ≠ 0) (hD : D ≠ 0) (hN : N ≠ 0) :
    (D ^ 2 * N / (u ^ 4 * w ^ 2)) / (N / (u ^ 2 * w)) ^ 2 = D ^ 2 / N := by
  field_simp

lemma alg_theta (x : ℝ) (h1 : x - 1 ≠ 0) (h2 : 2 * x + 2 ≠ 0) (hD : x ^ 2 + 2 * x - 1 ≠ 0)
    (hN : x ^ 2 - 2 * x - 1 ≠ 0) :
    ((x ^ 2 - 2 * x - 1) / ((x - 1) ^ 2 * (2 * x + 2))) /
      ((x ^ 2 + 2 * x - 1) ^ 2 * (x ^ 2 - 2 * x - 1) / ((x - 1) ^ 4 * (2 * x + 2) ^ 2))
      = (x - 1) ^ 2 * (2 * x + 2) / (x ^ 2 + 2 * x - 1) ^ 2 :=
  alg_theta' _ _ _ _ h1 h2 hD hN

lemma alg_ratio (x : ℝ) (h1 : x - 1 ≠ 0) (h2 : 2 * x + 2 ≠ 0) (hD : x ^ 2 + 2 * x - 1 ≠ 0)
    (hN : x ^ 2 - 2 * x - 1 ≠ 0) :
    ((x ^ 2 + 2 * x - 1) ^ 2 * (x ^ 2 - 2 * x - 1) / ((x - 1) ^ 4 * (2 * x + 2) ^ 2)) /
      ((x ^ 2 - 2 * x - 1) / ((x - 1) ^ 2 * (2 * x + 2))) ^ 2
      = (x ^ 2 + 2 * x - 1) ^ 2 / (x ^ 2 - 2 * x - 1) :=
  alg_ratio' _ _ _ _ h1 h2 hD hN

lemma alg_cancel (A B K P : ℝ) (hB : B ≠ 0) (hK : K ≠ 0) (hP : P ≠ 0) :
    A * K ^ 2 / P / (B * K / P) ^ 2 / P = A / B ^ 2 := by
  field_simp

