    linarith
  have r2 : ps / Pc ≤ (114241943 / 10000000000) := by
    rw [hratio]
    have m1 := mul_le_mul whi hα1 hαpos.le (by norm_num)
    have m2 := mul_le_mul m1 hq1 (by positivity) (by norm_num)
    have : (939 / 10000000) * (1 + 82349 / 50000 * (1 - (418330013 / 500000000))) ^ 2 *
