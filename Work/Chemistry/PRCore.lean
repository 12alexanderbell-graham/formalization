theorem pr_unique_core (R ac b Tc vc vl vg ps : ℝ) (hac : 0 < ac) (hb : 0 < b)
    (hvc : b < vc)
    (hc : IsCriticalIsotherm (cubicP R ac b 2 (-1) Tc) vc)
    (hl : b < vl)
    (h : IsMaxwellCoexistence
      (cubicP R (ac * (1 + (0.37464 + 1.54226 * 1 - 0.26992 * 1 ^ 2) * (1 - Real.sqrt (7 / 10))) ^ 2)
        b 2 (-1) (7 / 10 * Tc)) vl vg ps) :
    RoundsTo (ps / cubicP R ac b 2 (-1) Tc vc) 0.0114 4 ∧
      RoundsTo (acentric ps (cubicP R ac b 2 (-1) Tc vc)) 0.942 3 := by
  have hD : 0 < vc ^ 2 + 2 * b * vc + (-1) * b ^ 2 := by nlinarith
  obtain ⟨hf, hx1, -, h2, h3⟩ := reduced R ac b 2 (-1) Tc vc hac hb (by norm_num) hvc hD hc
  set Pc := cubicP R ac b 2 (-1) Tc vc with hPc
  set x := vc / b with hx
  unfold critCubic at hf
  obtain ⟨lo, hi⟩ := root_bounds 3 x (3951373 / 1000000) (39513731 / 10000000) hx1
    (by linear_combination hf) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
  have hx1' : 0 < x - 1 := by linarith
  have hDx : 0 < x ^ 2 + 2 * x - 1 := by nlinarith
  have hNx : 0 < x ^ 2 - 2 * x - 1 := by nlinarith
  have hNne : x ^ 2 - 2 * x - 1 ≠ 0 := hNx.ne'
  have hDne : x ^ 2 + 2 * x - 1 ≠ 0 := hDx.ne'
  have hx1ne : x - 1 ≠ 0 := hx1'.ne'
  have h2xne : 2 * x + 2 ≠ 0 := by linarith
  have e2 : ((x - 1) * (2 * x + 2) - (x ^ 2 + 2 * x + -1)) / ((x - 1) ^ 2 * (2 * x + 2))
      = (x ^ 2 - 2 * x - 1) / ((x - 1) ^ 2 * (2 * x + 2)) := by congr 1; ring
  have e3 : (x ^ 2 + 2 * x + -1) ^ 2 * ((x - 1) * (2 * x + 2) - (x ^ 2 + 2 * x + -1)) /
      ((x - 1) ^ 4 * (2 * x + 2) ^ 2)
      = (x ^ 2 + 2 * x - 1) ^ 2 * (x ^ 2 - 2 * x - 1) / ((x - 1) ^ 4 * (2 * x + 2) ^ 2) := by
    congr 1; ring
  rw [e2] at h2
  rw [e3] at h3
  set Ob := (x ^ 2 - 2 * x - 1) / ((x - 1) ^ 2 * (2 * x + 2)) with hOb
  set Oa := (x ^ 2 + 2 * x - 1) ^ 2 * (x ^ 2 - 2 * x - 1) / ((x - 1) ^ 4 * (2 * x + 2) ^ 2) with hOa
  have hOb0 : 0 < Ob := by positivity
  have hOa0 : 0 < Oa := by positivity
  -- R T_c ≠ 0 and P_c > 0 are forced by the critical point
  have hRT : R * Tc ≠ 0 := by
    intro h0
    rw [h0, div_zero] at h2
    linarith
  have hPc0 : 0 < Pc := by
    have : 0 < ac * Pc / (R * Tc) ^ 2 := by rw [h3]; exact hOa0
    have hsq : 0 < (R * Tc) ^ 2 := by positivity
    have := (div_pos_iff_of_pos_right hsq).1 this
    exact pos_of_mul_pos_right this hac.le
  have hRT0 : 0 < R * Tc := by
    have : 0 < b * Pc / (R * Tc) := by rw [h2]; exact hOb0
    rcases lt_or_gt_of_ne hRT with hn | hp
    · exfalso
      have : b * Pc / (R * Tc) < 0 := div_neg_of_pos_of_neg (by positivity) hn
      linarith
    · exact hp
  -- θ at the critical point
  have hθc : R * Tc * b / ac = (x - 1) ^ 2 * (2 * x + 2) / (x ^ 2 + 2 * x - 1) ^ 2 := by
    have e : R * Tc * b / ac = (b * Pc / (R * Tc)) / (ac * Pc / (R * Tc) ^ 2) := by
      field_simp
    rw [e, h2, h3, hOb, hOa]
    exact alg_theta x hx1ne h2xne hDne hNne
  -- the Soave factor at 0.7 T_c
  have hS0 : (418330013 / 500000000) < Real.sqrt (7 / 10) := (Real.lt_sqrt (by norm_num)).2 (by norm_num)
  have hS1 : Real.sqrt (7 / 10) < (836660027 / 1000000000) := (Real.sqrt_lt' (by norm_num)).2 (by norm_num)
  set s := Real.sqrt (7 / 10) with hs
  have hk : (0.37464 + 1.54226 * 1 - 0.26992 * 1 ^ 2 : ℝ) = 82349 / 50000 := by norm_num
  rw [hk] at h
  set α := (1 + 82349 / 50000 * (1 - s)) ^ 2 with hα
  have hα0 : (1 + 82349 / 50000 * (1 - (836660027 / 1000000000))) ^ 2 ≤ α :=
    pow_le_pow_left₀ (by norm_num) (by linarith) 2
  have hα1 : α ≤ (1 + 82349 / 50000 * (1 - (418330013 / 500000000))) ^ 2 :=
    pow_le_pow_left₀ (by linarith) (by linarith) 2
  have hαpos : 0 < α := lt_of_lt_of_le (by norm_num) hα0
  have ha0 : 0 < ac * α := mul_pos hac hαpos
  -- bounds of θ_c
  have hn0 : ((3951373 / 1000000) - 1) ^ 2 * (2 * (3951373 / 1000000) + 2) ≤ (x - 1) ^ 2 * (2 * x + 2) :=
    mul_le_mul (pow_le_pow_left₀ (by norm_num) (by linarith) 2) (by linarith) (by norm_num) (by positivity)
  have hn1 : (x - 1) ^ 2 * (2 * x + 2) ≤ ((39513731 / 10000000) - 1) ^ 2 * (2 * (39513731 / 10000000) + 2) :=
    mul_le_mul (pow_le_pow_left₀ (by linarith) (by linarith) 2) (by linarith) (by positivity) (by norm_num)
  have hd0 : ((3951373 / 1000000) ^ 2 + 2 * (3951373 / 1000000) - 1) ^ 2 ≤ (x ^ 2 + 2 * x - 1) ^ 2 :=
    pow_le_pow_left₀ (by norm_num) (by nlinarith) 2
  have hd1 : (x ^ 2 + 2 * x - 1) ^ 2 ≤ ((39513731 / 10000000) ^ 2 + 2 * (39513731 / 10000000) - 1) ^ 2 :=
    pow_le_pow_left₀ hDx.le (by nlinarith) 2
  have hθc0 : ((3951373 / 1000000) - 1) ^ 2 * (2 * (3951373 / 1000000) + 2) / ((39513731 / 10000000) ^ 2 + 2 * (39513731 / 10000000) - 1) ^ 2 ≤ R * Tc * b / ac := by
    rw [hθc]; exact div_le_div₀ (by positivity) hn0 (by positivity) hd1
  have hθc1 : R * Tc * b / ac ≤ ((39513731 / 10000000) - 1) ^ 2 * (2 * (39513731 / 10000000) + 2) / ((3951373 / 1000000) ^ 2 + 2 * (3951373 / 1000000) - 1) ^ 2 := by
    rw [hθc]; exact div_le_div₀ (by norm_num) hn1 (by norm_num) hd0
  have hθ : R * (7 / 10 * Tc) * b / (ac * α) = 7 / 10 * (R * Tc * b / ac) / α := by
    field_simp
  have hθ0 : (3697859261 / 50000000000) ≤ R * (7 / 10 * Tc) * b / (ac * α) := by
    rw [hθ]
    have hc0 : 0 ≤ ((3951373 / 1000000) - 1) ^ 2 * (2 * (3951373 / 1000000) + 2) / ((39513731 / 10000000) ^ 2 + 2 * (39513731 / 10000000) - 1) ^ 2 := by norm_num
    have m := div_le_div₀ (by linarith) (mul_le_mul_of_nonneg_left hθc0 (by norm_num : (0:ℝ) ≤ 7 / 10))
      hαpos hα1
    have : ((3697859261 / 50000000000) : ℝ) ≤ 7 / 10 * (((3951373 / 1000000) - 1) ^ 2 * (2 * (3951373 / 1000000) + 2) / ((39513731 / 10000000) ^ 2 + 2 * (39513731 / 10000000) - 1) ^ 2) /
        (1 + 82349 / 50000 * (1 - (418330013 / 500000000))) ^ 2 := by norm_num
    linarith
  have hθ1 : R * (7 / 10 * Tc) * b / (ac * α) ≤ (1848929961 / 25000000000) := by
    rw [hθ]
    have hθc' : 0 ≤ R * Tc * b / ac := by positivity
    have m := div_le_div₀ (by norm_num) (mul_le_mul_of_nonneg_left hθc1 (by norm_num : (0:ℝ) ≤ 7 / 10))
      (by norm_num) hα0
    have : 7 / 10 * (((39513731 / 10000000) - 1) ^ 2 * (2 * (39513731 / 10000000) + 2) / ((3951373 / 1000000) ^ 2 + 2 * (3951373 / 1000000) - 1) ^ 2) /
        (1 + 82349 / 50000 * (1 - (836660027 / 1000000000))) ^ 2 ≤ ((1848929961 / 25000000000) : ℝ) := by norm_num
    linarith
  obtain ⟨wlo, whi⟩ := window_of_maxwell R (ac * α) b (7 / 10 * Tc) vl vg ps ha0 hb hθ0 hθ1 hl h
  set pr := ps / (ac * α / b ^ 2) with hpr
  -- the pressure ratio
  have hratio : ps / Pc = pr * α * ((x ^ 2 + 2 * x - 1) ^ 2 / (x ^ 2 - 2 * x - 1)) := by
    have hb0 : b ≠ 0 := hb.ne'
    have hPcne : Pc ≠ 0 := hPc0.ne'
    have hRT2 : (R * Tc) ^ 2 ≠ 0 := pow_ne_zero 2 hRT
    have hps : ps = pr * (ac * α / b ^ 2) := by
      rw [hpr]; field_simp
    have e1 : ac = Oa * (R * Tc) ^ 2 / Pc := by rw [← h3]; field_simp; rw [div_self hRT]
    have e2' : b = Ob * (R * Tc) / Pc := by rw [← h2]; field_simp; rw [div_self hRT]
    have key : ac / b ^ 2 / Pc = (x ^ 2 + 2 * x - 1) ^ 2 / (x ^ 2 - 2 * x - 1) := by
      rw [e1, e2', alg_cancel Oa Ob (R * Tc) Pc hOb0.ne' hRT hPc0.ne', hOa, hOb]
      exact alg_ratio x hx1ne h2xne hDne hNne
    rw [hps]
    calc pr * (ac * α / b ^ 2) / Pc = pr * α * (ac / b ^ 2 / Pc) := by ring
      _ = _ := by rw [key]
  have hq0 : ((3951373 / 1000000) ^ 2 + 2 * (3951373 / 1000000) - 1) ^ 2 / ((39513731 / 10000000) ^ 2 - 2 * (39513731 / 10000000) - 1)
      ≤ (x ^ 2 + 2 * x - 1) ^ 2 / (x ^ 2 - 2 * x - 1) :=
    div_le_div₀ (by positivity) hd0 hNx (by nlinarith)
  have hq1 : (x ^ 2 + 2 * x - 1) ^ 2 / (x ^ 2 - 2 * x - 1)
      ≤ ((39513731 / 10000000) ^ 2 + 2 * (39513731 / 10000000) - 1) ^ 2 / ((3951373 / 1000000) ^ 2 - 2 * (3951373 / 1000000) - 1) :=
    div_le_div₀ (by norm_num) hd1 (by norm_num) (by nlinarith)
  have hpr0 : 0 ≤ pr := by linarith
  have r1 : ((114168923 / 10000000000) : ℝ) ≤ ps / Pc := by
    rw [hratio]
    have m1 := mul_le_mul wlo hα0 (by norm_num) hpr0
    have m2 := mul_le_mul m1 hq0 (by norm_num) (by positivity)
    have : ((114168923 / 10000000000) : ℝ) ≤ (1173 / 12500000) * (1 + 82349 / 50000 * (1 - (836660027 / 1000000000))) ^ 2 *
