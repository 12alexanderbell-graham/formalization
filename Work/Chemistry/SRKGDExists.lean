/-!
# SRK with the Graboski–Daubert κ: existence of the coexistence state (run 2026-11-06T0028Z)

Generated by `runs/2026-11-06T0028Z/scripts/variant.py` from `Work/Chemistry/SRKExists.lean`: equal
maxima of `ψ θ π` on a liquid and a gas window by the intermediate value theorem, for every `θ` in the
certified interval of `Work.Chemistry.SRKGDReduced.reduced_window` (brackets checked by
`gen_srk_exists.py srkgd`).
-/

namespace Work.Chemistry.SRKGDExists

open Real Set Work.Chemistry.SRKGDReduced

section
variable {θ : ℝ}

/-- `ψ θ` with the volume clamped to `x ≥ 1.1`. -/
noncomputable def ψc (θ p x : ℝ) : ℝ := ψ θ p (max x (11 / 10))

lemma ψc_eq {p x : ℝ} (h : 11 / 10 ≤ x) : ψc θ p x = ψ θ p x := by
  unfold ψc; rw [max_eq_left h]

lemma continuous_ψc : Continuous (fun z : ℝ × ℝ => ψc θ z.1 z.2) := by
  have hm : Continuous (fun z : ℝ × ℝ => max z.2 (11 / 10 : ℝ)) :=
    continuous_snd.max continuous_const
  have h1 : ∀ z : ℝ × ℝ, max z.2 (11 / 10 : ℝ) - 1 ≠ 0 := fun z =>
    (show (0:ℝ) < max z.2 (11 / 10) - 1 by linarith [le_max_right z.2 (11 / 10 : ℝ)]).ne'
  have h0 : ∀ z : ℝ × ℝ, max z.2 (11 / 10 : ℝ) ≠ 0 := fun z =>
    (show (0:ℝ) < max z.2 (11 / 10) by linarith [le_max_right z.2 (11 / 10 : ℝ)]).ne'
  have h2 : ∀ z : ℝ × ℝ, max z.2 (11 / 10 : ℝ) + 1 ≠ 0 := fun z =>
    (show (0:ℝ) < max z.2 (11 / 10) + 1 by linarith [le_max_right z.2 (11 / 10 : ℝ)]).ne'
  show Continuous (fun z : ℝ × ℝ => θ * Real.log (max z.2 (11 / 10) - 1)
    + (Real.log (max z.2 (11 / 10) + 1) - Real.log (max z.2 (11 / 10))) - z.1 * max z.2 (11 / 10))
  exact ((continuous_const.mul ((hm.sub continuous_const).log h1)).add
    (((hm.add continuous_const).log h2).sub (hm.log h0))).sub (continuous_fst.mul hm)

lemma continuous_ψc_left (p : ℝ) : Continuous (ψc θ p) :=
  continuous_ψc.comp (continuous_const.prodMk continuous_id)

/-- Gas-window maximum minus liquid-window maximum of `ψ θ π`. -/
noncomputable def Dgap (θ p : ℝ) : ℝ :=
  sSup (ψc θ p '' Icc 400 1200) - sSup (ψc θ p '' Icc (11 / 10) (7 / 5))

lemma continuous_Dgap : Continuous (Dgap θ) := by
  show Continuous (fun p => sSup (ψc θ p '' Icc 400 1200) - sSup (ψc θ p '' Icc (11 / 10) (7 / 5)))
  exact ((isCompact_Icc (a := (400:ℝ)) (b := 1200)).continuous_sSup
      (f := fun p x => ψc θ p x) continuous_ψc).sub
    ((isCompact_Icc (a := (11 / 10 : ℝ)) (b := 7 / 5)).continuous_sSup
      (f := fun p x => ψc θ p x) continuous_ψc)

lemma exists_max (p a b : ℝ) (ha : 11 / 10 ≤ a) (hab : a ≤ b) :
    ∃ x ∈ Icc a b, sSup (ψc θ p '' Icc a b) = ψ θ p x ∧ ∀ y ∈ Icc a b, ψ θ p y ≤ ψ θ p x := by
  obtain ⟨x, hx, h1, h2⟩ := (isCompact_Icc (a := a) (b := b)).exists_sSup_image_eq_and_ge
    (nonempty_Icc.2 hab) (continuous_ψc_left (θ := θ) p).continuousOn
  refine ⟨x, hx, ?_, fun y hy => ?_⟩
  · rw [h1, ψc_eq (le_trans ha hx.1)]
  · have := h2 y hy
    rwa [ψc_eq (le_trans ha hy.1), ψc_eq (le_trans ha hx.1)] at this

lemma le_sSup_ψ (p a b z : ℝ) (ha : 11 / 10 ≤ a) (hz : z ∈ Icc a b) :
    ψ θ p z ≤ sSup (ψc θ p '' Icc a b) := by
  rw [← ψc_eq (θ := θ) (p := p) (le_trans ha hz.1)]
  exact le_csSup ((isCompact_Icc (a := a) (b := b)).bddAbove_image
    (continuous_ψc_left p).continuousOn) (mem_image_of_mem _ hz)

/-- Left of a point `d` where `g` stays above `g d`. -/
lemma ψ_le_of_ge {p x d : ℝ} (hx : 1 < x) (hxd : x ≤ d) (h : ∀ y ∈ Icc x d, g θ d ≤ g θ y) :
    ψ θ p x ≤ ψ θ p d + (p - g θ d) * (d - x) := by
  have m := ψ_mono (θ := θ) (p := g θ d) hx h ⟨le_rfl, hxd⟩ ⟨hxd, le_rfl⟩ hxd
  have key : ψ θ p x - ψ θ p d - (p - g θ d) * (d - x) = ψ θ (g θ d) x - ψ θ (g θ d) d := by
    unfold ψ; ring
  linarith

/-- Right of a point `d` where `g` stays below `g d`. -/
lemma ψ_le_of_le {p x d : ℝ} (hd : 1 < d) (hdx : d ≤ x) (h : ∀ y ∈ Icc d x, g θ y ≤ g θ d) :
    ψ θ p x ≤ ψ θ p d - (p - g θ d) * (x - d) := by
  have m := ψ_anti (θ := θ) (p := g θ d) hd h ⟨le_rfl, hdx⟩ ⟨hdx, le_rfl⟩ hdx
  have key : ψ θ p x - ψ θ p d + (p - g θ d) * (x - d) = ψ θ (g θ d) x - ψ θ (g θ d) d := by
    unfold ψ; ring
  linarith

lemma crit_of_max {p x a b : ℝ} (ha : 1 < a) (hax : a < x) (hxb : x < b)
    (hm : ∀ y ∈ Icc a b, ψ θ p y ≤ ψ θ p x) : g θ x = p := by
  have hloc : IsLocalMax (ψ θ p) x := (isMaxOn_iff.2 hm).isLocalMax (Icc_mem_nhds hax hxb)
  have := hloc.hasDerivAt_eq_zero (hasDerivAt_ψ θ p (by linarith))
  linarith

end

section
variable {θ : ℝ} (hθ0 : 415142101 / 5000000000 ≤ θ) (hθ1 : θ ≤ 830284353 / 10000000000)
include hθ0 hθ1

lemma gL_anti : AntitoneOn (g θ) (Icc (11 / 10) (7 / 5)) :=
  g_anti (by norm_num) (fun x hx => (q_neg_L hθ0 hθ1 (by linarith [hx.1]) (by linarith [hx.2])).le)

lemma gR_anti : AntitoneOn (g θ) (Icc 400 1200) :=
  g_anti (by norm_num) (fun x hx => (q_neg_right hθ0 hθ1 (by linarith [hx.1])).le)

lemma left_loc {p x : ℝ} (hp1 : 20829 / 200000000 ≤ p) (hp2 : p ≤ 104181 / 1000000000)
    (hx : x ∈ Icc (11 / 10 : ℝ) (7 / 5))
    (hm : ∀ y ∈ Icc (11 / 10 : ℝ) (7 / 5), ψ θ p y ≤ ψ θ p x) :
    6 / 5 ≤ x ∧ x ≤ 613369 / 500000 := by
  have gc : 104181 / 1000000000 < g θ (6 / 5) := by
    have := g_mono_θ hθ0 (x := 6 / 5) (by norm_num)
    have : (104181 / 1000000000 : ℝ) < g (415142101 / 5000000000) (6 / 5) := by norm_num [g]
    linarith
  have gd : g θ (613369 / 500000) < 20829 / 200000000 := (num_lo hθ0 hθ1).2.1
  have c_mem : (6 / 5 : ℝ) ∈ Icc (11 / 10 : ℝ) (7 / 5) := ⟨by norm_num, by norm_num⟩
  have d_mem : (613369 / 500000 : ℝ) ∈ Icc (11 / 10 : ℝ) (7 / 5) := ⟨by norm_num, by norm_num⟩
  constructor
  · by_contra hlt
    have hlt' : x < 6 / 5 := not_le.1 hlt
    have b := ψ_le_of_ge (θ := θ) (p := p) (by linarith [hx.1]) hlt'.le (fun y hy =>
      gL_anti hθ0 hθ1 ⟨by linarith [hx.1, hy.1], by linarith [hy.2]⟩ c_mem hy.2)
    have := mul_neg_of_neg_of_pos (by linarith : p - g θ (6 / 5) < 0)
      (by linarith : (0:ℝ) < 6 / 5 - x)
    linarith [hm _ c_mem]
  · by_contra hgt
    have hgt' : 613369 / 500000 < x := not_le.1 hgt
    have b := ψ_le_of_le (θ := θ) (p := p) (by norm_num) hgt'.le (fun y hy =>
      gL_anti hθ0 hθ1 d_mem ⟨by linarith [hy.1], by linarith [hy.2, hx.2]⟩ hy.1)
    have := mul_pos (by linarith : (0:ℝ) < p - g θ (613369 / 500000))
      (by linarith : (0:ℝ) < x - 613369 / 500000)
    linarith [hm _ d_mem]

lemma right_loc {p x : ℝ} (hp1 : 20829 / 200000000 ≤ p) (hp2 : p ≤ 104181 / 1000000000)
    (hx : x ∈ Icc (400 : ℝ) 1200) (hm : ∀ y ∈ Icc (400 : ℝ) 1200, ψ θ p y ≤ ψ θ p x) :
    7857787 / 10000 ≤ x ∧ x ≤ 800 := by
  have gc : 104181 / 1000000000 < g θ (7857787 / 10000) := (num_hi hθ0 hθ1).2.1
  have gd : g θ 800 < 20829 / 200000000 := by
    have := g_mono_θ hθ1 (x := 800) (by norm_num)
    have : g (830284353 / 10000000000) 800 < (20829 / 200000000 : ℝ) := by norm_num [g]
    linarith
  have c_mem : (7857787 / 10000 : ℝ) ∈ Icc (400 : ℝ) 1200 := ⟨by norm_num, by norm_num⟩
  have d_mem : (800 : ℝ) ∈ Icc (400 : ℝ) 1200 := ⟨by norm_num, by norm_num⟩
  constructor
  · by_contra hlt
    have hlt' : x < 7857787 / 10000 := not_le.1 hlt
    have b := ψ_le_of_ge (θ := θ) (p := p) (by linarith [hx.1]) hlt'.le (fun y hy =>
      gR_anti hθ0 hθ1 ⟨by linarith [hx.1, hy.1], by linarith [hy.2]⟩ c_mem hy.2)
    have := mul_neg_of_neg_of_pos (by linarith : p - g θ (7857787 / 10000) < 0)
      (by linarith : (0:ℝ) < 7857787 / 10000 - x)
    linarith [hm _ c_mem]
  · by_contra hgt
    have hgt' : 800 < x := not_le.1 hgt
    have b := ψ_le_of_le (θ := θ) (p := p) (by norm_num) hgt'.le (fun y hy =>
      gR_anti hθ0 hθ1 d_mem ⟨by linarith [hy.1], by linarith [hy.2, hx.2]⟩ hy.1)
    have := mul_pos (by linarith : (0:ℝ) < p - g θ 800)
      (by linarith : (0:ℝ) < x - 800)
    linarith [hm _ d_mem]

lemma Dgap_lo : 0 < Dgap θ (20829 / 200000000) := by
  obtain ⟨x, hx, hS, hm⟩ := exists_max (θ := θ) (20829 / 200000000) (11 / 10) (7 / 5) le_rfl (by norm_num)
  obtain ⟨c1, d1⟩ := left_loc hθ0 hθ1 le_rfl (by norm_num) hx hm
  obtain ⟨n1, n2, n3⟩ := num_lo hθ0 hθ1
  have hg : g θ x = 20829 / 200000000 :=
    crit_of_max (by norm_num : (1:ℝ) < 11 / 10) (by linarith) (by linarith) hm
  have hx0 : (12267379 / 10000000 : ℝ) ≤ x := by
    by_contra h
    have h' := not_le.1 h
    have := gL_anti hθ0 hθ1 hx ⟨by norm_num, by norm_num⟩ h'.le
    linarith
  have hb := ψ_le_of_ge (θ := θ) (p := 20829 / 200000000) (by linarith) d1 (fun y hy =>
    gL_anti hθ0 hθ1 ⟨by linarith [hy.1], by linarith [hy.2]⟩ ⟨by norm_num, by norm_num⟩ hy.2)
  have hprod := mul_le_mul_of_nonneg_left
    (by linarith : (613369 / 500000 : ℝ) - x ≤ 613369 / 500000 - 12267379 / 10000000)
    (by linarith : (0:ℝ) ≤ 20829 / 200000000 - g θ (613369 / 500000))
  have hcomm : (20829 / 200000000 - g θ (613369 / 500000)) * (613369 / 500000 - 12267379 / 10000000)
      = (613369 / 500000 - 12267379 / 10000000) * (20829 / 200000000 - g θ (613369 / 500000)) :=
    mul_comm _ _
  have hK := K_lo hθ0 hθ1
  have hR := le_sSup_ψ (θ := θ) (20829 / 200000000) 400 1200 (3930271 / 5000) (by norm_num)
    ⟨by norm_num, by norm_num⟩
  unfold Dgap
  rw [hS]
  linarith

lemma Dgap_hi : Dgap θ (104181 / 1000000000) < 0 := by
  obtain ⟨y, hy, hS, hm⟩ := exists_max (θ := θ) (104181 / 1000000000) 400 1200 (by norm_num) (by norm_num)
  obtain ⟨c2, d2⟩ := right_loc hθ0 hθ1 (by norm_num) le_rfl hy hm
  obtain ⟨n1, n2, n3⟩ := num_hi hθ0 hθ1
  have hg : g θ y = 104181 / 1000000000 :=
    crit_of_max (by norm_num : (1:ℝ) < 400) (by linarith) (by linarith) hm
  have hy0 : y ≤ 7857789 / 10000 := by
    by_contra h
    have h' := not_le.1 h
    have := gR_anti hθ0 hθ1 ⟨by norm_num, by norm_num⟩ hy h'.le
    linarith
  have hb := ψ_le_of_ge (θ := θ) (p := 104181 / 1000000000) (by linarith) hy0 (fun z hz =>
    gR_anti hθ0 hθ1 ⟨by linarith [hz.1, hy.1], by linarith [hz.2]⟩ ⟨by norm_num, by norm_num⟩ hz.2)
  have hprod := mul_le_mul_of_nonneg_left
    (by linarith : (7857789 / 10000 : ℝ) - y ≤ 7857789 / 10000 - 7857787 / 10000)
    (by linarith : (0:ℝ) ≤ 104181 / 1000000000 - g θ (7857789 / 10000))
  have hcomm : (104181 / 1000000000 - g θ (7857789 / 10000)) * (7857789 / 10000 - 7857787 / 10000)
      = (7857789 / 10000 - 7857787 / 10000) * (104181 / 1000000000 - g θ (7857789 / 10000)) :=
    mul_comm _ _
  have hK := K_hi hθ0 hθ1
  have hL := le_sSup_ψ (θ := θ) (104181 / 1000000000) (11 / 10) (7 / 5) (613369 / 500000) le_rfl
    ⟨by norm_num, by norm_num⟩
  unfold Dgap
  rw [hS]
  linarith

/-- **Existence** in reduced variables, for every `θ` in the certified interval. -/
theorem reduced_exists :
    ∃ x₁ x₂ p, 1 < x₁ ∧ x₁ < x₂ ∧ g θ x₁ = p ∧ g θ x₂ = p ∧ ψ θ p x₁ = ψ θ p x₂ := by
  obtain ⟨p, hp, hD⟩ := intermediate_value_Icc'
    (by norm_num : (20829 / 200000000 : ℝ) ≤ 104181 / 1000000000)
    (continuous_Dgap (θ := θ)).continuousOn
    (show (0:ℝ) ∈ Icc (Dgap θ (104181 / 1000000000)) (Dgap θ (20829 / 200000000)) from
      ⟨(Dgap_hi hθ0 hθ1).le, (Dgap_lo hθ0 hθ1).le⟩)
  obtain ⟨x, hx, hSx, hmx⟩ := exists_max (θ := θ) p (11 / 10) (7 / 5) le_rfl (by norm_num)
  obtain ⟨y, hy, hSy, hmy⟩ := exists_max (θ := θ) p 400 1200 (by norm_num) (by norm_num)
  obtain ⟨c1, d1⟩ := left_loc hθ0 hθ1 hp.1 hp.2 hx hmx
  obtain ⟨c2, d2⟩ := right_loc hθ0 hθ1 hp.1 hp.2 hy hmy
  have hgx := crit_of_max (by norm_num : (1:ℝ) < 11 / 10) (by linarith) (by linarith) hmx
  have hgy := crit_of_max (by norm_num : (1:ℝ) < 400) (by linarith) (by linarith) hmy
  unfold Dgap at hD
  rw [hSx, hSy] at hD
  exact ⟨x, y, p, by linarith [hx.1], by linarith [hx.2, hy.1], hgx, hgy, by linarith⟩

end

