import Mathlib.Analysis.SpecialFunctions.Pow.Deriv
import Checked.Cosmography.BambaDLy

/-!
# Candidate C1: Cattoën & Visser, Class. Quantum Grav. 24, 5985 (2007), arXiv:0710.1887v1, Eq. (59)

Source (typeset text verified by rendering the PDF, run 2026-10-30T0220Z,
`runs/2026-10-30T0220Z/typeset/C1_cv2007_eq58_60.png`; definitions read this run from the PDF text):
"• The 'deceleration distance': d_Q = d_L/(1 + z)^{3/2}." (Eq. 5; run 0828Z referee correction, first drafted as Eq. 3) "[...] Ω₀ = 1 + kc²/(H₀²a₀²)"
(Eq. 16), y = z/(1 + z), d_H = c/H₀, and
"d_Q(y) = d_H y{1 − (q₀/2) y + (1/12)[3 − 2q₀ + 12q₀² − 4(j₀ + Ω₀)] y² + O(y³)}."   (59)
(The paper's own Eq. (64) for ln[d_Q/y] has 1/24[3 − 2q₀ + 9q₀² − 4(j₀ + Ω₀)], which corresponds
to 1/24 in (59); repeated with 1/12 in Cattoën–Visser 2008, arXiv:0809.0537v1, Eq. (32).)

Conventions as `Checked.Cosmography.BambaY` (c = 1, flat FLRW, d_L = a₀(1+z)χ, χ = ∫_t^{t₀} dt/a).
We test the flat instance (k = 0, Ω₀ = 1) under the weakest reading (remainder o(y³)).

FROZEN (annex 40.1) in run 2026-10-30T0828Z before proof work.
-/

namespace Work.Cosmography.CVdQ

open Filter Asymptotics Topology Checked.Cosmography Checked.Cosmography.Aviles
  Checked.Cosmography.BambaY
open scoped ContDiff

/-- Deceleration distance in a flat model: `d_Q = d_L/(1+z)^{3/2}` (real power). -/
noncomputable def dQFlat (a : ℝ → ℝ) (t₀ t : ℝ) : ℝ :=
  lumDistFlat a t₀ t / (1 + redshift a t₀ t) ^ ((3 : ℝ) / 2)

/-- The y² coefficient as printed in Eq. (59). -/
noncomputable def printedQ2 (q j Ω : ℝ) : ℝ := (1 / 12) * (3 - 2 * q + 12 * q ^ 2 - 4 * (j + Ω))

/-- The same bracket over 24. -/
noncomputable def correctQ2 (q j Ω : ℝ) : ℝ := (1 / 24) * (3 - 2 * q + 12 * q ^ 2 - 4 * (j + Ω))

/-- `H₀ d_Q(y)/c = y [1 − (q₀/2) y + Q² y²]`. -/
noncomputable def seriesQ (d2 q y : ℝ) : ℝ := y * (1 - q / 2 * y + d2 * y ^ 2)

/-- Remainder `H₀ d_Q − y[1 − (q₀/2)y + Q²y²]`, flat model (`Ω₀ = 1`). -/
noncomputable def remainderQ (D2 : ℝ → ℝ → ℝ → ℝ) (a : ℝ → ℝ) (t₀ t : ℝ) : ℝ :=
  hubble a t₀ * dQFlat a t₀ t -
    seriesQ (D2 (decel a t₀) (cosmoCoeff 3 a t₀) 1) (decel a t₀) (yred a t₀ t)

/-- The printed claim, flat instance, weakest reading, strongest hypotheses. -/
def CVdQClaim : Prop :=
  ∀ (a : ℝ → ℝ) (t₀ : ℝ), ContDiff ℝ ω a → (∀ t, 0 < a t) → 0 < hubble a t₀ →
    (fun t => remainderQ printedQ2 a t₀ t) =o[𝓝 t₀] (fun t => yred a t₀ t ^ 3)

/-- Same, past emission only. -/
def CVdQClaimPast : Prop :=
  ∀ (a : ℝ → ℝ) (t₀ : ℝ), ContDiff ℝ ω a → (∀ t, 0 < a t) → 0 < hubble a t₀ →
    (fun t => remainderQ printedQ2 a t₀ t) =o[𝓝[<] t₀] (fun t => yred a t₀ t ^ 3)

/-! ### Helpers -/

/-- Second-order Taylor polynomial of `(1 − u)^{3/2}`. -/
noncomputable def T2 (u : ℝ) : ℝ := 1 - 3 / 2 * u + 3 / 8 * u ^ 2

/-- `S(y) T(y) − seriesQ(y) = y⁴ V(y)` (generated by `runs/2026-10-30T0828Z/scripts/gen_dq.py`). -/
noncomputable def V4 (q j y : ℝ) : ℝ :=
  -j*y/16 + j/4 + 3*q^2*y/16 - 3*q^2/4 - 5*q*y/16 + 17*q/16 + 11*y/16 - 35/16

lemma idV4 (q j y : ℝ) : seriesY (correctD2y q j 1) q y * T2 y - seriesQ (correctQ2 q j 1) q y
    = y ^ 4 * V4 q j y := by
  unfold seriesY correctD2y D1y T2 seriesQ correctQ2 V4; ring

lemma cont_V4 (q j : ℝ) : Continuous (V4 q j) := by unfold V4; fun_prop

lemma cont_S (q j : ℝ) : Continuous (fun y => 1 + D1y q * y + correctD2y q j 1 * y ^ 2) := by
  fun_prop

/-- First derivative of `(1 − u)^{3/2} − T2 u`. -/
noncomputable def psi (u : ℝ) : ℝ :=
  -1 * ((3 : ℝ) / 2) * (1 - u) ^ ((3 : ℝ) / 2 - 1) - (-(3 / 2) + 3 / 4 * u)

/-- Second derivative of `(1 − u)^{3/2} − T2 u`. -/
noncomputable def psi' (u : ℝ) : ℝ :=
  -1 * ((3 : ℝ) / 2) * (-1 * ((3 : ℝ) / 2 - 1) * (1 - u) ^ ((3 : ℝ) / 2 - 1 - 1)) - 3 / 4

lemma hasDerivAt_psi (u : ℝ) (hu : 1 - u ≠ 0) : HasDerivAt psi (psi' u) u := by
  have h2 := ((hasDerivAt_id' u).const_sub (1 : ℝ)).rpow_const (p := (3 : ℝ) / 2 - 1) (Or.inl hu)
  have h3 : HasDerivAt (fun v => -1 * ((3 : ℝ) / 2) * (1 - v) ^ ((3 : ℝ) / 2 - 1)
      - (-(3 / 2) + 3 / 4 * v))
      (-1 * ((3 : ℝ) / 2) * (-1 * ((3 : ℝ) / 2 - 1) * (1 - u) ^ ((3 : ℝ) / 2 - 1 - 1))
        - (0 + 3 / 4 * 1)) u :=
    (h2.const_mul _).sub ((hasDerivAt_const _ _).add ((hasDerivAt_id' u).const_mul _))
  exact h3.congr_deriv (by unfold psi'; ring)

lemma hasDerivAt_phi (u : ℝ) (hu : 1 - u ≠ 0) :
    HasDerivAt (fun u : ℝ => (1 - u) ^ ((3 : ℝ) / 2) - T2 u) (psi u) u := by
  have h2 := ((hasDerivAt_id' u).const_sub (1 : ℝ)).rpow_const (p := (3 : ℝ) / 2) (Or.inl hu)
  have h3 : HasDerivAt (fun v => (1 - v) ^ ((3 : ℝ) / 2) - (1 - 3 / 2 * v + 3 / 8 * v ^ 2))
      (-1 * ((3 : ℝ) / 2) * (1 - u) ^ ((3 : ℝ) / 2 - 1)
        - (0 - 3 / 2 * 1 + 3 / 8 * (↑2 * u ^ (2 - 1)))) u :=
    h2.sub (((hasDerivAt_const _ _).sub ((hasDerivAt_id' u).const_mul _)).add
      ((hasDerivAt_pow 2 u).const_mul _))
  exact h3.congr_deriv (by unfold psi; norm_num; ring)

/-- `(1 − u)^{3/2} = 1 − (3/2)u + (3/8)u² + o(u²)` as `u → 0`. -/
lemma rpow_expansion :
    (fun u : ℝ => (1 - u) ^ ((3 : ℝ) / 2) - T2 u) =o[𝓝 0] fun u => u ^ 2 := by
  have hnear : ∀ᶠ u in 𝓝 (0 : ℝ), 1 - u ≠ 0 := by
    have : Tendsto (fun u : ℝ => 1 - u) (𝓝 0) (𝓝 (1 - 0)) := tendsto_const_nhds.sub tendsto_id
    rw [sub_zero] at this
    exact this.eventually_ne one_ne_zero
  have dψ : ∀ᶠ u in 𝓝 (0 : ℝ), HasDerivAt psi (psi' u) u := hnear.mono hasDerivAt_psi
  have hψ0 : psi 0 = 0 := by unfold psi; norm_num
  have hψ'o : psi' =o[𝓝 0] fun u => (u - 0) ^ 0 := by
    simp only [sub_zero, pow_zero]
    rw [isLittleO_one_iff]
    have hc : ContinuousAt psi' 0 := by
      have : ContinuousAt (fun u : ℝ => (1 - u) ^ ((3 : ℝ) / 2 - 1 - 1)) 0 :=
        ((continuous_const.sub continuous_id).continuousAt).rpow_const (Or.inl (by norm_num))
      unfold psi'
      exact ((continuousAt_const.mul (continuousAt_const.mul this))).sub continuousAt_const
    have := hc.tendsto
    have e : psi' 0 = 0 := by unfold psi'; norm_num
    rwa [e] at this
  have hψo := littleO_of_hasDerivAt hψ0 dψ hψ'o
  have dφ : ∀ᶠ u in 𝓝 (0 : ℝ),
      HasDerivAt (fun u : ℝ => (1 - u) ^ ((3 : ℝ) / 2) - T2 u) (psi u) u :=
    hnear.mono hasDerivAt_phi
  have hφ0 : (fun u : ℝ => (1 - u) ^ ((3 : ℝ) / 2) - T2 u) 0 = 0 := by simp [T2]
  have := littleO_of_hasDerivAt (R := fun u : ℝ => (1 - u) ^ ((3 : ℝ) / 2) - T2 u) (t₀ := 0)
    hφ0 dφ hψo
  simpa using this

/-- **Deceleration distance to third order in `y`** (flat FLRW, coefficient over 24). -/
theorem dQ_y_third_order (a : ℝ → ℝ) (t₀ : ℝ) (ha : ContDiffAt ℝ 3 a t₀)
    (ha0 : a t₀ ≠ 0) (hH : hubble a t₀ ≠ 0) :
    (fun t => remainderQ correctQ2 a t₀ t) =o[𝓝 t₀] (fun t => yred a t₀ t ^ 3) := by
  set q := decel a t₀ with hq
  set j := cosmoCoeff 3 a t₀ with hj
  set y : ℝ → ℝ := fun t => yred a t₀ t with hy
  have hd : DifferentiableAt ℝ a t₀ := ha.differentiableAt (by norm_num)
  have hyd := hasDerivAt_yred a t₀ hd ha0
  have hy00 : yred a t₀ t₀ = 0 := by
    simp only [yred, redshift, div_self ha0, sub_self, zero_div]
  have hy0 : Tendsto y (𝓝 t₀) (𝓝 0) := by
    have := hyd.continuousAt.tendsto; rwa [hy00] at this
  have hL := lumDist_y_third_order a t₀ ha ha0 hH
  have hr2 := rpow_expansion.comp_tendsto hy0
  -- (1 − y)^{3/2} → 1, bounded
  have hP : (fun t => (1 - y t) ^ ((3 : ℝ) / 2)) =O[𝓝 t₀] (fun _ => (1 : ℝ)) := by
    have hc : ContinuousAt (fun u : ℝ => (1 - u) ^ ((3 : ℝ) / 2)) 0 :=
      ((continuous_const.sub continuous_id).continuousAt).rpow_const (Or.inl (by norm_num))
    exact (hc.tendsto.comp hy0).isBigO_one ℝ
  have p1 := hL.mul_isBigO hP
  simp only [mul_one] at p1
  have p2 : (fun t => seriesY (correctD2y q j 1) q (y t) *
      ((1 - y t) ^ ((3 : ℝ) / 2) - T2 (y t))) =o[𝓝 t₀] fun t => y t ^ 3 := by
    have hg := CCS.bdd hy0 _ (cont_S q j)
    have h := ((isBigO_refl y (𝓝 t₀)).mul hg).mul_isLittleO hr2
    refine h.congr' (Eventually.of_forall fun t => ?_) (Eventually.of_forall fun t => ?_)
    · simp only [Function.comp, seriesY]; try ring
    · simp only [Function.comp]; try ring
  have p3 : (fun t => y t ^ 4 * V4 q j (y t)) =o[𝓝 t₀] fun t => y t ^ 3 :=
    pow_succ_mul_isLittleO hy0 3 _ (CCS.bdd hy0 _ (cont_V4 q j))
  have hne : ∀ᶠ t in 𝓝 t₀, a t ≠ 0 := hd.continuousAt.eventually_ne ha0
  have hpos : ∀ᶠ t in 𝓝 t₀, 0 < a t / a t₀ := by
    have : Tendsto (fun t => a t / a t₀) (𝓝 t₀) (𝓝 1) := by
      have := (hd.continuousAt.tendsto).div_const (a t₀); rwa [div_self ha0] at this
    exact this.eventually (lt_mem_nhds one_pos)
  refine ((p1.add p2).add p3).congr' ?_ EventuallyEq.rfl
  filter_upwards [hne, hpos] with t ht hp
  have e1 : 1 - y t = a t / a t₀ := by
    simp only [hy, yred, redshift]
    rw [show 1 + (a t₀ / a t - 1) = a t₀ / a t by ring, div_div_eq_mul_div]
    field_simp
    ring
  have e2 : 1 + redshift a t₀ t = (1 - y t)⁻¹ := by
    rw [e1, redshift, inv_div]; ring
  have e3 : dQFlat a t₀ t = lumDistFlat a t₀ t * (1 - y t) ^ ((3 : ℝ) / 2) := by
    rw [dQFlat, e2, Real.inv_rpow (by rw [e1]; exact hp.le), div_inv_eq_mul]
  have hV := idV4 q j (y t)
  simp only [remainderQ, remainderY, e3]
  rw [← hq, ← hj]
  simp only [hy] at hV ⊢
  linear_combination (-1 : ℝ) * hV

/-- The printed coefficient fails (past emission) in every flat `C³` model with
`−1 − 2q₀ + 12q₀² − 4j₀ ≠ 0`. -/
theorem printedQ2_fails_past (a : ℝ → ℝ) (t₀ : ℝ) (ha : ContDiffAt ℝ 3 a t₀)
    (ha0 : a t₀ ≠ 0) (hH : hubble a t₀ ≠ 0)
    (hD : -1 - 2 * decel a t₀ + 12 * decel a t₀ ^ 2 - 4 * cosmoCoeff 3 a t₀ ≠ 0) :
    ¬ (fun t => remainderQ printedQ2 a t₀ t) =o[𝓝[<] t₀] (fun t => yred a t₀ t ^ 3) := by
  intro hp
  have hc := (dQ_y_third_order a t₀ ha ha0 hH).mono (nhdsWithin_le_nhds (s := Set.Iio t₀))
  set c : ℝ := -((-1 - 2 * decel a t₀ + 12 * decel a t₀ ^ 2 - 4 * cosmoCoeff 3 a t₀) / 24)
    with hcdef
  have hc0 : c ≠ 0 := neg_ne_zero.2 (div_ne_zero hD (by norm_num))
  have hdiff : (fun t => c * yred a t₀ t ^ 3) =o[𝓝[<] t₀] (fun t => yred a t₀ t ^ 3) := by
    refine (hp.sub hc).congr' (Eventually.of_forall fun t => ?_) EventuallyEq.rfl
    simp only [remainderQ, seriesQ, printedQ2, correctQ2, hcdef]; ring
  have hself : (fun t => yred a t₀ t ^ 3) =o[𝓝[<] t₀] (fun t => yred a t₀ t ^ 3) :=
    (hdiff.const_mul_left c⁻¹).congr' (Eventually.of_forall fun t => by
      simp only; rw [← mul_assoc, inv_mul_cancel₀ hc0, one_mul]) EventuallyEq.rfl
  have hd : DifferentiableAt ℝ a t₀ := ha.differentiableAt (by norm_num)
  have hev := (hasDerivAt_yred a t₀ hd ha0).eventually_ne (c := 0) (neg_ne_zero.2 hH)
  have hev' : ∀ᶠ t in 𝓝[<] t₀, yred a t₀ t ≠ 0 :=
    nhdsWithin_mono t₀ (fun t (ht : t < t₀) => ne_of_lt ht) hev
  have hfreq : ∃ᶠ t in 𝓝[<] t₀, ‖yred a t₀ t ^ 3‖ ≠ 0 :=
    (hev'.mono fun t ht => by simpa using ht).frequently
  exact isLittleO_irrefl' hfreq hself

/-- The printed claim is false (flat de Sitter). -/
theorem cvdQClaim_false : ¬ CVdQClaim := by
  intro h
  obtain ⟨hH, hq, hj⟩ := deSitter_vals
  exact printedQ2_fails_past Real.exp 0 Real.contDiff_exp.contDiffAt (Real.exp_pos 0).ne'
    (by rw [hH]; norm_num) (by rw [hq, hj]; norm_num)
    ((h Real.exp 0 Real.contDiff_exp Real.exp_pos (by rw [hH]; norm_num)).mono
      (nhdsWithin_le_nhds (s := Set.Iio 0)))

/-- The past-only reading is false (flat de Sitter). -/
theorem cvdQClaimPast_false : ¬ CVdQClaimPast := by
  intro h
  obtain ⟨hH, hq, hj⟩ := deSitter_vals
  exact printedQ2_fails_past Real.exp 0 Real.contDiff_exp.contDiffAt (Real.exp_pos 0).ne'
    (by rw [hH]; norm_num) (by rw [hq, hj]; norm_num)
    (h Real.exp 0 Real.contDiff_exp Real.exp_pos (by rw [hH]; norm_num))

end Work.Cosmography.CVdQ
