import Work.Cosmography.BambaCurved

/-!
# Candidate C7: Bamba, Capozziello, Nojiri, Odintsov, Astrophys. Space Sci. 342, 155 (2012),
arXiv:1205.3421v3, Sec. X, Eqs. (10.58)–(10.63): y-redshift angular-diameter-distance
coefficients `D_{A,y}` (verbatim also in Capozziello & Salzano 2009, arXiv:0902.0088, Eqs. (59)–(64))

Source (typeset, v1–v3 identical; `runs/2026-10-30T1028Z/typeset/cropA_pg_v3-111.png`,
`typeset/upstream_CapozzielloSalzano2009_0902.0088_p7_eqs59-69.png`):
"D⁰_{A,y} = 1, D¹_{A,y} = −½(1 + q₀), D²_{A,y} = −⅙(−q₀ − 3q₀² + j₀ + Ω₀),
D³_{A,y} = −(1/24)(−2q₀ + 3q₀² + 15q₀³ − j₀ − 10q₀j₀ − s₀ + 2Ω₀) (10.61),
D⁴_{A,y} = −(1/120)(1 − 6q₀ + 9q₀² − 15q₀³ − 105q₀⁴ + 10q₀j₀ + 105q₀²j₀ + 15q₀s₀ +
− 3j₀ − 10j² + s₀ + l₀ + 5Ω₀) (10.62)–(10.63). Previous relations have been derived for any value
of the curvature parameter." `j²` read as `j₀²`, "+ (10.62) − 3j₀" as `− 3j₀`.
Angular-diameter distance (10.27): `d_A = [a(t₀ − D/c)/a(t₀)] a(t₀) r₀ = d_L/(1+z)²`.

Reading as C6 (`Work.Cosmography.BambaK`): `d_A(y) = (cy/H₀)[D⁰ + D¹y + … + D⁴y⁴ + O(y⁵)]`.
The printed `D⁰…D²_{A,y}` are right, so the (10.61) claim uses them as printed; the (10.62)–(10.63)
claim also uses the corrected `D³_{A,y}` (charitable). Every real `K`; every analytic, everywhere
positive scale factor with `H₀ > 0`.

FROZEN (annex 40.1) in run 2026-10-30T1028Z before proof work.
-/

namespace Work.Cosmography.BambaA

open Filter Asymptotics Topology Checked.Cosmography Checked.Cosmography.Aviles
open Checked.Cosmography.BambaY Work.Cosmography.BambaK
open scoped ContDiff

/-- Angular-diameter distance `d_A = d_L/(1+z)²` (Eq. (10.27), `c = 1`). -/
noncomputable def angDist (K : ℝ) (a : ℝ → ℝ) (t₀ t : ℝ) : ℝ :=
  lumDist K a t₀ t / (1 + redshift a t₀ t) ^ 2

/-- `D¹_{A,y}` as printed. -/
noncomputable def DA1 (q : ℝ) : ℝ := -(1 / 2) * (1 + q)

/-- `D²_{A,y}` as printed. -/
noncomputable def DA2 (q j Ω : ℝ) : ℝ := -(1 / 6) * (-q - 3 * q ^ 2 + j + Ω)

/-- `D³_{A,y}` as printed (Eq. (10.61)), verbatim. -/
noncomputable def printedDA3 (q j s Ω : ℝ) : ℝ :=
  -(1 / 24) * (-2 * q + 3 * q ^ 2 + 15 * q ^ 3 - j - 10 * q * j - s + 2 * Ω)

/-- `D⁴_{A,y}` as printed (Eqs. (10.62)–(10.63)), verbatim (`j² = j₀²`). -/
noncomputable def printedDA4 (q j s l Ω : ℝ) : ℝ :=
  -(1 / 120) * (1 - 6 * q + 9 * q ^ 2 - 15 * q ^ 3 - 105 * q ^ 4 + 10 * q * j + 105 * q ^ 2 * j
    + 15 * q * s + -3 * j - 10 * j ^ 2 + s + l + 5 * Ω)

/-- Proposed correction of (10.61): add `q₀(Ω₀ − 1)/4`. -/
noncomputable def correctDA3 (q j s Ω : ℝ) : ℝ :=
  printedDA3 q j s Ω + q * (Ω - 1) / 4

/-- Proposed correction of (10.62)–(10.63): add `(Ω₀ − 1)[(Ω₀ − 1) + 10j₀ − 45q₀² + 20q₀]/120`. -/
noncomputable def correctDA4 (q j s l Ω : ℝ) : ℝ :=
  printedDA4 q j s l Ω + (Ω - 1) * ((Ω - 1) + 10 * j - 45 * q ^ 2 + 20 * q) / 120

/-- Remainder `H₀ d_A − y[1 + D¹_A y + D²_A y² + D³ y³ + D⁴ y⁴]` for curvature `K`. -/
noncomputable def remA (D3 : ℝ → ℝ → ℝ → ℝ → ℝ) (D4 : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ)
    (K : ℝ) (a : ℝ → ℝ) (t₀ t : ℝ) : ℝ :=
  hubble a t₀ * angDist K a t₀ t -
    yred a t₀ t * (1 + DA1 (decel a t₀) * yred a t₀ t
      + DA2 (decel a t₀) (cosmoCoeff 3 a t₀) (omega0 K a t₀) * yred a t₀ t ^ 2
      + D3 (decel a t₀) (cosmoCoeff 3 a t₀) (cosmoCoeff 4 a t₀) (omega0 K a t₀) * yred a t₀ t ^ 3
      + D4 (decel a t₀) (cosmoCoeff 3 a t₀) (cosmoCoeff 4 a t₀) (cosmoCoeff 5 a t₀)
          (omega0 K a t₀) * yred a t₀ t ^ 4)

/-- Claim (10.61): printed `D⁰…D³_{A,y}`, remainder `o(y⁴)`, every `K`, every analytic, everywhere
positive scale factor with `H₀ > 0`. -/
def BambaDA3Claim : Prop :=
  ∀ (K : ℝ) (a : ℝ → ℝ) (t₀ : ℝ), ContDiff ℝ ω a → (∀ t, 0 < a t) → 0 < hubble a t₀ →
    (fun t => remA printedDA3 (fun _ _ _ _ _ => 0) K a t₀ t) =o[𝓝 t₀] (fun t => yred a t₀ t ^ 4)

/-- Claim (10.62)–(10.63), charitable: corrected `D³_{A,y}`, printed `D⁴_{A,y}`, `o(y⁵)`. -/
def BambaDA4Claim : Prop :=
  ∀ (K : ℝ) (a : ℝ → ℝ) (t₀ : ℝ), ContDiff ℝ ω a → (∀ t, 0 < a t) → 0 < hubble a t₀ →
    (fun t => remA correctDA3 printedDA4 K a t₀ t) =o[𝓝 t₀] (fun t => yred a t₀ t ^ 5)

/-- Same claims, past emission only. -/
def BambaDA3ClaimPast : Prop :=
  ∀ (K : ℝ) (a : ℝ → ℝ) (t₀ : ℝ), ContDiff ℝ ω a → (∀ t, 0 < a t) → 0 < hubble a t₀ →
    (fun t => remA printedDA3 (fun _ _ _ _ _ => 0) K a t₀ t) =o[𝓝[<] t₀] (fun t => yred a t₀ t ^ 4)

def BambaDA4ClaimPast : Prop :=
  ∀ (K : ℝ) (a : ℝ → ℝ) (t₀ : ℝ), ContDiff ℝ ω a → (∀ t, 0 < a t) → 0 < hubble a t₀ →
    (fun t => remA correctDA3 printedDA4 K a t₀ t) =o[𝓝[<] t₀] (fun t => yred a t₀ t ^ 5)


/-! ### Proofs -/

/-- `(1 − y)² S_L(y) = S_A(y) + y⁶ V(y)` (generated by `runs/2026-10-30T1028Z/scripts/gen_angular.py`). -/
noncomputable def Vpoly (q j s l Ω y : ℝ) : ℝ :=
  Ω^2*y/120 - Ω^2/60 + Ω*j*y/12 - Ω*j/6 - 3*Ω*q^2*y/8 + 3*Ω*q^2/4 + 2*Ω*q*y/3 - 13*Ω*q/12 - 29*Ω*y/40 + 31*Ω/30 + j^2*y/12 - j^2/6 - 7*j*q^2*y/8 + 7*j*q^2/4 + 3*j*q*y/4 - 13*j*q/12 - 19*j*y/40 + 79*j/120 - l*y/120 + l/60 + 7*q^4*y/8 - 7*q^4/4 - 9*q^3*y/8 + 13*q^3/8 + 31*q^2*y/20 - 89*q^2/40 - q*s*y/8 + q*s/4 - 39*q*y/20 + 77*q/30 + 3*s*y/40 - 13*s/120 + 3*y - 7/2

lemma idA (q j s l Ω y : ℝ) :
    (1 - y) ^ 2 * seriesY4 q (correctD2y q j Ω) (correctD3y q j s Ω) (correctD4y q j s l Ω) y
      = y * (1 + DA1 q * y + DA2 q j Ω * y ^ 2 + correctDA3 q j s Ω * y ^ 3
        + correctDA4 q j s l Ω * y ^ 4) + y ^ 6 * Vpoly q j s l Ω y := by
  unfold seriesY4 D1y correctD2y correctD3y correctD4y printedD3y printedD4y DA1 DA2 correctDA3
    correctDA4 printedDA3 printedDA4 Vpoly
  ring

lemma cont_V (q j s l Ω : ℝ) : Continuous (Vpoly q j s l Ω) := by unfold Vpoly; fun_prop

lemma yred_tendsto (a : ℝ → ℝ) (t₀ : ℝ) (hd : DifferentiableAt ℝ a t₀) (ha0 : a t₀ ≠ 0) :
    Tendsto (fun t => yred a t₀ t) (𝓝 t₀) (𝓝 0) := by
  have h := (hasDerivAt_yred a t₀ hd ha0).continuousAt.tendsto
  rwa [show yred a t₀ t₀ = 0 by simp only [yred, redshift, div_self ha0, sub_self, zero_div]] at h

/-- **Headline.** Angular-diameter distance to fifth order in `y`, every `K`, every
scale factor `C⁵` at `t₀` with `a(t₀) ≠ 0`, `H₀ ≠ 0`. -/
theorem angDist_y_fifth_order (K : ℝ) (a : ℝ → ℝ) (t₀ : ℝ) (ha : ContDiffAt ℝ 5 a t₀)
    (ha0 : a t₀ ≠ 0) (hH : hubble a t₀ ≠ 0) :
    (fun t => remA correctDA3 correctDA4 K a t₀ t) =o[𝓝 t₀] (fun t => yred a t₀ t ^ 5) := by
  have hL := lumDist_y_fifth_order K a t₀ ha ha0 hH
  have hd : DifferentiableAt ℝ a t₀ := ha.differentiableAt (by norm_num)
  have hy0 := yred_tendsto a t₀ hd ha0
  have hne : ∀ᶠ t in 𝓝 t₀, a t ≠ 0 := hd.continuousAt.eventually_ne ha0
  have hb : (fun t => (1 - yred a t₀ t) ^ 2) =O[𝓝 t₀] (fun _ => (1 : ℝ)) :=
    ((hy0.const_sub 1).pow 2).isBigO_one ℝ
  have b1 : (fun t => (1 - yred a t₀ t) ^ 2 * remK correctD2y correctD3y correctD4y K a t₀ t)
      =o[𝓝 t₀] (fun t => yred a t₀ t ^ 5) := by
    simpa using hb.mul_isLittleO hL
  have b2 : (fun t => yred a t₀ t ^ 6 * Vpoly (decel a t₀) (cosmoCoeff 3 a t₀) (cosmoCoeff 4 a t₀)
      (cosmoCoeff 5 a t₀) (omega0 K a t₀) (yred a t₀ t)) =o[𝓝 t₀] (fun t => yred a t₀ t ^ 5) :=
    pow_succ_mul_isLittleO hy0 5 _ (CCS.bdd hy0 _ (cont_V _ _ _ _ _))
  refine (b1.add b2).congr' ?_ EventuallyEq.rfl
  filter_upwards [hne] with t ht
  have hw : 1 + redshift a t₀ t ≠ 0 := by
    simp only [redshift, add_sub_cancel]; exact div_ne_zero ha0 ht
  have e3 : (1 - yred a t₀ t) ^ 2 = ((1 + redshift a t₀ t) ^ 2)⁻¹ := by
    simp only [yred]; field_simp; ring
  have hid := idA (decel a t₀) (cosmoCoeff 3 a t₀) (cosmoCoeff 4 a t₀) (cosmoCoeff 5 a t₀)
    (omega0 K a t₀) (yred a t₀ t)
  simp only [remA, remK, angDist]
  linear_combination (hubble a t₀ * lumDist K a t₀ t) * e3 - hid

/-- The printed `D³_{A,y}` fails, from the past, in every `C⁵` model with `a(t₀) ≠ 0`, `H₀ ≠ 0`,
`q₀ ≠ 0` and `Ω₀ ≠ 1`. -/
theorem printedDA3_fails_past (K : ℝ) (a : ℝ → ℝ) (t₀ : ℝ) (ha : ContDiffAt ℝ 5 a t₀)
    (ha0 : a t₀ ≠ 0) (hH : hubble a t₀ ≠ 0) (hD : decel a t₀ * (omega0 K a t₀ - 1) ≠ 0) :
    ¬ (fun t => remA printedDA3 (fun _ _ _ _ _ => 0) K a t₀ t)
      =o[𝓝[<] t₀] (fun t => yred a t₀ t ^ 4) := by
  intro hp
  have hd : DifferentiableAt ℝ a t₀ := ha.differentiableAt (by norm_num)
  have hy0 := yred_tendsto_past a t₀ hd ha0
  have h54 : (fun t => yred a t₀ t ^ 5) =o[𝓝[<] t₀] (fun t => yred a t₀ t ^ 4) := by
    simpa using pow_succ_mul_isLittleO hy0 4 (fun _ => (1 : ℝ)) (isBigO_refl _ _)
  have hc := ((angDist_y_fifth_order K a t₀ ha ha0 hH).mono
    (nhdsWithin_le_nhds (s := Set.Iio t₀))).trans h54
  have hd4 := h54.const_mul_left (correctDA4 (decel a t₀) (cosmoCoeff 3 a t₀)
    (cosmoCoeff 4 a t₀) (cosmoCoeff 5 a t₀) (omega0 K a t₀))
  set c : ℝ := decel a t₀ * (omega0 K a t₀ - 1) / 4 with hcdef
  have hc0 : c ≠ 0 := div_ne_zero hD (by norm_num)
  have hdiff : (fun t => c * yred a t₀ t ^ 4) =o[𝓝[<] t₀] (fun t => yred a t₀ t ^ 4) := by
    refine ((hp.sub hc).sub hd4).congr' (Eventually.of_forall fun t => ?_) EventuallyEq.rfl
    simp only [remA, correctDA3, hcdef]; ring
  exact not_isLittleO_self_past a t₀ hd ha0 hH 4 hc0 hdiff

theorem printedDA3_fails (K : ℝ) (a : ℝ → ℝ) (t₀ : ℝ) (ha : ContDiffAt ℝ 5 a t₀)
    (ha0 : a t₀ ≠ 0) (hH : hubble a t₀ ≠ 0) (hD : decel a t₀ * (omega0 K a t₀ - 1) ≠ 0) :
    ¬ (fun t => remA printedDA3 (fun _ _ _ _ _ => 0) K a t₀ t)
      =o[𝓝 t₀] (fun t => yred a t₀ t ^ 4) :=
  fun hp => printedDA3_fails_past K a t₀ ha ha0 hH hD
    (hp.mono (nhdsWithin_le_nhds (s := Set.Iio t₀)))

/-- The printed `D⁴_{A,y}` (with corrected `D³_{A,y}`) fails, from the past, whenever
`(Ω₀ − 1)[(Ω₀ − 1) + 10j₀ − 45q₀² + 20q₀] ≠ 0`. -/
theorem printedDA4_fails_past (K : ℝ) (a : ℝ → ℝ) (t₀ : ℝ) (ha : ContDiffAt ℝ 5 a t₀)
    (ha0 : a t₀ ≠ 0) (hH : hubble a t₀ ≠ 0)
    (hD : (omega0 K a t₀ - 1) * ((omega0 K a t₀ - 1) + 10 * cosmoCoeff 3 a t₀
      - 45 * decel a t₀ ^ 2 + 20 * decel a t₀) ≠ 0) :
    ¬ (fun t => remA correctDA3 printedDA4 K a t₀ t)
      =o[𝓝[<] t₀] (fun t => yred a t₀ t ^ 5) := by
  intro hp
  have hd : DifferentiableAt ℝ a t₀ := ha.differentiableAt (by norm_num)
  have hc := (angDist_y_fifth_order K a t₀ ha ha0 hH).mono (nhdsWithin_le_nhds (s := Set.Iio t₀))
  set c : ℝ := (omega0 K a t₀ - 1) * ((omega0 K a t₀ - 1) + 10 * cosmoCoeff 3 a t₀
      - 45 * decel a t₀ ^ 2 + 20 * decel a t₀) / 120 with hcdef
  have hc0 : c ≠ 0 := div_ne_zero hD (by norm_num)
  have hdiff : (fun t => c * yred a t₀ t ^ 5) =o[𝓝[<] t₀] (fun t => yred a t₀ t ^ 5) := by
    refine (hp.sub hc).congr' (Eventually.of_forall fun t => ?_) EventuallyEq.rfl
    simp only [remA, correctDA4, hcdef]; ring
  exact not_isLittleO_self_past a t₀ hd ha0 hH 5 hc0 hdiff

theorem printedDA4_fails (K : ℝ) (a : ℝ → ℝ) (t₀ : ℝ) (ha : ContDiffAt ℝ 5 a t₀)
    (ha0 : a t₀ ≠ 0) (hH : hubble a t₀ ≠ 0)
    (hD : (omega0 K a t₀ - 1) * ((omega0 K a t₀ - 1) + 10 * cosmoCoeff 3 a t₀
      - 45 * decel a t₀ ^ 2 + 20 * decel a t₀) ≠ 0) :
    ¬ (fun t => remA correctDA3 printedDA4 K a t₀ t)
      =o[𝓝 t₀] (fun t => yred a t₀ t ^ 5) :=
  fun hp => printedDA4_fails_past K a t₀ ha ha0 hH hD
    (hp.mono (nhdsWithin_le_nhds (s := Set.Iio t₀)))

lemma closedExp_j : cosmoCoeff 3 Real.exp 0 = 1 := deSitter_vals.2.2

theorem bambaDA3Claim_false : ¬ BambaDA3Claim := by
  intro h
  obtain ⟨hH, hq, hΩ⟩ := closedExp_vals
  exact printedDA3_fails 1 Real.exp 0 Real.contDiff_exp.contDiffAt (Real.exp_pos 0).ne'
    (by rw [hH]; norm_num) (by rw [hq, hΩ]; norm_num)
    (h 1 Real.exp 0 Real.contDiff_exp Real.exp_pos (by rw [hH]; norm_num))

theorem bambaDA4Claim_false : ¬ BambaDA4Claim := by
  intro h
  obtain ⟨hH, hq, hΩ⟩ := closedExp_vals
  exact printedDA4_fails 1 Real.exp 0 Real.contDiff_exp.contDiffAt (Real.exp_pos 0).ne'
    (by rw [hH]; norm_num) (by rw [hq, hΩ, closedExp_j]; norm_num)
    (h 1 Real.exp 0 Real.contDiff_exp Real.exp_pos (by rw [hH]; norm_num))

theorem bambaDA3ClaimPast_false : ¬ BambaDA3ClaimPast := by
  intro h
  obtain ⟨hH, hq, hΩ⟩ := closedExp_vals
  exact printedDA3_fails_past 1 Real.exp 0 Real.contDiff_exp.contDiffAt (Real.exp_pos 0).ne'
    (by rw [hH]; norm_num) (by rw [hq, hΩ]; norm_num)
    (h 1 Real.exp 0 Real.contDiff_exp Real.exp_pos (by rw [hH]; norm_num))

theorem bambaDA4ClaimPast_false : ¬ BambaDA4ClaimPast := by
  intro h
  obtain ⟨hH, hq, hΩ⟩ := closedExp_vals
  exact printedDA4_fails_past 1 Real.exp 0 Real.contDiff_exp.contDiffAt (Real.exp_pos 0).ne'
    (by rw [hH]; norm_num) (by rw [hq, hΩ, closedExp_j]; norm_num)
    (h 1 Real.exp 0 Real.contDiff_exp Real.exp_pos (by rw [hH]; norm_num))

/-- Milne (`a = t`, `K = −1`, `t₀ = 1`): the printed `D⁴_{A,y}` fails (standalone instance;
the `D³_{A,y}` difference vanishes there since `q₀ = 0`). -/
theorem milne_printedDA4_fails_past :
    ¬ (fun t => remA correctDA3 printedDA4 (-1) (fun t => t) 1 t)
      =o[𝓝[<] 1] (fun t => yred (fun t => t) 1 t ^ 5) := by
  obtain ⟨hH, hq, hΩ⟩ := milne_vals
  have hj : cosmoCoeff 3 (fun t : ℝ => t) 1 = 0 := by
    simp [cosmoCoeff, iteratedDeriv_succ, iteratedDeriv_zero]
  exact printedDA4_fails_past (-1) (fun t => t) 1 contDiffAt_id one_ne_zero
    (by rw [hH]; norm_num) (by rw [hq, hΩ, hj]; norm_num)

end Work.Cosmography.BambaA
