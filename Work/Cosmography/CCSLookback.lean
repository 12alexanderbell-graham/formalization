lemma idAB (q j s l x : ℝ) : Apoly q j s l x * Bpoly q j s l x = 1 + x ^ 6 * C0poly q j s l x := by
  unfold Apoly Bpoly C0poly; ring
lemma idZ1 (q j s l x : ℝ) : Zp1 q j s l x = Bpoly q j s l x - 1 := by
  unfold Zp1 Bpoly; ring
lemma idW1 (q j s l x : ℝ) : Zp1 q j s l x * Zp1 q j s l x = Zp2 q j s l x + x ^ 6 * Wp1 q j s l x := by
  unfold Zp1 Zp2 Wp1; ring
lemma idW2 (q j s l x : ℝ) : Zp1 q j s l x * Zp2 q j s l x = Zp3 q j s l x + x ^ 6 * Wp2 q j s l x := by
  unfold Zp1 Zp2 Zp3 Wp2; ring
lemma idW3 (q j s l x : ℝ) : Zp1 q j s l x * Zp3 q j s l x = Zp4 q j s l x + x ^ 6 * Wp3 q j s l x := by
  unfold Zp1 Zp3 Zp4 Wp3; ring
lemma idW4 (q j s l x : ℝ) : Zp1 q j s l x * Zp4 q j s l x = Zp5 q j s l x + x ^ 6 * Wp4 q j s l x := by
  unfold Zp1 Zp4 Zp5 Wp4; ring
lemma idF (q j s l x : ℝ) : Zp1 q j s l x + D1 q * Zp2 q j s l x + D2 q j * Zp3 q j s l x
    + D3 q j s * Zp4 q j s l x + correctD4 q j s l * Zp5 q j s l x = x := by
  unfold Zp1 Zp2 Zp3 Zp4 Zp5 D1 D2 D3 correctD4; ring

/-! ### Asymptotic inversion (no cosmology) -/

lemma bdd {α : Type*} {L : Filter α} {X : α → ℝ} (hX : Tendsto X L (𝓝 0)) (f : ℝ → ℝ)
    (hf : Continuous f) : (fun t => f (X t)) =O[L] (fun _ => (1 : ℝ)) :=
  ((hf.tendsto 0).comp hX).isBigO_one ℝ

lemma x6 {α : Type*} {L : Filter α} {X : α → ℝ} (hX : Tendsto X L (𝓝 0)) (g : α → ℝ)
    (hg : g =O[L] (fun _ => (1 : ℝ))) :
    (fun t => X t ^ 6 * g t) =o[L] (fun t => X t ^ 5) := by
  have h1 : (fun t => X t) =o[L] (fun _ => (1 : ℝ)) := (isLittleO_one_iff ℝ).2 hX
  have h2 := (isBigO_refl (fun t => X t ^ 5) L).mul_isLittleO (h1.mul_isBigO hg)
  refine h2.congr' (Eventually.of_forall fun t => ?_) (Eventually.of_forall fun t => ?_)
  · simp only; ring
  · simp

theorem inversion (q j s l : ℝ) {α : Type*} {L : Filter α} (X E : α → ℝ)
    (hX : Tendsto X L (𝓝 0)) (hE : E =o[L] fun t => X t ^ 5) :
    (fun t => X t - series (correctD4 q j s l) q j s (1 / (Apoly q j s l (X t) + E t) - 1))
      =o[L] fun t => X t ^ 5 := by
  set u : α → ℝ := fun t => Apoly q j s l (X t) + E t with hu
  set z : α → ℝ := fun t => 1 / u t - 1 with hz
  have hE0 : Tendsto E L (𝓝 0) := by
    have : Tendsto (fun t => X t ^ 5) L (𝓝 0) := by simpa using hX.pow 5
    exact hE.trans_tendsto this
  have hA : Continuous (Apoly q j s l) := by unfold Apoly; fun_prop
  have hu1 : Tendsto u L (𝓝 1) := by
    have h := ((hA.tendsto 0).comp hX).add hE0
    rw [show Apoly q j s l 0 + 0 = 1 by simp [Apoly]] at h
    exact h
  have hune : ∀ᶠ t in L, u t ≠ 0 := hu1.eventually_ne one_ne_zero
  have hiu : Tendsto (fun t => 1 / u t) L (𝓝 1) := by
    simpa [one_div] using hu1.inv₀ one_ne_zero
  have hz0 : Tendsto z L (𝓝 0) := by
    simpa [hz] using hiu.sub_const 1
  have hinvu : (fun t => 1 / u t) =O[L] (fun _ => (1 : ℝ)) := hiu.isBigO_one ℝ
  have hzb : z =O[L] (fun _ => (1 : ℝ)) := hz0.isBigO_one ℝ
  have hB : Continuous (Bpoly q j s l) := by unfold Bpoly; fun_prop
  have hC0 : Continuous (C0poly q j s l) := by unfold C0poly; fun_prop
  have p1 : (fun t => z t ^ 1 - Zp1 q j s l (X t)) =o[L] fun t => X t ^ 5 := by
    have e1 : ∀ᶠ t in L, -(X t ^ 6 * C0poly q j s l (X t) + E t * Bpoly q j s l (X t))
        * (1 / u t) = z t ^ 1 - Zp1 q j s l (X t) := by
      filter_upwards [hune] with t ht
      rw [idZ1]
      simp only [hz, hu] at ht ⊢
      field_simp
      linear_combination idAB q j s l (X t)
    have a1 := x6 hX _ (bdd hX _ hC0)
    have a2 : (fun t => E t * Bpoly q j s l (X t)) =o[L] fun t => X t ^ 5 := by
      simpa using hE.mul_isBigO (bdd hX _ hB)
    have a3 := ((a1.add a2).neg_left).mul_isBigO hinvu
    simp only [mul_one] at a3
    exact a3.congr' e1 EventuallyEq.rfl
  have step : ∀ (k : ℕ) (Zk Zk1 Wk : ℝ → ℝ), Continuous Zk → Continuous Wk →
      (∀ x, Zp1 q j s l x * Zk x = Zk1 x + x ^ 6 * Wk x) →
      (fun t => z t ^ k - Zk (X t)) =o[L] (fun t => X t ^ 5) →
      (fun t => z t ^ (k + 1) - Zk1 (X t)) =o[L] (fun t => X t ^ 5) := by
    intro k Zk Zk1 Wk hZk hWk hid hk
    have b1 : (fun t => z t * (z t ^ k - Zk (X t))) =o[L] fun t => X t ^ 5 := by
      simpa using hzb.mul_isLittleO hk
    have b2 : (fun t => (z t ^ 1 - Zp1 q j s l (X t)) * Zk (X t)) =o[L] fun t => X t ^ 5 := by
      simpa using p1.mul_isBigO (bdd hX _ hZk)
    have b3 := x6 hX _ (bdd hX _ hWk)
    refine ((b1.add b2).add b3).congr' (Eventually.of_forall fun t => ?_) EventuallyEq.rfl
    have := hid (X t)
    simp only
    linear_combination (-1 : ℝ) * this
  have hZ1 : Continuous (Zp1 q j s l) := by unfold Zp1; fun_prop
  have hZ2 : Continuous (Zp2 q j s l) := by unfold Zp2; fun_prop
  have hZ3 : Continuous (Zp3 q j s l) := by unfold Zp3; fun_prop
  have hZ4 : Continuous (Zp4 q j s l) := by unfold Zp4; fun_prop
  have hW1 : Continuous (Wp1 q j s l) := by unfold Wp1; fun_prop
  have hW2 : Continuous (Wp2 q j s l) := by unfold Wp2; fun_prop
  have hW3 : Continuous (Wp3 q j s l) := by unfold Wp3; fun_prop
  have hW4 : Continuous (Wp4 q j s l) := by unfold Wp4; fun_prop
  have p2 := step 1 _ _ _ hZ1 hW1 (idW1 q j s l) p1
  have p3 := step 2 _ _ _ hZ2 hW2 (idW2 q j s l) p2
  have p4 := step 3 _ _ _ hZ3 hW3 (idW3 q j s l) p3
  have p5 := step 4 _ _ _ hZ4 hW4 (idW4 q j s l) p4
  have fin := (((p1.add (p2.const_mul_left (D1 q))).add (p3.const_mul_left (D2 q j))).add
    (p4.const_mul_left (D3 q j s))).add (p5.const_mul_left (correctD4 q j s l))
  refine fin.neg_left.congr' (Eventually.of_forall fun t => ?_) EventuallyEq.rfl
  have := idF q j s l (X t)
  simp only [series, hz, hu] at this ⊢
  linear_combination this

/-! ### Redshift near `t₀` -/

/-- The redshift is differentiable at `t₀` with derivative `−H₀`. -/
lemma hasDerivAt_redshift (a : ℝ → ℝ) (t₀ : ℝ) (hd : DifferentiableAt ℝ a t₀) (ha0 : a t₀ ≠ 0) :
    HasDerivAt (fun t => redshift a t₀ t) (-hubble a t₀) t₀ := by
  have h := ((hasDerivAt_const t₀ (a t₀)).div hd.hasDerivAt ha0).sub_const 1
  have e : (0 * a t₀ - a t₀ * deriv a t₀) / a t₀ ^ 2 = -hubble a t₀ := by
    simp only [hubble]; field_simp; ring
  rw [e] at h
  exact h

/-- `t − t₀ = O(z)` when `H₀ ≠ 0`. -/
lemma sub_isBigO_redshift (a : ℝ → ℝ) (t₀ : ℝ) (hd : DifferentiableAt ℝ a t₀) (ha0 : a t₀ ≠ 0)
    (hH : hubble a t₀ ≠ 0) :
    (fun t => t - t₀) =O[𝓝 t₀] (fun t => redshift a t₀ t) := by
  have hz := hasDerivAt_redshift a t₀ hd ha0
  have hz0 : redshift a t₀ t₀ = 0 := by simp [redshift, ha0]
  rw [hasDerivAt_iff_isLittleO] at hz
  have hc : (-hubble a t₀) ≠ 0 := neg_ne_zero.2 hH
  have h2 : (fun t => t - t₀) =O[𝓝 t₀] (fun t => (t - t₀) • (-hubble a t₀)) := by
    refine IsBigO.of_bound (‖-hubble a t₀‖⁻¹) (Eventually.of_forall fun t => ?_)
    have hn : ‖-hubble a t₀‖ ≠ 0 := norm_ne_zero_iff.2 hc
    rw [norm_smul, show ‖-hubble a t₀‖⁻¹ * (‖t - t₀‖ * ‖-hubble a t₀‖) = ‖t - t₀‖ by
      field_simp]
  have h3 := (hz.trans_isBigO h2).right_isBigO_add
  refine h2.trans (h3.congr_right fun t => ?_)
  simp [hz0]

/-- **Lookback time to fifth order in redshift** (correct version of Eq. (A2)): for every
scale factor that is `C⁵` at `t₀`, with `a(t₀) ≠ 0` and `H₀ ≠ 0`. -/
theorem lookback_fifth_order (a : ℝ → ℝ) (t₀ : ℝ) (ha : ContDiffAt ℝ 5 a t₀)
    (ha0 : a t₀ ≠ 0) (hH : hubble a t₀ ≠ 0) :
    (fun t => remainder correctD4 a t₀ t) =o[𝓝 t₀] (fun t => redshift a t₀ t ^ 5) := by
  set a₀ := a t₀ with ha₀
  set H := hubble a t₀ with hHdef
  set q := decel a t₀
  set j := cosmoCoeff 3 a t₀
  set s := cosmoCoeff 4 a t₀
  set l := cosmoCoeff 5 a t₀
  have hd : DifferentiableAt ℝ a t₀ := ha.differentiableAt (by norm_num)
  -- Taylor's theorem on a ball
  obtain ⟨U, hU, hcd⟩ := ha.contDiffOn le_rfl (by simp)
  obtain ⟨δ, hδ, hball⟩ := Metric.mem_nhds_iff.1 hU
  have hopen : IsOpen (Metric.ball t₀ δ) := Metric.isOpen_ball
  have hmem : t₀ ∈ Metric.ball t₀ δ := Metric.mem_ball_self hδ
  have hT := taylor_isLittleO (convex_ball t₀ δ) hmem (hcd.mono hball)
  rw [hopen.nhdsWithin_eq hmem] at hT
  -- the Taylor polynomial is `a₀ A(x)`
  have hid : ∀ k, iteratedDerivWithin k a (Metric.ball t₀ δ) t₀ = iteratedDeriv k a t₀ :=
    fun k => iteratedDerivWithin_of_isOpen hopen hmem
  have d1 : iteratedDeriv 1 a t₀ = H * a₀ := by
    rw [iteratedDeriv_one]; simp only [hHdef, hubble]; rw [← ha₀]; field_simp
  have hd1 : deriv a t₀ ≠ 0 := by
    intro h0; apply hH; simp [hHdef, hubble, h0]
  have d2 : iteratedDeriv 2 a t₀ = -q * H ^ 2 * a₀ := by
    rw [iteratedDeriv_succ, iteratedDeriv_one]
    simp only [q, decel, hHdef, hubble]; rw [← ha₀]; field_simp
  have dk : ∀ k, iteratedDeriv k a t₀ = cosmoCoeff k a t₀ * (a₀ * H ^ k) := by
    intro k; simp only [cosmoCoeff, hHdef]
    rw [div_mul_cancel₀]; exact mul_ne_zero ha0 (pow_ne_zero _ hH)
  have hpoly : ∀ t, taylorWithinEval a 5 (Metric.ball t₀ δ) t₀ t
      = a₀ * Apoly q j s l (H * (t₀ - t)) := by
    intro t
    rw [taylor_within_apply]
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, hid, smul_eq_mul]
    rw [iteratedDeriv_zero, d1, d2, dk 3, dk 4, dk 5]
    simp only [Apoly, Nat.factorial, Nat.cast_ofNat]
    push_cast
    ring
  set X : ℝ → ℝ := fun t => H * (t₀ - t) with hX
  set E : ℝ → ℝ := fun t => a t / a₀ - Apoly q j s l (X t) with hE
  have hXt : Tendsto X (𝓝 t₀) (𝓝 0) := by
    have : Continuous X := by fun_prop
    simpa [hX] using this.tendsto t₀
  have htX : (fun t => t - t₀) =O[𝓝 t₀] X := by
    refine IsBigO.of_bound (‖H‖⁻¹) (Eventually.of_forall fun t => ?_)
    simp only [hX, norm_mul]
    rw [← mul_assoc, inv_mul_cancel₀ (norm_ne_zero_iff.2 hH), one_mul, ← norm_neg]; ring_nf; rfl
  have hEo : E =o[𝓝 t₀] fun t => X t ^ 5 := by
    have h1 : E = fun t => a₀⁻¹ * (a t - taylorWithinEval a 5 (Metric.ball t₀ δ) t₀ t) := by
      funext t; simp only [hE, hpoly, hX]; field_simp
    rw [h1]
    exact (hT.const_mul_left a₀⁻¹).trans_isBigO (htX.pow 5)
  have key := inversion q j s l X E hXt hEo
  have hXz : X =O[𝓝 t₀] fun t => redshift a t₀ t := by
    have : X =O[𝓝 t₀] (fun t => t - t₀) := by
      refine IsBigO.of_bound (‖H‖) (Eventually.of_forall fun t => ?_)
      simp only [hX, norm_mul, ← norm_neg (t₀ - t)]; ring_nf; rfl
    exact this.trans (sub_isBigO_redshift a t₀ hd ha0 hH)
  refine (key.trans_isBigO (hXz.pow 5)).congr' (Eventually.of_forall fun t => ?_) EventuallyEq.rfl
  have hz : 1 / (Apoly q j s l (X t) + E t) - 1 = redshift a t₀ t := by
    simp only [hE, redshift]; rw [add_sub_cancel, one_div_div]
  show X t - _ = _
  rw [hz]; rfl


/-- The printed `D⁴` fails for every `C⁵` scale factor with `a(t₀) ≠ 0`, `H₀ ≠ 0`, `q₀ ≠ 0`. -/
theorem printedD4_fails (a : ℝ → ℝ) (t₀ : ℝ) (ha : ContDiffAt ℝ 5 a t₀)
    (ha0 : a t₀ ≠ 0) (hH : hubble a t₀ ≠ 0) (hq : decel a t₀ ≠ 0) :
    ¬ (fun t => remainder printedD4 a t₀ t) =o[𝓝 t₀] (fun t => redshift a t₀ t ^ 5) := by
  intro hp
  have hc := lookback_fifth_order a t₀ ha ha0 hH
  set c : ℝ := -(21 / 8 * decel a t₀ ^ 4) with hcdef
  have hc0 : c ≠ 0 := neg_ne_zero.2 (mul_ne_zero (by norm_num) (pow_ne_zero 4 hq))
  have hdiff : (fun t => c * redshift a t₀ t ^ 5) =o[𝓝 t₀] (fun t => redshift a t₀ t ^ 5) := by
    refine (hp.sub hc).congr' (Eventually.of_forall fun t => ?_) EventuallyEq.rfl
    simp only [remainder, series, printedD4, correctD4, hcdef]; ring
  have hself : (fun t => redshift a t₀ t ^ 5) =o[𝓝 t₀] (fun t => redshift a t₀ t ^ 5) :=
    (hdiff.const_mul_left c⁻¹).congr' (Eventually.of_forall fun t => by
      simp only; rw [← mul_assoc, inv_mul_cancel₀ hc0, one_mul]) EventuallyEq.rfl
  have hd : DifferentiableAt ℝ a t₀ := ha.differentiableAt (by norm_num)
  have hev := (hasDerivAt_redshift a t₀ hd ha0).eventually_ne (c := 0) (neg_ne_zero.2 hH)
  have hfreq : ∃ᶠ t in 𝓝 t₀, ‖redshift a t₀ t ^ 5‖ ≠ 0 :=
    ((hev.mono fun t ht => by simpa using ht).frequently).filter_mono nhdsWithin_le_nhds
  exact isLittleO_irrefl' hfreq hself


/-- The printed claim is false (witness: de Sitter, `a = exp`, `t₀ = 0`). -/
theorem ccsD4Claim_false : ¬ CCSD4Claim := by
  intro h
  have hH : hubble Real.exp 0 = 1 := by simp [hubble, Real.deriv_exp]
  have hq : decel Real.exp 0 = -1 := by simp [decel, Real.deriv_exp]
  exact printedD4_fails Real.exp 0 Real.contDiff_exp.contDiffAt (Real.exp_pos 0).ne'
    (by rw [hH]; norm_num) (by rw [hq]; norm_num)
    (h Real.exp 0 Real.contDiff_exp Real.exp_pos (by rw [hH]; norm_num))


/-- The printed claim read for past emission only (`t < t₀`, the physical case), weakest reading,
strongest hypotheses. -/
def CCSD4ClaimPast : Prop :=
  ∀ (a : ℝ → ℝ) (t₀ : ℝ), ContDiff ℝ ω a → (∀ t, 0 < a t) → 0 < hubble a t₀ →
    (fun t => remainder printedD4 a t₀ t) =o[𝓝[<] t₀] (fun t => redshift a t₀ t ^ 5)

/-- The printed `D⁴` fails for past emission in every `C⁵` model with `H₀ ≠ 0`, `q₀ ≠ 0`. -/
theorem printedD4_fails_past (a : ℝ → ℝ) (t₀ : ℝ) (ha : ContDiffAt ℝ 5 a t₀)
    (ha0 : a t₀ ≠ 0) (hH : hubble a t₀ ≠ 0) (hq : decel a t₀ ≠ 0) :
    ¬ (fun t => remainder printedD4 a t₀ t) =o[𝓝[<] t₀] (fun t => redshift a t₀ t ^ 5) := by
  sorry

/-- The past-only reading of the printed claim is false (de Sitter). -/
theorem ccsD4ClaimPast_false : ¬ CCSD4ClaimPast := by
  sorry

