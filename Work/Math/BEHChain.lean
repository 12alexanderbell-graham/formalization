  obtain ⟨hinvb, hend1, hend2⟩ := cell_facts c104 hok hub hvb a7 b7
  obtain ⟨ke, kE, kφ⟩ := of_decide_eq_true br_link
  have he : ((c104.t0 + c104.h : ℚ) : ℝ) = (c105.t0 : ℝ) := by exact_mod_cast ke
