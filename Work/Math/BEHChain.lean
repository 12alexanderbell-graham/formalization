  have hub : ∀ t ∈ Icc (c104.t0 : ℝ) (c104.t0 + c104.h),
      HasDerivWithinAt u (u t * (3 - u t - v t) / t) (Icc ((7 : ℚ) : ℝ) ((150 : ℚ) : ℝ)) t := fun t ht =>
