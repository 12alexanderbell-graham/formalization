import Work.Math.BEHData

/-! Bonnor–Ebert sphere, `BEHChain`: the cells of `BEHData` chained along every solution of the homology
system on [7, 150] that starts in the first cell's input box: 2u − v < 0 on [7, 67.00752], the bracket cell
on [67.00752, 67.00758] (6u − 2u² − 3uv + v > 0 and u in a window), 2u − v > 0 on [67.00758, 150], and the
state at 150. Generated by `runs/2026-11-14T0428Z/scripts/emit_chain.py`. -/

namespace Work.Math.BEHChain
open Set Checked.Sim Checked.Sim.QPoly Work.Math.BEHCell Work.Math.BEHData
open Checked.Math.GCellQ (lo hi lo_le le_hi abs_link icc_glue)

theorem br_u : decide ((932876650 / 1000000000 : ℚ) ≤ lo c104.pu c104.h - c104.B ∧
    hi c104.pu c104.h + c104.B ≤ 932877060 / 1000000000) = true := by
  decide +kernel

set_option maxHeartbeats 4000000 in
theorem chain {u v : ℝ → ℝ}
