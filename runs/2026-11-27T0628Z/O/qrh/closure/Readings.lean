import Mathlib

namespace ReaderA

/-!
# Blind reading A: the quasi-Riemann hypothesis claims (target O)

Sources: `paper_sep30_lines.tex` (paper.tex, 30 Sep 2026) and
`paper2_oct5_lines.tex` (paper2.tex, 5 Oct 2026).
-/

open Complex NumberField

noncomputable section

namespace QRHReadingA

/-! ## Riemann zeta -/

/-- "ζ(s) has no zero in Re s > σ₀". Mathlib's `riemannZeta` carries a junk value at the
pole `s = 1`; we exclude `s = 1` explicitly (a pole is not a zero). -/
def ReadingZeta (σ₀ : ℝ) : Prop :=
  ∀ s : ℂ, σ₀ < s.re → s ≠ 1 → riemannZeta s ≠ 0

/-! ## Dirichlet L-functions -/

/-- Sep 30 reading: every Dirichlet character `χ` modulo every `N ≥ 1` (primitive or not,
extended by zero on non-units, which is how Mathlib's `DirichletCharacter` evaluates on
`ZMod N`). The value of `LFunction χ` at `s = 1` is junk only when `χ` is principal
(`χ = 1`), so `s = 1` is excluded exactly in that case. For non-principal `χ`,
`LFunction χ` is entire and its value at `1` is the genuine one, so `s = 1` is included. -/
def ReadingDirichlet (σ₀ : ℝ) : Prop :=
  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ),
    σ₀ < s.re → (χ = 1 → s ≠ 1) → χ.LFunction s ≠ 0

/-- Oct 5 reading: the manuscript defines "Dirichlet L-function" only for a *primitive*
character `χ` of conductor `q`. Among primitive characters only the character mod 1
(giving ζ) is principal, so the pole exclusion only bites there. -/
def ReadingDirichletPrim (σ₀ : ℝ) : Prop :=
  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N), χ.IsPrimitive →
    ∀ s : ℂ, σ₀ < s.re → (χ = 1 → s ≠ 1) → χ.LFunction s ≠ 0

/-! ## Finite-order Hecke characters over `F = ℚ(√-3)`

Model: `F = CyclotomicField 3 ℚ = ℚ(ζ₃) = ℚ(√-3)`, `𝓞 = 𝓞 F`. -/

/-- Our model of `ℚ(√-3)`. -/
abbrev F : Type := CyclotomicField 3 ℚ

/-- The monoid of nonzero integral ideals coprime to `𝔣`. -/
def coprimeIdeals (𝔣 : Ideal (𝓞 F)) : Submonoid (Ideal (𝓞 F)) where
  carrier := {𝔞 | 𝔞 ≠ ⊥ ∧ IsCoprime 𝔞 𝔣}
  one_mem' := ⟨by simp, isCoprime_one_left⟩
  mul_mem' := by
    intro a b ha hb
    refine ⟨?_, IsCoprime.mul_left ha.2 hb.2⟩
    intro h
    rcases Ideal.mul_eq_bot.mp h with h' | h'
    · exact ha.1 h'
    · exact hb.1 h'

/-- `I^𝔣`: the group of fractional ideals coprime to `𝔣`, realised as the group completion
(Grothendieck group) of the monoid of nonzero integral ideals coprime to `𝔣`. (The monoid of
nonzero integral ideals of a Dedekind domain is free commutative on the primes, so its group
completion is the free abelian group on the primes not dividing `𝔣`, i.e. `I^𝔣`.) -/
abbrev coprimeFracIdeals (𝔣 : Ideal (𝓞 F)) : Type :=
  Algebra.GrothendieckGroup (coprimeIdeals 𝔣)

/-- `P^𝔣_1`: the subgroup generated by the principal ideals `(α)`, `α ∈ 𝓞`, `α ≡ 1 mod 𝔣`.
(Every `(a/b)` with `a, b` integral, coprime to `𝔣`, `a ≡ b mod 𝔣` is a quotient of two such
ideals: `(a/b) = (a b')/(b b')` with `b b' ≡ 1 mod 𝔣`; and `F` has no real place, so no
positivity condition.) Note `α - 1 ∈ 𝔣` forces `(α)` coprime to `𝔣`. -/
def rayPrincipal (𝔣 : Ideal (𝓞 F)) : Subgroup (coprimeFracIdeals 𝔣) :=
  Subgroup.closure
    {x | ∃ (α : 𝓞 F) (h : Ideal.span {α} ∈ coprimeIdeals 𝔣), α - 1 ∈ 𝔣 ∧
      x = Algebra.GrothendieckGroup.of ⟨Ideal.span {α}, h⟩}

/-- The ray class group modulo `𝔣`: `I^𝔣 / P^𝔣_1`. -/
abbrev RayClassGroup (𝔣 : Ideal (𝓞 F)) : Type :=
  coprimeFracIdeals 𝔣 ⧸ rayPrincipal 𝔣

/-- A finite-order Hecke character modulo `𝔣`: a character of the ray class group mod `𝔣`
(the ray class group is finite, so every such character has finite order). -/
abbrev HeckeChar (𝔣 : Ideal (𝓞 F)) : Type := RayClassGroup 𝔣 →* ℂˣ

/-- The class in the ray class group of an integral ideal coprime to `𝔣`. -/
def rayClass {𝔣 : Ideal (𝓞 F)} (𝔞 : coprimeIdeals 𝔣) : RayClassGroup 𝔣 :=
  QuotientGroup.mk (Algebra.GrothendieckGroup.of 𝔞)

open Classical in
/-- `η` extended by zero to integral ideals not coprime to `𝔣`. -/
def HeckeChar.extZero {𝔣 : Ideal (𝓞 F)} (η : HeckeChar 𝔣) (𝔞 : Ideal (𝓞 F)) : ℂ :=
  if h : 𝔞 ∈ coprimeIdeals 𝔣 then ((η (rayClass ⟨𝔞, h⟩) : ℂˣ) : ℂ) else 0

/-- The `𝔞`-th term `η(𝔞) (N𝔞)^{-s}` of `L_F(s, η)`, indexed by nonzero integral ideals.
`N𝔞 = Ideal.absNorm 𝔞 = |𝓞/𝔞| ≥ 1` for `𝔞 ≠ 0`, so no `0 ^ s` occurs. -/
def heckeTerm {𝔣 : Ideal (𝓞 F)} (η : HeckeChar 𝔣) (s : ℂ) :
    {𝔞 : Ideal (𝓞 F) // 𝔞 ≠ ⊥} → ℂ :=
  fun 𝔞 => η.extZero 𝔞.1 / (Ideal.absNorm 𝔞.1 : ℂ) ^ s

/-- "Every finite-order Hecke L-function over ℚ(√-3) has no zero in Re s > σ₀, the pole at
`s = 1` of a principal character allowed."

We quantify over every `f : ℂ → ℂ` holomorphic on `ℂ ∖ {1}` that equals the Dirichlet series
`∑_{𝔞 ≠ 0} η(𝔞) N𝔞^{-s}` (as an unconditional `HasSum`) for `Re s > 1`. For a non-principal
`η` the true `L_F(s, η)` is entire, so we additionally require `f` differentiable at `1`;
otherwise `f 1` would be unconstrained. The pole point `s = 1` is excluded only for the
principal character `η = 1`. By the identity theorem on the connected open set `ℂ ∖ {1}`
(plus continuity at `1` in the non-principal case), such an `f` is unique and equals the
meromorphic continuation wherever the latter is holomorphic. -/
def ReadingHecke (σ₀ : ℝ) : Prop :=
  ∀ (𝔣 : Ideal (𝓞 F)), 𝔣 ≠ ⊥ → ∀ (η : HeckeChar 𝔣) (f : ℂ → ℂ),
    DifferentiableOn ℂ f {1}ᶜ →
    (η ≠ 1 → DifferentiableAt ℂ f 1) →
    (∀ s : ℂ, 1 < s.re → HasSum (heckeTerm η s) (f s)) →
    ∀ s : ℂ, σ₀ < s.re → (η = 1 → s ≠ 1) → f s ≠ 0

/-! ## Headline claims -/

/-- 30 Sep 2026 (paper.tex), Theorem `thm:main`: all Dirichlet characters, `σ₀ = 7/8`. -/
theorem reading_sep30 :
    ReadingHecke (7/8) ∧ ReadingDirichlet (7/8) ∧ ReadingZeta (7/8) := sorry

/-- 5 Oct 2026 (paper2.tex), Theorem `thm:main`: Dirichlet L-functions defined for primitive
characters only, `σ₀ = 11/12`. -/
theorem reading_oct5 :
    ReadingHecke (11/12) ∧ ReadingDirichletPrim (11/12) ∧ ReadingZeta (11/12) := sorry

end QRHReadingA

end

/-!
## Ambiguities and choices

1. **Pole at `s = 1` / junk values.** Mathlib's `riemannZeta` and `DirichletCharacter.LFunction`
   are total; at `s = 1` for a principal character the value is junk. `ReadingZeta` excludes
   `s = 1`; `ReadingDirichlet(Prim)` exclude `s = 1` exactly when `χ = 1` (principal mod `N`).
   For non-principal `χ` the Mathlib function is entire and `s = 1` is included (so
   `L(1, χ) ≠ 0` is part of the claim, as it should be: Sep 30 explicitly says "any exceptional
   real zero in (7/8, 1) is excluded"; Oct 5 says Landau–Siegel zeros are ruled out).
   For Hecke, `ReadingHecke` excludes `s = 1` only for `η = 1`; for `η ≠ 1` it forces `f` to be
   differentiable at `1` so that `f 1` is the genuine value.

2. **Which Dirichlet characters.** Sep 30: "For a Dirichlet character χ modulo q, extended by
   zero on nonunits ... the character modulo 1 gives ζ" and "every Dirichlet L-function" —
   read as *every* character modulo *every* `q ≥ 1`, imprimitive ones included
   (`ReadingDirichlet`). Oct 5: "For a primitive Dirichlet character χ of conductor q, the
   associated *Dirichlet L-function* is ..."; uniformity is "for every primitive character χ"
   — read as primitive only (`ReadingDirichletPrim`). Mathematically the two are equivalent
   for any `σ₀ > 0` (an imprimitive `L(s,χ)` differs from the primitive one by finitely many
   factors `1 - χ*(p) p^{-s}` that vanish only on `Re s = 0`), but literally they differ.
   Modulus `N = 0` is excluded (`NeZero N`; Mathlib's `LFunction` requires it, and no
   manuscript considers modulus 0).

3. **Which Hecke characters.** Both manuscripts: "every finite-order Hecke L-function over
   ℚ(√-3)". Sep 30 defines it as a character of the ray class group mod a nonzero integral
   ideal `𝔣`, extended by zero to ideals not coprime to `𝔣`, and `L_F(s,η) = ∑_{𝔞≠0} η(𝔞)
   N𝔞^{-s}`. All characters mod all `𝔣 ≠ 0` (imprimitive included) are quantified. The Oct 5
   excerpt does not define Hecke characters; I use the same definition for it.
   Oct 5's Hecke statement does not mention the pole, but the trivial character gives the
   Dedekind zeta function, which has a pole at 1 that is not a zero; so the same pole
   convention is used for both.

4. **Ray class group in Mathlib.** Mathlib has no ray class group. I build it as literally as
   I could: `I^𝔣` = Grothendieck group of the monoid of nonzero integral ideals coprime to
   `𝔣` (isomorphic to the group of fractional ideals coprime to `𝔣`, since the monoid of
   nonzero integral ideals of a Dedekind domain is free commutative on primes), and `P^𝔣_1` =
   subgroup generated by `(α)`, `α ∈ 𝓞`, `α ≡ 1 mod 𝔣`. This equals the usual `P^𝔣_1`
   (principal fractional ideals `(α)` with `α ≡ 1 mod^× 𝔣`): `(a/b) = (ab')/(bb')` with
   `bb' ≡ ab' ≡ 1 mod 𝔣`. No sign/positivity condition since `F` is imaginary quadratic.
   What changes: `I^𝔣` is an abstract group completion, not literally a set of fractional
   ideals; the characters (homomorphisms to `ℂˣ`) are in canonical bijection with those of
   the literal ray class group. Finite order is not imposed separately: the ray class group
   is finite, so it is automatic (and the Sep 30 text notes the idelic finite-order
   definition agrees).
   Model of `ℚ(√-3)`: `CyclotomicField 3 ℚ`, which is `ℚ(ζ₃) = ℚ(√-3)`.

5. **Convergence.** `heckeTerm η s` is summed via `HasSum` over `{𝔞 : Ideal 𝓞 // 𝔞 ≠ ⊥}`,
   only for `Re s > 1`. There `|η(𝔞)| ≤ 1` (values are roots of unity or 0) and
   `∑_{𝔞≠0} N𝔞^{-σ} = ζ_F(σ) = ζ(σ) L(σ, χ_{-3}) < ∞` for `σ > 1`, so the family is absolutely
   (hence unconditionally) summable; the `HasSum` hypothesis is therefore satisfiable and pins
   down `f` on `Re s > 1`. `N𝔞 ≥ 1` for `𝔞 ≠ 0`, so no `0 ^ s`. The Dirichlet sides use
   Mathlib's `LFunction`/`riemannZeta`, so no tsum is used anywhere.

6. **"No zero in Re s > σ₀"**: strict half-plane, boundary excluded (Sep 30: "The boundary
   Re s = 7/8 is not included"). Values are compared to `0` directly.

## Differences between the two manuscripts' headline claims

* Constant: Sep 30 `7/8` ("zero-free in the half-plane Re s > 7/8"); Oct 5 `11/12`
  ("has no zeros in the half-plane Re s > 11/12"). Since 7/8 < 11/12, the Sep 30 claim is
  stronger: `reading_sep30` implies `reading_oct5` (Hecke and zeta parts directly; primitive
  Dirichlet is a special case of all Dirichlet).
* Sep 30 Theorem: "Every finite-order Hecke L-function over F = ℚ(√-3) has no zero in
  Re s > 7/8. The same holds for every Dirichlet L-function, including ζ(s). A pole at s = 1
  for a principal character is allowed." Abstract: "all finite-order Hecke L-functions over
  ℚ(√-3) and all Dirichlet L-functions are zero-free in the half-plane Re s > 7/8, with the
  principal pole at s = 1 allowed."
* Oct 5 Theorem: "Every finite-order Hecke L-function over K has no zeros in the half-plane
  Re s > 11/12. Thus every Dirichlet L-function, including ζ(s), has no zeros for
  Re s > 11/12." Abstract: "every Dirichlet L-function, including Riemann's zeta function,
  has no zeros in the half-plane Re s > 11/12. More generally, ... every finite-order Hecke
  L-function over K = ℚ(√-3). In particular, this rules out the existence of Landau--Siegel
  zeros."
* Dirichlet scope: Sep 30 every character mod every `q` (extended by zero on nonunits);
  Oct 5 the L-function is defined only for primitive characters.
* Pole: stated explicitly in Sep 30; not mentioned in Oct 5 (implicit, a pole is not a zero).
* Logical structure: Sep 30 states Hecke and Dirichlet as parallel claims; Oct 5 derives the
  Dirichlet claim from the Hecke one ("Thus").
* Quasi-RH formulation: Sep 30 "a fixed σ₀ < 1 for which ζ(s) ≠ 0 in Re s > σ₀"; Oct 5
  "there exists ε > 0 such that ζ(s) has no zeros in Re s > 1 - ε". Same content.
-/
end ReaderA

namespace ReaderB

open NumberField

/-- ζ has no zero in Re s > σ₀. The junk value at the pole s = 1 is avoided by excluding s = 1. -/
def ReadingZeta (σ₀ : ℝ) : Prop :=
  ∀ s : ℂ, σ₀ < s.re → s ≠ 1 → riemannZeta s ≠ 0

/-- Sep 30 reading: EVERY Dirichlet character χ mod N (N ≥ 1), imprimitive allowed, extended by zero
on nonunits (this is Mathlib's `DirichletCharacter`).  The only allowed pole is s = 1 for the
trivial character (mod N); for every other χ the point s = 1 is included in the claim
(Mathlib's `LFunction` is the entire continuation for χ ≠ 1). -/
def ReadingDirichlet (σ₀ : ℝ) : Prop :=
  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ),
    σ₀ < s.re → (χ ≠ 1 ∨ s ≠ 1) → χ.LFunction s ≠ 0

/-- Oct 5 reading: only primitive characters. -/
def ReadingDirichletPrim (σ₀ : ℝ) : Prop :=
  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N), χ.IsPrimitive →
    ∀ s : ℂ, σ₀ < s.re → (χ ≠ 1 ∨ s ≠ 1) → χ.LFunction s ≠ 0

/-- The field Q(√-3) = Q(ζ₃), and its ring of integers. -/
abbrev QsqrtNeg3 : Type := CyclotomicField 3 ℚ
abbrev OK : Type := 𝓞 QsqrtNeg3

/-- A finite-order Hecke character modulo a nonzero integral ideal `𝔣` of `OK`:
a character of the ray class group mod 𝔣 (K imaginary quadratic, so no real conditions),
extended by zero to ideals not coprime to 𝔣.  Ray class group = I(𝔣)/P_{𝔣,1}; every class has an
integral representative, so a character is encoded as a multiplicative function `toFun` on
nonzero integral ideals coprime to 𝔣 (which extends uniquely to fractional ideals coprime to 𝔣),
trivial on P_{𝔣,1}: principal ideals (α), α ≡ 1 mod^× 𝔣, i.e. α = a/b with a,b ∈ OK nonzero,
coprime to 𝔣, a - b ∈ 𝔣; this says exactly toFun (a) = toFun (b). -/
structure HeckeChar (𝔣 : Ideal OK) where
  toFun : Ideal OK → ℂ
  map_one : toFun ⊤ = 1
  map_mul : ∀ 𝔞 𝔟 : Ideal OK, 𝔞 ≠ ⊥ → 𝔟 ≠ ⊥ → toFun (𝔞 * 𝔟) = toFun 𝔞 * toFun 𝔟
  eq_zero_of_not_coprime : ∀ 𝔞 : Ideal OK, 𝔞 ≠ ⊥ → 𝔞 ⊔ 𝔣 ≠ ⊤ → toFun 𝔞 = 0
  trivial_on_principal : ∀ a b : OK, a ≠ 0 → b ≠ 0 →
    Ideal.span {a} ⊔ 𝔣 = ⊤ → Ideal.span {b} ⊔ 𝔣 = ⊤ → a - b ∈ 𝔣 →
    toFun (Ideal.span {a}) = toFun (Ideal.span {b})
  finite_order : ∃ n : ℕ, 0 < n ∧ ∀ 𝔞 : Ideal OK, 𝔞 ≠ ⊥ → 𝔞 ⊔ 𝔣 = ⊤ → toFun 𝔞 ^ n = 1

/-- The principal (trivial) character: value 1 on every ideal coprime to 𝔣. -/
def HeckeChar.IsPrincipal {𝔣 : Ideal OK} (η : HeckeChar 𝔣) : Prop :=
  ∀ 𝔞 : Ideal OK, 𝔞 ≠ ⊥ → 𝔞 ⊔ 𝔣 = ⊤ → η.toFun 𝔞 = 1

/-- Terms of `∑_{𝔞 ≠ 0} η(𝔞) N𝔞^{-s}`; `N𝔞 = |OK/𝔞|` is a positive natural number, so the
complex power and the division are harmless. -/
noncomputable def HeckeChar.term {𝔣 : Ideal OK} (η : HeckeChar 𝔣) (s : ℂ)
    (𝔞 : {I : Ideal OK // I ≠ ⊥}) : ℂ :=
  η.toFun 𝔞.1 / ((Ideal.absNorm 𝔞.1 : ℕ) : ℂ) ^ s

/-- Every finite-order Hecke L-function over Q(√-3) has no zero in Re s > σ₀.
Quantified over every `F` holomorphic off 1 and equal to the Dirichlet series for Re s > 1
(stated by `HasSum`, avoiding `tsum`; the series converges absolutely for Re s > 1 since η is
bounded by 1 on the coprime ideals and the Dedekind zeta series converges there; such F is unique
by the identity theorem).  Zero-freeness is claimed for s ≠ 1, and also at s = 1 whenever F is
continuous there (which for an actual L-function happens iff η is non-principal, the principal
case having a pole). -/
def ReadingHecke (σ₀ : ℝ) : Prop :=
  ∀ (𝔣 : Ideal OK), 𝔣 ≠ ⊥ → ∀ (η : HeckeChar 𝔣) (F : ℂ → ℂ),
    DifferentiableOn ℂ F {1}ᶜ →
    (∀ s : ℂ, 1 < s.re → HasSum (η.term s) (F s)) →
    ∀ s : ℂ, σ₀ < s.re → (s ≠ 1 ∨ ContinuousAt F 1) → F s ≠ 0

theorem reading_sep30 :
    ReadingHecke (7/8) ∧ ReadingDirichlet (7/8) ∧ ReadingZeta (7/8) := sorry

theorem reading_oct5 :
    ReadingHecke (11/12) ∧ ReadingDirichletPrim (11/12) ∧ ReadingZeta (11/12) := sorry

/-
AMBIGUITIES AND CHOICES
1. Zeta: Mathlib's riemannZeta is total; s = 1 is excluded (pole/junk).
2. Dirichlet characters. Sep 30: "For a Dirichlet character χ modulo q, extended by zero on nonunits"
   and "every Dirichlet L-function" -> all characters mod every N (ReadingDirichlet), imprimitive
   included. Oct 5: "For a primitive Dirichlet character χ of conductor q" and "for every
   primitive character" -> ReadingDirichletPrim. (Mathematically equivalent in effect, since
   imprimitive L-functions differ by finitely many Euler factors with zeros only on Re s = 0, but
   the formal statements differ.) The Oct 5 text says only "every Dirichlet L-function" in the
   theorem; I read it via its definition as primitive.
   Pole: only trivial χ at s = 1 is excluded. For trivial χ mod N > 1 Mathlib's LFunction is the
   zeta times Euler factors, also with a pole at 1.
3. Hecke: ray class group modelled literally as I(𝔣)/P_{𝔣,1} via integral representatives (see
   docstring); change: characters are functions on integral ideals rather than on fractional
   ideals (equivalent, unique extension). The ideal 𝔣 = ⊤ (conductor 1) is allowed; the zero ideal
   is excluded. Q(√-3) is modelled as CyclotomicField 3 ℚ. The conductor is any modulus, not
   necessarily the conductor (imprimitive characters allowed), in both manuscripts' "modulo 𝔣".
   The identification of "meromorphic continuation" is by quantifying over F; at s = 1, F is
   arbitrary a priori, so I only claim F 1 ≠ 0 under ContinuousAt F 1.
   The convergence of the Dirichlet series is not asserted; HasSum is a hypothesis on F.
4. "No zero in Re s > σ₀" is strict inequality in both; boundary not included (Sep 30 says so).

HEADLINE DIFFERENCES
 Sep 30: "all finite-order Hecke L-functions over Q(√-3) and all Dirichlet L-functions are zero-free
 in the half-plane Re s > 7/8, with the principal pole at s=1 allowed." (Theorem: "Every
 finite-order Hecke L-function over F has no zero in Re s>7/8. The same holds for every Dirichlet
 L-function, including ζ(s).")
 Oct 5: "every Dirichlet L-function, including Riemann's zeta function, has no zeros in the
 half-plane Re s>11/12. More generally, ... every finite-order Hecke L-function over K"; Theorem:
 "no zeros in the half-plane Re s>11/12."
 Differences: constant 7/8 vs 11/12 (7/8 is the STRONGER claim: a smaller half-plane threshold excludes more zeros; 11/12 is weaker); Sep 30 defines
 Dirichlet characters mod q generally, Oct 5 primitive ones; Oct 5 does not mention the pole at
 s = 1 allowance; Oct 5 adds the claim that Landau-Siegel zeros are ruled out; Sep 30 says the
 boundary and the exceptional zeros in (7/8,1) are excluded.
-/
end ReaderB

namespace ReaderC

/-!
# Reader C reading of the quasi-Riemann hypothesis manuscripts (target O)

Sources read: `sources/paper_sep30_lines.tex` (paper.tex, 30 Sep 2026) and
`sources/paper2_oct5_lines.tex` (paper2.tex, 5 Oct 2026). Only the brief and these
two excerpts were used. See the comment block at the end for ambiguities and for
the differences between the two headline claims.
-/

noncomputable section

open Ideal

namespace QRHReadingC

/-- The field `Q(√-3)`, modelled as `ℚ(ζ₃)`. -/
abbrev QK : Type := CyclotomicField 3 ℚ

/-- Its ring of integers `𝓞 = O_K`. -/
abbrev OK : Type := NumberField.RingOfIntegers QK

/-- A finite-order Hecke character of modulus `f` (a nonzero integral ideal), viewed as a
function on integral ideals, extended by zero to ideals not coprime to `f`
(coprime means `I ⊔ f = ⊤`, i.e. `I + f = 𝓞`).

It is a character of the ray class group mod `f`, in the following sense:
* it vanishes on ideals not coprime to `f`, and `η (𝓞) = 1`;
* it is multiplicative (on all integral ideals; the non-coprime case is automatic);
* it is trivial on principal ideals `(α)` with `α ≡ 1 mod^× f`. Such an `α` is written
  `a / b` with `a, b ∈ 𝓞` nonzero, coprime to `f`, and `a - b ∈ f`. The relation
  `(α) J = I` between integral ideals `I, J` coprime to `f` reads `(b) I = (a) J`, and
  then `η I = η J`. This is the statement that `η` factors through
  `I ↦ I J⁻¹`, i.e. through the ray class group;
* it has finite order: some `n ≥ 1` has `η I ^ n = 1` for all coprime `I`. -/
structure IsHeckeChar (f : Ideal OK) (η : Ideal OK → ℂ) : Prop where
  zero_of_not_coprime : ∀ I : Ideal OK, I ⊔ f ≠ ⊤ → η I = 0
  map_top : η ⊤ = 1
  mul : ∀ I J : Ideal OK, η (I * J) = η I * η J
  ray_trivial : ∀ (I J : Ideal OK) (a b : OK), I ⊔ f = ⊤ → J ⊔ f = ⊤ →
    a ≠ 0 → b ≠ 0 → Ideal.span {a} ⊔ f = ⊤ → Ideal.span {b} ⊔ f = ⊤ → a - b ∈ f →
    Ideal.span {b} * I = Ideal.span {a} * J → η I = η J
  finite_order : ∃ n : ℕ, 0 < n ∧ ∀ I : Ideal OK, I ⊔ f = ⊤ → η I ^ n = 1

/-- `η` is principal (the trivial character mod `f`): it is `1` on every ideal coprime to `f`.
Only for principal `η` does the manuscript allow a pole at `s = 1`. -/
def IsPrincipalHecke (f : Ideal OK) (η : Ideal OK → ℂ) : Prop :=
  ∀ I : Ideal OK, I ⊔ f = ⊤ → η I = 1

/-- Reading of "ζ(s) has no zero in Re s > σ₀". Mathlib's `riemannZeta` is defined on all of
ℂ. Its only pole is at `s = 1`, which is excluded from the statement (the manuscript allows
the pole there). -/
def ReadingZeta (σ₀ : ℝ) : Prop :=
  ∀ s : ℂ, σ₀ < s.re → s ≠ 1 → riemannZeta s ≠ 0

/-- Reading of "every Dirichlet L-function has no zero in Re s > σ₀", over all characters
modulo every `N ≥ 1`, including imprimitive ones (the Sep 30 convention). The character modulo 1
is the trivial one, whose `LFunction` is `ζ`.
The pole at `s = 1` is excluded only for the principal (trivial) character `χ = 1`, where
`DirichletCharacter.LFunction` is a junk value at the pole. For nonprincipal `χ` the value at
`s = 1` is the genuine value of a holomorphic function, and the claim is made there too. -/
def ReadingDirichlet (σ₀ : ℝ) : Prop :=
  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ),
    σ₀ < s.re → (s = 1 → χ ≠ 1) → DirichletCharacter.LFunction χ s ≠ 0

/-- Same as `ReadingDirichlet`, but restricted to primitive characters, as in the Oct 5 text
(`For a primitive Dirichlet character χ of conductor q`). Primitive means
`DirichletCharacter.IsPrimitive χ`, i.e. the conductor equals the modulus. -/
def ReadingDirichletPrim (σ₀ : ℝ) : Prop :=
  ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N) (s : ℂ),
    DirichletCharacter.IsPrimitive χ → σ₀ < s.re → (s = 1 → χ ≠ 1) →
      DirichletCharacter.LFunction χ s ≠ 0

/-- Reading of "every finite-order Hecke L-function over Q(√-3) has no zero in Re s > σ₀".

Quantification: over every nonzero modulus `f`, every finite-order Hecke character `η` of
modulus `f`, and every `L : ℂ → ℂ` that
* is holomorphic on `ℂ ∖ {1}`;
* is continuous at `1` when `η` is nonprincipal, so `L` is entire there (the pole at `1` is
  allowed only for principal `η`);
* equals `∑_{𝔞 ≠ 0} η(𝔞) N𝔞^{-s}` for `Re s > 1` (`HasSum` over nonzero integral ideals, which
  asserts convergence as well as the value).
Conclusion: `L s ≠ 0` for `Re s > σ₀`, with `s = 1` included exactly when `η` is nonprincipal.

Holomorphy on `ℂ ∖ {1}` and the Dirichlet series determine `L` uniquely on `ℂ ∖ {1}`
(connected open set, identity theorem), so `L` is the manuscript's continuation. -/
def ReadingHecke (σ₀ : ℝ) : Prop :=
  ∀ (f : Ideal OK), f ≠ ⊥ → ∀ η : Ideal OK → ℂ, IsHeckeChar f η →
    ∀ L : ℂ → ℂ, DifferentiableOn ℂ L ({1}ᶜ : Set ℂ) →
      (¬ IsPrincipalHecke f η → ContinuousAt L 1) →
      (∀ s : ℂ, 1 < s.re →
        HasSum (fun I : {I : Ideal OK // I ≠ ⊥} =>
            η I.1 * ((Ideal.absNorm I.1 : ℕ) : ℂ) ^ (-s)) (L s)) →
      ∀ s : ℂ, σ₀ < s.re → (s = 1 → ¬ IsPrincipalHecke f η) → L s ≠ 0

/-- Sep 30 headline claim: Hecke (all finite-order characters), Dirichlet (all characters),
and ζ, all with σ₀ = 7/8. -/
theorem reading_sep30 : ReadingHecke (7/8) ∧ ReadingDirichlet (7/8) ∧ ReadingZeta (7/8) := sorry

/-- Oct 5 headline claim: Hecke, primitive Dirichlet characters, and ζ, with σ₀ = 11/12. -/
theorem reading_oct5 :
    ReadingHecke (11/12) ∧ ReadingDirichletPrim (11/12) ∧ ReadingZeta (11/12) := sorry

end QRHReadingC

/-!
## Ambiguity notes and choices

1. **ζ and the pole.** `riemannZeta` is total on ℂ, but its value at `s = 1` is junk. The
   statement excludes `s = 1` (the manuscripts allow the pole there), so the junk value is
   never used.

2. **Dirichlet characters, all vs primitive.** Sep 30 (`For a Dirichlet character χ modulo q`)
   means every character modulo every `q`, including imprimitive ones. This is
   `ReadingDirichlet`. Oct 5 (`For a primitive Dirichlet character χ of conductor q`) restricts
   to primitive characters. This is `ReadingDirichletPrim`. The two sets differ by imprimitive
   characters, whose `L`-functions differ from primitive ones by finitely many Euler factors
   `∏ (1 - χ*(p) p^{-s})`. Those factors vanish only on `Re s = 0`, so the difference does not
   matter for half-planes with σ₀ ≥ 0. It is still a literal difference in the claim.
   Mathlib's `DirichletCharacter.IsPrimitive` is conductor = level.
   `N` ranges over `N ≥ 1` (`[NeZero N]`); `N = 0` is excluded.

3. **Pole convention for Dirichlet.** `DirichletCharacter.LFunction` is a genuine function with
   a pole at `s = 1` only for the principal character `χ = 1` (as an element of
   `DirichletCharacter ℂ N`). The statement excludes `s = 1` only when `χ = 1`, so for
   nonprincipal `χ` the claim includes `s = 1`. Imprimitive principal characters (`χ = 1` at level
   `N > 1`) are principal and are excluded at `s = 1` too.

4. **Hecke L-functions: no Mathlib model.** Mathlib has no Hecke L-functions over number
   fields, so the continuation is not defined. We quantify over every `L` satisfying the
   properties in the brief. The function `L` is determined on `ℂ ∖ {1}` by the series (identity
   theorem, since `ℂ ∖ {1}` is connected). The value `L 1` is not determined by holomorphy alone.
   So:
   - for principal `η` the pole at `1` is allowed, and `s = 1` is excluded from the conclusion;
   - for nonprincipal `η` the manuscripts' claim includes `s = 1`, which needs `L 1` to be the
     genuine value. This reading adds `ContinuousAt L 1` for nonprincipal `η` and keeps `s = 1`
     in the conclusion. This is a refinement of the brief's `s ≠ 1` rule: the brief excludes `s = 1`
     for all `η`, and this version excludes it only where the pole is allowed.
   Entireness of nonprincipal Hecke `L`-functions is a theorem not used in the statement, so
   `ContinuousAt` is only a hypothesis on the class of `L`.

5. **Vacuity.** `ReadingHecke` is vacuous for any `η` for which no `L` satisfying the hypotheses
   exists. Existence of the continuation is a theorem, not part of the reading.

6. **Ray class group.** Mathlib has no ray class group, so I did not build the quotient. The
   character condition is stated on integral ideals (`IsHeckeChar`). Identifying `η` with a
   homomorphism from `I ↦ I J⁻¹` on coprime fractional ideals gives the quotient by
   `P_{f,1} = {(α) : α ≡ 1 mod^× f}`, using `I = (a/b) J ⇔ bI = aJ`.
   The congruence `α ≡ 1 mod^× f` is the standard `α = a/b` with `a, b` coprime to `f`, `a ≡ b mod f`
   (the representation is quantified over in `ray_trivial`). I require `a, b ≠ 0`, so that `α ≠ 0`
   (otherwise `0/0 = 0` makes every ideal relation hold when `f = 1`).
   `finite_order` is automatic for a character of a finite group, but is stated explicitly.

7. **Ideal-theoretic vs idelic Hecke characters.** The manuscript defines `η` ideal-theoretically
   and says this agrees with the idelic definition, because the complex place contributes no
   nontrivial finite-order continuous character (Milne, Ch. VI §1). I follow the ideal-theoretic
   definition only.

8. **The sum.** The sum is over nonzero integral ideals (`{I // I ≠ ⊥}`). `absNorm ⊥ = 0` is
   avoided by excluding `⊥`. `(N𝔞 : ℂ)^(-s)` is `cpow` with positive real base, so it is
   well-defined. Convergence for `Re s > 1` is part of the statement (`HasSum`), not assumed.

9. **Quantifying over moduli.** Every nonzero `f` (including `f = 1`, the trivial modulus) and
   every `η` with `IsHeckeChar f η` is allowed, so imprimitive characters are included. This
   matches "character of the ray class group modulo 𝔣, extended by zero".

10. **Field model.** `CyclotomicField 3 ℚ` as `Q(√-3)`. Its ring of integers is `𝓞` = `O_K`.

## Differences between the two manuscripts' headline claims (quoted)

- **Region.** Sep 30 abstract: "zero-free in the half-plane `\Re s>7/8`, with the principal
  pole at `s=1` allowed." Oct 5 abstract: "has no zeros in the half-plane `\Rea s>11/12`."
  Since `11/12 > 7/8`, the Oct 5 half-plane is smaller. Oct 5 claims a weaker zero-free
  region than Sep 30, although it appears later. Taken literally, Sep 30 implies Oct 5's claim.
- **Dirichlet characters.** Sep 30 theorem: "The same holds for every Dirichlet
  $L$-function, including $\zeta(s)$." Sep 30 intro: "For a Dirichlet character $\chi$ modulo
  $q$, extended by zero on nonunits" (all characters). Oct 5 intro: "For a primitive Dirichlet
  character $\chi$ of conductor $q$". Oct 5 abstract: "every Dirichlet $L$-function, including
  Riemann's zeta function". Oct 5 says "every Dirichlet L-function" in its headline but
  "primitive" in its body (Oct 5 intro: "for every primitive character $\chi$, independently of
  both conductor and height").
- **Riemann hypothesis / quasi-RH.** Sep 30: "resolves the quasi-Riemann hypothesis
  affirmatively: the supremum of the real parts of the nontrivial zeros of $\zeta$ ... is at most
  $7/8$." Oct 5: "We establish the quasi-Riemann hypothesis by proving..." with `\Rea s>11/12`.
  Sep 30 says the boundary `Re s = 7/8` is not included. Oct 5 asserts "In particular, this rules out
  the existence of Landau--Siegel zeros." Sep 30 says "any exceptional real zero in (7/8,1) is
  excluded." Both are consistent with their regions.
- **Quasi-RH definition.** Sep 30: "a fixed `\sigma_0<1`" (the uniform gap). Oct 5: "a single
  `\varepsilon>0` valid for every primitive character."
- **Hecke.** Both: every finite-order Hecke `L`-function over `\mathbb Q(\sqrt{-3})` has no
  zero in the stated half-plane. Oct 5 body: "finite-order Hecke L-function over K" (no
  primitive/imprimitive restriction stated). Sep 30 defines it with modulus `\mathfrak f` and
  extension by zero, which covers all moduli.
-/
end
end ReaderC
