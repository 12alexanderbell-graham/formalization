import Mathlib

/-! # Target O, family O10: the manuscript's explicit polynomial F and its critical point (run 2026-11-27T0628Z).
Typed from paper.tex (sha256 60993c0b…) equations (eq:xyz)–(eq:F), not from the release's Lean. Checked here:
x² + y³ = h·s (the source's divisibility claim), F(P) = −1, and every partial derivative of F at
P = (2, 0, −1/2, 1/2) vanishes (∇F(P) = 0, Theorem 1.1's second claim). Generated by a sympy script (the
cofactors G_i); Lean checks each identity by `ring` and the derivatives by `HasDerivAt`. -/

namespace TargetO.Noncoord

noncomputable section

def xx (h u v w : ℝ) : ℝ := u^3 + h*v
def yy (h u v w : ℝ) : ℝ := -u^2 + h*w
def ss (h u v w : ℝ) : ℝ := 2*u^3*v + 3*u^4*w + h*(v^2 - 3*u^2*w^2) + h^2*w^3
def pp (x y s : ℝ) : ℝ := -2*s^2*x + 3*s*y^2 - 3*s^3*y
def F (h u v w : ℝ) : ℝ := h - pp (xx h u v w) (yy h u v w) (ss h u v w) - 1

theorem xy_identity (h u v w : ℝ) : xx h u v w ^ 2 + yy h u v w ^ 3 = h * ss h u v w := by
  unfold xx yy ss; ring

theorem F_at_P : F 2 0 (-1/2) (1/2) = -1 := by
  unfold F pp xx yy ss; norm_num

theorem line_h (t : ℝ) : F (2 + t) 0 (-1/2) (1/2) = -1 + t^2 * (3*t^5/1024 + 15*t^4/256 + 61*t^3/128 + 31*t^2/16 + 251*t/64 + 49/16) := by
  unfold F pp xx yy ss; ring

theorem deriv_h : HasDerivAt (fun t : ℝ => F (2 + t) 0 (-1/2) (1/2)) 0 0 := by
  have h1 : (fun t : ℝ => F (2 + t) 0 (-1/2) (1/2)) = fun t => -1 + t^2 * (3*t^5/1024 + 15*t^4/256 + 61*t^3/128 + 31*t^2/16 + 251*t/64 + 49/16) := funext line_h
  rw [h1]
  have := ((hasDerivAt_pow 2 (0:ℝ)).mul (show HasDerivAt (fun t : ℝ => (3*t^5/1024 + 15*t^4/256 + 61*t^3/128 + 31*t^2/16 + 251*t/64 + 49/16)) _ 0 from
    (by fun_prop : Differentiable ℝ (fun t : ℝ => (3*t^5/1024 + 15*t^4/256 + 61*t^3/128 + 31*t^2/16 + 251*t/64 + 49/16))).differentiableAt.hasDerivAt)).const_add (-1)
  simpa using this

theorem line_u (t : ℝ) : F 2 (0 + t) (-1/2) (1/2) = -1 + t^2 * (-81*t^12/8 + 81*t^11/4 + 27*t^10 - 213*t^9/4 - 60*t^8 + 311*t^7/4 + 303*t^6/4 - 219*t^5/4 - 471*t^4/8 + 18*t^3 + 81*t^2/4) := by
  unfold F pp xx yy ss; ring

theorem deriv_u : HasDerivAt (fun t : ℝ => F 2 (0 + t) (-1/2) (1/2)) 0 0 := by
  have h1 : (fun t : ℝ => F 2 (0 + t) (-1/2) (1/2)) = fun t => -1 + t^2 * (-81*t^12/8 + 81*t^11/4 + 27*t^10 - 213*t^9/4 - 60*t^8 + 311*t^7/4 + 303*t^6/4 - 219*t^5/4 - 471*t^4/8 + 18*t^3 + 81*t^2/4) := funext line_u
  rw [h1]
  have := ((hasDerivAt_pow 2 (0:ℝ)).mul (show HasDerivAt (fun t : ℝ => (-81*t^12/8 + 81*t^11/4 + 27*t^10 - 213*t^9/4 - 60*t^8 + 311*t^7/4 + 303*t^6/4 - 219*t^5/4 - 471*t^4/8 + 18*t^3 + 81*t^2/4)) _ 0 from
    (by fun_prop : Differentiable ℝ (fun t : ℝ => (-81*t^12/8 + 81*t^11/4 + 27*t^10 - 213*t^9/4 - 60*t^8 + 311*t^7/4 + 303*t^6/4 - 219*t^5/4 - 471*t^4/8 + 18*t^3 + 81*t^2/4))).differentiableAt.hasDerivAt)).const_add (-1)
  simpa using this

theorem line_v (t : ℝ) : F 2 0 ((-1/2) + t) (1/2) = -1 + t^2 * (24*t^4 - 56*t^3 + 68*t^2 - 48*t + 16) := by
  unfold F pp xx yy ss; ring

theorem deriv_v : HasDerivAt (fun t : ℝ => F 2 0 ((-1/2) + t) (1/2)) 0 0 := by
  have h1 : (fun t : ℝ => F 2 0 ((-1/2) + t) (1/2)) = fun t => -1 + t^2 * (24*t^4 - 56*t^3 + 68*t^2 - 48*t + 16) := funext line_v
  rw [h1]
  have := ((hasDerivAt_pow 2 (0:ℝ)).mul (show HasDerivAt (fun t : ℝ => (24*t^4 - 56*t^3 + 68*t^2 - 48*t + 16)) _ 0 from
    (by fun_prop : Differentiable ℝ (fun t : ℝ => (24*t^4 - 56*t^3 + 68*t^2 - 48*t + 16))).differentiableAt.hasDerivAt)).const_add (-1)
  simpa using this

theorem line_w (t : ℝ) : F 2 0 (-1/2) ((1/2) + t) = -1 + t^2 * (384*t^8 + 1920*t^7 + 4320*t^6 + 5904*t^5 + 5512*t^4 + 3636*t^3 + 1668*t^2 + 503*t + 81) := by
  unfold F pp xx yy ss; ring

theorem deriv_w : HasDerivAt (fun t : ℝ => F 2 0 (-1/2) ((1/2) + t)) 0 0 := by
  have h1 : (fun t : ℝ => F 2 0 (-1/2) ((1/2) + t)) = fun t => -1 + t^2 * (384*t^8 + 1920*t^7 + 4320*t^6 + 5904*t^5 + 5512*t^4 + 3636*t^3 + 1668*t^2 + 503*t + 81) := funext line_w
  rw [h1]
  have := ((hasDerivAt_pow 2 (0:ℝ)).mul (show HasDerivAt (fun t : ℝ => (384*t^8 + 1920*t^7 + 4320*t^6 + 5904*t^5 + 5512*t^4 + 3636*t^3 + 1668*t^2 + 503*t + 81)) _ 0 from
    (by fun_prop : Differentiable ℝ (fun t : ℝ => (384*t^8 + 1920*t^7 + 4320*t^6 + 5904*t^5 + 5512*t^4 + 3636*t^3 + 1668*t^2 + 503*t + 81))).differentiableAt.hasDerivAt)).const_add (-1)
  simpa using this

end

end TargetO.Noncoord

