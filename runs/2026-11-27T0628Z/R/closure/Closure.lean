/-! ## GRH, primitive characters in the open strip -/

theorem B_GRH : ReaderB.ReadingGRH ↔ Frozen.PrimitiveDirichletLZerosOnLine := Iff.rfl

theorem frozen_C_GRH : Frozen.DirichletLZerosOnLine → ReaderC.ReadingGRH :=
  fun h N _ χ _ s hz a b => h N χ s a b hz

/-- The Euler factor relating an imprimitive character to its primitive one does not vanish for
`0 < re s`. -/
theorem euler_factor_ne_zero {M : ℕ} (χ : DirichletCharacter ℂ M) (N : ℕ) {s : ℂ}
    (hs : 0 < s.re) : ∏ p ∈ N.primeFactors, (1 - χ p * (p : ℂ) ^ (-s)) ≠ 0 := by
  rw [Finset.prod_ne_zero_iff]
  intro p hp
  have hpp := Nat.prime_of_mem_primeFactors hp
  have hp1 : (1 : ℝ) < p := by exact_mod_cast hpp.one_lt
  intro h0
  have h1 : χ p * (p : ℂ) ^ (-s) = 1 := by linear_combination -h0
  have hn := congrArg norm h1
  rw [norm_mul, norm_one] at hn
  have hχ : ‖χ (p : ZMod M)‖ ≤ 1 := DirichletCharacter.norm_le_one χ _
  have hpow : ‖(p : ℂ) ^ (-s)‖ < 1 := by
    rw [Complex.norm_natCast_cpow_of_pos hpp.pos]
    simp only [Complex.neg_re]
    exact Real.rpow_lt_one_of_one_lt_of_neg hp1 (by linarith)
  have h2 : ‖χ (p : ZMod M)‖ * ‖(p : ℂ) ^ (-s)‖ < 1 := by
    calc ‖χ (p : ZMod M)‖ * ‖(p : ℂ) ^ (-s)‖ ≤ 1 * ‖(p : ℂ) ^ (-s)‖ := by gcongr
      _ < 1 := by simpa using hpow
  have h3 : ‖χ (p : ZMod M)‖ * ‖(p : ℂ) ^ (-s)‖ = 1 := by simpa using hn
  linarith

/-- Primitive-only and all-character strip forms are equivalent. -/
theorem prim_iff_all :
    Frozen.PrimitiveDirichletLZerosOnLine ↔ Frozen.DirichletLZerosOnLine := by
  constructor
  · intro h N _ χ s h0 h1 hz
    have hc : NeZero χ.conductor := ⟨χ.conductor_ne_zero⟩
    have hs1 : s ≠ 1 := by rintro rfl; simp at h1
    have key := DirichletCharacter.LFunction_changeLevel χ.conductor_dvd_level
      χ.primitiveCharacter (s := s) (Or.inr hs1)
    rw [DirichletCharacter.changeLevel_primitiveCharacter] at key
    rw [key] at hz
    rcases mul_eq_zero.mp hz with hz | hz
    · exact h χ.conductor χ.primitiveCharacter χ.primitiveCharacter_isPrimitive s h0 h1 hz
    · exact absurd hz (euler_factor_ne_zero _ N h0)
  · intro h N _ χ _ s h0 h1 hz
    exact h N χ s h0 h1 hz

theorem B_GRH_all : ReaderB.ReadingGRH ↔ Frozen.DirichletLZerosOnLine := prim_iff_all


/-- For a primitive character, every zero of `LFunction χ` other than the trivial zeros (by
parity) and the point 1 lies in the open critical strip (functional equation of `χ⁻¹`). -/
theorem dirichlet_zero_in_strip {N : ℕ} [NeZero N] {χ : DirichletCharacter ℂ N}
    (hχ : χ.IsPrimitive) {s : ℂ} (hz : DirichletCharacter.LFunction χ s = 0)
    (hnt : ¬ ((χ (-1) = 1 ∧ ∃ n : ℕ, s = -(2 * (n : ℂ))) ∨
           (χ (-1) = -1 ∧ ∃ n : ℕ, s = -(2 * (n : ℂ) + 1))))
    (h1 : s ≠ 1) : 0 < s.re ∧ s.re < 1 := by
  have hlt : s.re < 1 := by
    by_contra h
    exact DirichletCharacter.LFunction_ne_zero_of_one_le_re χ (Or.inr h1) (not_lt.mp h) hz
  refine ⟨?_, hlt⟩
  by_contra hle
  push Not at hle
  -- the gamma factor at s is not zero (s is not a trivial zero)
  have hΓ : DirichletCharacter.gammaFactor χ s ≠ 0 := by
    rcases χ.even_or_odd with he | ho
    · rw [he.gammaFactor_def, Ne, Gammaℝ_eq_zero_iff]
      rintro ⟨n, hn⟩; exact hnt (Or.inl ⟨he, n, hn⟩)
    · rw [ho.gammaFactor_def, Ne, Gammaℝ_eq_zero_iff]
      rintro ⟨n, hn⟩; exact hnt (Or.inr ⟨ho, n, by linear_combination hn⟩)
  have hN : s ≠ 0 ∨ N ≠ 1 := by
    by_contra hc; push Not at hc
    obtain ⟨rfl, rfl⟩ := hc
    apply hnt; left
    refine ⟨?_, 0, by simp⟩
    have : (-1 : ZMod 1) = 1 := Subsingleton.elim _ _
    rw [this, map_one]
  have hΛ : DirichletCharacter.completedLFunction χ s = 0 := by
    rw [DirichletCharacter.LFunction_eq_completed_div_gammaFactor χ s hN, div_eq_zero_iff] at hz
    exact hz.resolve_right hΓ
  have hχi : (χ⁻¹).IsPrimitive := by
    unfold DirichletCharacter.IsPrimitive at *; rw [DirichletCharacter.conductor_inv]; exact hχ
  have hfe := hχi.completedLFunction_one_sub s
  rw [inv_inv, hΛ, mul_zero] at hfe
  set w := 1 - s with hw
  have hwre : 1 ≤ w.re := by simp [hw]; linarith
  have hΓw : DirichletCharacter.gammaFactor χ⁻¹ w ≠ 0 := by
    rcases (χ⁻¹).even_or_odd with he | ho
    · rw [he.gammaFactor_def]; exact Gammaℝ_ne_zero_of_re_pos (by linarith)
    · rw [ho.gammaFactor_def]; exact Gammaℝ_ne_zero_of_re_pos (by simp; linarith)
  have hw0 : w ≠ 0 := by intro h; rw [h] at hwre; simp at hwre; linarith
  have hLw : DirichletCharacter.LFunction χ⁻¹ w = 0 := by
    rw [DirichletCharacter.LFunction_eq_completed_div_gammaFactor χ⁻¹ w (Or.inl hw0), hfe, zero_div]
  have hcond : χ⁻¹ ≠ 1 ∨ w ≠ 1 := by
    by_cases hs0 : s = 0
    · left; intro hi
      have : χ = 1 := inv_eq_one.mp hi
      apply hnt; left
      exact ⟨by rw [this]; exact MulChar.one_apply isUnit_one.neg, 0, by simp [hs0]⟩
    · right; intro h; apply hs0; linear_combination -h
  exact DirichletCharacter.LFunction_ne_zero_of_one_le_re χ⁻¹ hcond hwre hLw

theorem frozen_A_GRH' : Frozen.DirichletLZerosOnLine → ReaderA.ReadingGRH' := by
  intro h N _ χ hχ s hz hnt h1
  obtain ⟨a, b⟩ := dirichlet_zero_in_strip hχ hz hnt h1
  exact h N χ s a b hz

theorem A_GRH'_iff : ReaderA.ReadingGRH' ↔ Frozen.DirichletLZerosOnLine := by
  refine ⟨fun h => prim_iff_all.mp ?_, frozen_A_GRH'⟩
  intro N _ χ hχ s h0 h1 hz
  refine h N χ hχ s hz ?_ ?_
  · rintro (⟨-, n, rfl⟩ | ⟨-, n, rfl⟩) <;> simp at h0 <;>
      linarith [(Nat.cast_nonneg n : (0:ℝ) ≤ n)]
  · rintro rfl; simp at h1

/-! ## The half-plane headline is equivalent to the strip form (given Mathlib's `re s ≥ 1`
nonvanishing), in the direction frozen ⇒ strip; the other direction is the edition's own proof
(`zeros_on_line`), not needed for fidelity. -/

theorem nonvanishing_of_strip (h : Frozen.DirichletLZerosOnLine) :
    Frozen.DirichletLNonvanishingRightOfHalf := by
  intro N _ χ s hre hχs hz
  by_cases h1 : 1 ≤ s.re
  · exact DirichletCharacter.LFunction_ne_zero_of_one_le_re χ hχs h1 hz
  · have := h N χ s (by linarith) (lt_of_not_ge h1) hz
    linarith

