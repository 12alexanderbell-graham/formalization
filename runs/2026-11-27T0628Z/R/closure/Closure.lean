/-! ## Zeros of ζ: classification needed for the strip readings -/


/-- Every zero of `riemannZeta` that is not a trivial zero and not the point 1 lies in the open
critical strip. -/
theorem zeta_zero_in_strip {s : ℂ} (hz : riemannZeta s = 0)
    (htriv : ¬∃ n : ℕ, s = -2 * ((n : ℂ) + 1)) (h1 : s ≠ 1) : 0 < s.re ∧ s.re < 1 := by
  have hlt : s.re < 1 := by
    by_contra h
    exact riemannZeta_ne_zero_of_one_le_re (not_lt.mp h) hz
  refine ⟨?_, hlt⟩
  by_contra hle
  push Not at hle
  have hs0 : s ≠ 0 := by
    rintro rfl; rw [riemannZeta_zero] at hz; norm_num at hz
  obtain ⟨w, rfl⟩ : ∃ w : ℂ, s = 1 - w := ⟨1 - s, by ring⟩
  have hwre : 1 ≤ w.re := by simp at hle; linarith
  have hwn : ∀ n : ℕ, w ≠ -n := by
    intro n hn
    have h2 := congrArg Complex.re hn
    simp at h2
    have : (0:ℝ) ≤ n := Nat.cast_nonneg n
    linarith
  have hw1 : w ≠ 1 := by
    rintro rfl; exact hs0 (by ring)
  have hfe := riemannZeta_one_sub hwn hw1
  rw [hz] at hfe
  have hzw : riemannZeta w ≠ 0 := riemannZeta_ne_zero_of_one_le_re hwre
  have hG : Gamma w ≠ 0 := Complex.Gamma_ne_zero hwn
  have hpi : (Real.pi : ℂ) ≠ 0 := by exact_mod_cast Real.pi_ne_zero
  have hpow : (2 * (Real.pi : ℂ)) ^ (-w) ≠ 0 := by
    rw [Ne, Complex.cpow_eq_zero_iff]
    rintro ⟨h, -⟩
    exact mul_ne_zero two_ne_zero hpi h
  have hcos : Complex.cos (Real.pi * w / 2) = 0 := by
    have h3 : (2 * (2 * (Real.pi : ℂ)) ^ (-w) * Gamma w) * Complex.cos (Real.pi * w / 2)
        * riemannZeta w = 0 := hfe.symm
    have h4 : (2 * (2 * (Real.pi : ℂ)) ^ (-w) * Gamma w) ≠ 0 :=
      mul_ne_zero (mul_ne_zero two_ne_zero hpow) hG
    rcases mul_eq_zero.mp h3 with h5 | h5
    · rcases mul_eq_zero.mp h5 with h6 | h6
      · exact absurd h6 h4
      · exact h6
    · exact absurd h5 hzw
  obtain ⟨k, hk⟩ := Complex.cos_eq_zero_iff.mp hcos
  have hwk : w = 2 * k + 1 := by
    have h7 : (Real.pi : ℂ) * (w - (2 * k + 1)) = 0 := by linear_combination 2 * hk
    rcases mul_eq_zero.mp h7 with h8 | h8
    · exact absurd h8 hpi
    · linear_combination h8
  have hkre : (1:ℝ) ≤ 2 * k + 1 := by
    have h2 := congrArg Complex.re hwk; simp at h2; linarith
  have hk0 : 0 ≤ k := by
    have : (0:ℝ) ≤ k := by linarith
    exact_mod_cast this
  have hk1 : k ≠ 0 := by
    rintro rfl; apply hs0; rw [hwk]; simp
  apply htriv
  refine ⟨(k - 1).toNat, ?_⟩
  have hkn : ((k - 1).toNat : ℤ) = k - 1 := Int.toNat_of_nonneg (by omega)
  have hc : (((k - 1).toNat : ℕ) : ℂ) = ((k : ℂ) - 1) := by
    have h9 := congrArg (fun z : ℤ => (z : ℂ)) hkn
    push_cast at h9
    exact h9
  rw [hc, hwk]; ring

/-- Mathlib's junk value of ζ at its pole, `(γ - log (4π)) / 2`, is not zero: the frozen
hypothesis `s ≠ 1` is redundant. -/
theorem zeta_one_ne_zero : riemannZeta 1 ≠ 0 := by
  rw [riemannZeta_one]
  intro h0
  have h1 := congrArg Complex.re h0
  have hn : ‖(4 * (Real.pi : ℂ))‖ = 4 * Real.pi := by
    rw [norm_mul]; simp [abs_of_pos Real.pi_pos]
  simp only [Complex.div_re, Complex.sub_re, Complex.ofReal_re, Complex.log_re] at h1
  rw [hn] at h1
  have hγ := Real.eulerMascheroniConstant_lt_two_thirds
  have h4 : 2 / 3 < Real.log (4 * Real.pi) := by
    rw [Real.lt_log_iff_exp_lt (by positivity)]
    have := Real.exp_one_lt_d9
    have hp := Real.pi_gt_three
    have : Real.exp (2/3) < Real.exp 1 := Real.exp_lt_exp.mpr (by norm_num)
    linarith
  norm_num at h1
  linarith

/-- The strip form of RH (readers A (second form), B, C) is equivalent to Mathlib's statement. -/
theorem strip_iff_RH :
    (∀ s : ℂ, 0 < s.re → s.re < 1 → riemannZeta s = 0 → s.re = 1 / 2) ↔ RiemannHypothesis := by
  constructor
  · intro h s hz htriv h1
    obtain ⟨h0, h1'⟩ := zeta_zero_in_strip hz htriv h1
    exact h s h0 h1' hz
  · intro h s h0 h1 hz
    refine h s hz ?_ ?_
    · rintro ⟨n, rfl⟩
      simp at h0
      have : (0:ℝ) ≤ n := Nat.cast_nonneg n
      linarith
    · rintro rfl; simp at h1

/-! ## RH: every reading closed both ways -/

theorem A_RH : ReaderA.ReadingRH ↔ Frozen.RiemannZetaZerosOnLine := by
  unfold ReaderA.ReadingRH Frozen.RiemannZetaZerosOnLine
  simp only [not_exists]

theorem A_RH_strip : ReaderA.ReadingRH_strip ↔ Frozen.RiemannZetaZerosOnLine :=
  strip_iff_RH

theorem B_RH : ReaderB.ReadingRH ↔ Frozen.RiemannZetaZerosOnLine := strip_iff_RH

theorem C_RH : ReaderC.ReadingRH ↔ Frozen.RiemannZetaZerosOnLine := by
  unfold ReaderC.ReadingRH
  exact Iff.trans ⟨fun h s a b c => h s c a b, fun h s c a b => h s a b c⟩ strip_iff_RH

/-! ## GRH, all characters in the open strip: closed both ways -/

theorem A_GRH : ReaderA.ReadingGRH ↔ Frozen.DirichletLZerosOnLine := Iff.rfl

