theorem chainC {Y : ℝ → ℝ × ℝ × ℝ}
    (hY : ∀ t ∈ Icc (0 : ℝ) (15 / 4 : ℝ), HasDerivWithinAt Y (vN t (Y t)) (Icc 0 (15 / 4 : ℝ)) t)
