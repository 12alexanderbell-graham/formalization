  have hX : (((15/4 : ℚ) : ℚ) : ℝ) = (15 / 4 : ℝ) := by norm_num
  have hs : SolC (((15/4 : ℚ) : ℚ) : ℝ) 0 (fun t => (Y t).1) (fun t => (Y t).2.1) (fun t => (Y t).2.2) := by
    rw [hX]
    exact ⟨fun t ht => (hY t ht).fst, fun t ht => (hY t ht).snd.fst, fun t ht => (hY t ht).snd.snd⟩
  have z0 : ((c0.t0 : ℚ) : ℝ) = 0 := by simp [c0]
