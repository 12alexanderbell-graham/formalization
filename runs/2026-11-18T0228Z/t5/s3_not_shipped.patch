 """
@@ -38,6 +48,34 @@ NARROW = re.compile(r"(?i)^(?:unique\w*|exactly|only|sole\w*|none|nothing|settle
                     r"universal\w*|precise\w*|non-(?!vacuity|vacuous|increasing|decreasing|negative|positive|zero|empty)\w+|arbitrar\w*|generic\w*|independen\w*)$")
 
 
+WITHDRAW = re.compile(r"(?i)\b(?:withdraw\w*|retract\w*|supersed\w*|obsolete|revok\w*|rescind\w*|"
+                      r"no\s+longer\s+(?:PROVED|proved|valid|holds?|stands?)|not\s+(?:PROVED|proved)\b|"
+                      r"(?:must|should|do|does|can)\s*(?:not|n't)\s+(?:be\s+)?(?:cite|cited|relied|rely|used)\b|"
+                      r"cannot\s+(?:be\s+)?(?:cite|cited|relied|rely)\b)")
+
+
+def s3_errors(name, text, heads):
+    """S3: lines naming a registered headline that withdraw it in words"""
+    out = []
+    for i, line in enumerate(text.splitlines(), 1):
+        spans = []
+        flat = re.sub(r"`[^`]*`", lambda m: spans.append(m.group(0)) or f" \x00{len(spans) - 1}\x00 ", line)
+        # clause by clause (sentence end, `;`, brackets, the end of a bold label): a withdrawal word must share its
+        # clause with the headline name ("if that CI run was superseded) … `h` PROVED" is two clauses)
+        for clause in re.split(r"\.\s|;|\(|\)|\*\*", flat):
+            cited = [spans[int(k)].strip("`") for k in re.findall(r"\x00(\d+)\x00", clause)]
+            hit = sorted({c for c in cited for h in heads
+                          if len(c) > 3 and (c == h or c.endswith("." + h) or h.endswith("." + c.split("Checked.", 1)[-1])
+                                             or h == c.split("Checked.", 1)[-1])})
+            w = WITHDRAW.search(re.sub(r"\x00\d+\x00", " ", clause)) if hit else None
+            if w:
+                out.append(f"S3: {name}:{i}: says '{w.group(0)}' in a clause naming the registered headline {hit[0]}: a "
+                           f"registered headline is withdrawn only by removing it from Checked and "
+                           f"scripts/trust/headlines.txt (then CLAIMS.md drops it), never in prose")
+                break
+    return out
+
