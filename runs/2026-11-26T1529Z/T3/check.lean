def ent (D : List (List GI)) (a r : ℕ) : GI := (D.getD a []).getD r (0, 0)

/-- Σ_r U[a][r]·V[b][r]·W[c][r] in ℤ[i]. -/
def tsum3 (a b c : ℕ) : GI :=
  ((List.range 48).map fun r => gmul (gmul (ent Ud a r) (ent Vd b r)) (ent Wd c r)).sum

/-- 8 × the matrix multiplication tensor ⟨4,4,4⟩ in the notebook's convention
T[i*4+j][j*4+k][k*4+i] = 1. -/
def target (a b c : ℕ) : GI :=
  if a / 4 = c % 4 ∧ a % 4 = b / 4 ∧ b % 4 = c / 4 then (8, 0) else (0, 0)

/-- The check for one row `a` of the first factor. -/
def checkRow (a : ℕ) : Bool :=
  (List.range 16).all fun b => (List.range 16).all fun c => decide (tsum3 a b c = target a b c)

theorem shapes : Ud.length = 16 ∧ Vd.length = 16 ∧ Wd.length = 16 ∧
    (Ud.all fun row => row.length = 48) ∧ (Vd.all fun row => row.length = 48) ∧
    (Wd.all fun row => row.length = 48) := by decide +kernel

theorem row0 : checkRow 0 = true := by decide +kernel
theorem row1 : checkRow 1 = true := by decide +kernel
theorem row2 : checkRow 2 = true := by decide +kernel
