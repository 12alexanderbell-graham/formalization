theorem glue {P : ℝ → Prop} {a b : ℝ} (h1 : ∀ t ∈ Icc 0 a, P t) (h2 : ∀ t ∈ Icc a b, P t) :
    ∀ t ∈ Icc 0 b, P t := by
  intro t ht
  rcases le_total t a with h | h
  · exact h1 t ⟨ht.1, h⟩
  · exact h2 t ⟨h, ht.2⟩

/-- Every solution Y of Y' = vH t Y (the clamped Hiemenz field) on [0, 2] (derivatives within the
interval) with Y(0) = (0.5, 0, 1.6): overshoot: p > 1 at the end and q > 0 throughout. -/
theorem chainC {Y : ℝ → ℝ × ℝ × ℝ}
    (hY : ∀ t ∈ Icc (0 : ℝ) (2 / 1 : ℝ), HasDerivWithinAt Y (vH t (Y t)) (Icc 0 (2 / 1 : ℝ)) t)
    (h0 : Y 0 = (0.5, 0, 1.6)) : Over Y := by
  have hX : (((2 : ℚ) : ℚ) : ℝ) = (2 / 1 : ℝ) := by norm_num
  have hs : SolC (((2 : ℚ) : ℚ) : ℝ) 0 (fun t => (Y t).1) (fun t => (Y t).2.1) (fun t => (Y t).2.2) := by
    rw [hX]
    exact ⟨fun t ht => (hY t ht).fst, fun t ht => (hY t ht).snd.fst, fun t ht => (hY t ht).snd.snd⟩
  have z0 : ((c0.t0 : ℚ) : ℝ) = 0 := by simp [c0]
  have b0 : InBox c0 (fun t => (Y t).1) (fun t => (Y t).2.1) (fun t => (Y t).2.2) := by
    unfold InBox; simp only [z0, h0]
    simp only [V, c0, List.headD_cons]; push_cast; norm_num

  obtain ⟨b1, P0⟩ := segS_q0 (Φ := (fun _ _ q t => 0 < q t)) (fun c hok hsd => sideO_spec c hok hsd) c8 [c1, c2, c3, c4, c5, c6, c7] c0 seg0_ok hs b0
  rw [z0] at P0
  obtain ⟨E, P1⟩ := endSO_q0 (Φ := (fun _ _ q t => 0 < q t)) (fun c hok hsd => sideO_spec c hok hsd) [c9, c10, c11, c12, c13, c14, c15] c8 seg1_ok hs b1
  have A1 := glue P0 P1
  rw [hX] at E A1
  exact ⟨(2 / 1 : ℝ), by norm_num, E, A1⟩

