/-- The coefficient-K problem in Falkner–Skan form, β = 1/K, by the scaling with c = √K. -/
theorem to_fs {K : ℝ} (hK : 0 < K) {g u v : ℝ → ℝ}
    (hg : ∀ η ∈ Ici (0 : ℝ), HasDerivWithinAt g (u η) (Ici 0) η)
    (hu : ∀ η ∈ Ici (0 : ℝ), HasDerivWithinAt u (v η) (Ici 0) η)
    (hv : ∀ η ∈ Ici (0 : ℝ), HasDerivWithinAt v (-(K * g η * v η) - 1 + u η ^ 2) (Ici 0) η) :
    (∀ s ∈ Ici (0 : ℝ), HasDerivWithinAt (fun s => Real.sqrt K * g (s / Real.sqrt K)) (u (s / Real.sqrt K)) (Ici 0) s) ∧
    (∀ s ∈ Ici (0 : ℝ), HasDerivWithinAt (fun s => u (s / Real.sqrt K))
      (v (s / Real.sqrt K) / Real.sqrt K) (Ici 0) s) ∧
    (∀ s ∈ Ici (0 : ℝ), HasDerivWithinAt (fun s => v (s / Real.sqrt K) / Real.sqrt K)
      (-((Real.sqrt K * g (s / Real.sqrt K)) * (v (s / Real.sqrt K) / Real.sqrt K)) -
        1 / K * (1 - u (s / Real.sqrt K) ^ 2)) (Ici 0) s) := by
  have hc : 0 < Real.sqrt K := Real.sqrt_pos.2 hK
  have h2 : Real.sqrt K ^ 2 = K := Real.sq_sqrt hK.le
  have hv' : ∀ η ∈ Ici (0 : ℝ), HasDerivWithinAt v (-(K * g η * v η) - 1 * (1 - u η ^ 2)) (Ici 0) η :=
    fun η hη => (hv η hη).congr_deriv (by ring)
  obtain ⟨A, B, C⟩ := Checked.FalknerSkan.FSScale.scale hc hg hu hv'
  refine ⟨A, B, fun s hs => (C s hs).congr_deriv ?_⟩
  rw [h2]; field_simp

