namespace Checked.Hiemenz.HIVP
open Set Checked.Hiemenz.HExBase Checked.Hiemenz.HExFlow Checked.Hiemenz.HCellWC

/-- Inside the clamps the clamped field is the Hiemenz field: the flow solves the Hiemenz system. -/
theorem solves {α : ℝ}
    (hb : ∀ t ∈ Icc (0 : ℝ) (15 / 2),
      BoxΦ (fun t => (flow α t).1) (fun t => (flow α t).2.1) (fun t => (flow α t).2.2) t) :
    ∃ f p q : ℝ → ℝ,
    (∀ η ∈ Icc (0 : ℝ) (15 / 2), HasDerivWithinAt f (p η) (Icc 0 (15 / 2)) η) ∧
    (∀ η ∈ Icc (0 : ℝ) (15 / 2), HasDerivWithinAt p (q η) (Icc 0 (15 / 2)) η) ∧
    (∀ η ∈ Icc (0 : ℝ) (15 / 2), HasDerivWithinAt q (-(f η * q η) - 1 + p η ^ 2) (Icc 0 (15 / 2)) η) ∧
    f 0 = 0 ∧ p 0 = 0 ∧ q 0 = α := by
  have hY := Checked.Hiemenz.HExAssemble.deriv_Icc α
  refine ⟨fun t => (flow α t).1, fun t => (flow α t).2.1, fun t => (flow α t).2.2, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro t ht
    obtain ⟨-, b2, -⟩ := hb t ht
    have d : HasDerivWithinAt (fun x => (flow α x).1) (vH t (flow α t)).1 (Icc 0 (15 / 2)) t :=
      (hY t ht).fst
    exact d.congr_deriv (by simp only [vH]; exact cl_of_abs_le b2)
  · intro t ht
    obtain ⟨-, -, b3⟩ := hb t ht
    have d : HasDerivWithinAt (fun x => (flow α x).2.1) (vH t (flow α t)).2.1 (Icc 0 (15 / 2)) t :=
      (hY t ht).snd.fst
    exact d.congr_deriv (by simp only [vH]; exact cl_of_abs_le b3)
  · intro t ht
    obtain ⟨b1, b2, b3⟩ := hb t ht
    have d : HasDerivWithinAt (fun x => (flow α x).2.2) (vH t (flow α t)).2.2 (Icc 0 (15 / 2)) t :=
      (hY t ht).snd.snd
    exact d.congr_deriv
      (by simp only [vH]; rw [cl_of_abs_le b1, cl_of_abs_le b2, cl_of_abs_le b3])
  · simp [flow_zero]
  · simp [flow_zero]
  · simp [flow_zero]

/-- A solution of the Hiemenz initial-value problem on [0, 15/2] with q(0) = 1.2325876568. -/
theorem ivp_lo : ∃ f p q : ℝ → ℝ,
    (∀ η ∈ Icc (0 : ℝ) (15 / 2), HasDerivWithinAt f (p η) (Icc 0 (15 / 2)) η) ∧
    (∀ η ∈ Icc (0 : ℝ) (15 / 2), HasDerivWithinAt p (q η) (Icc 0 (15 / 2)) η) ∧
    (∀ η ∈ Icc (0 : ℝ) (15 / 2), HasDerivWithinAt q (-(f η * q η) - 1 + p η ^ 2) (Icc 0 (15 / 2)) η) ∧
    f 0 = 0 ∧ p 0 = 0 ∧ q 0 = 1.2325876568 :=
  solves (Checked.Hiemenz.HUDataC.boxC (Checked.Hiemenz.HExAssemble.deriv_Icc _) (flow_zero _))

/-- A solution of the Hiemenz initial-value problem on [0, 15/2] with q(0) = 1.2325876569. -/
theorem ivp_hi : ∃ f p q : ℝ → ℝ,
    (∀ η ∈ Icc (0 : ℝ) (15 / 2), HasDerivWithinAt f (p η) (Icc 0 (15 / 2)) η) ∧
    (∀ η ∈ Icc (0 : ℝ) (15 / 2), HasDerivWithinAt p (q η) (Icc 0 (15 / 2)) η) ∧
    (∀ η ∈ Icc (0 : ℝ) (15 / 2), HasDerivWithinAt q (-(f η * q η) - 1 + p η ^ 2) (Icc 0 (15 / 2)) η) ∧
    f 0 = 0 ∧ p 0 = 0 ∧ q 0 = 1.2325876569 :=
  solves (Checked.Hiemenz.HODataC.boxC (Checked.Hiemenz.HExAssemble.deriv_Icc _) (flow_zero _))

end Checked.Hiemenz.HIVP
