import Checked.Hiemenz.HExAssemble
/-! Hiemenz stagnation-point flow, `HIVP`: along the certified cells of the clamped flow every clamp is inactive, so at both certified shooting values the clamped flow solves the Hiemenz initial-value problem on the certified window (helper for the non-vacuity witnesses of `hiemenz_under` and `hiemenz_over`; generated by `runs/2026-11-07T2228Z/scripts/emit_hivp.py`). -/

namespace Checked.Hiemenz.HCellWC
open Set Checked.Sim Checked.Sim.QPoly Checked.Hiemenz.HExBase

/-- The box of the clamps: the components stay where the clamped field is the Hiemenz field. -/
def BoxΦ (g p q : ℝ → ℝ) (t : ℝ) : Prop := |g t| ≤ max t 0 + 2 ∧ |p t| ≤ 2 ∧ |q t| ≤ 2

/-- On every checked cell the enclosed solution stays inside the clamps (the six box conditions of
`CellProp`). -/
theorem box_spec {T : ℚ} (c : Cell) (hok : cellOK T c = true) {g p q : ℝ → ℝ}
    (hs : SolC T c.t0 g p q) (h0 : InBox c g p q) :
    ∀ t ∈ Icc (c.t0 : ℝ) (c.t0 + c.h), BoxΦ g p q t := by
  obtain ⟨k1, -, -, kw1, kw2, -, -, -, -, -, kr1, kBr, kr2, kBr2, -, -, -, -, -, kx1, kx2, kx3, kx4, kx5, kx6⟩ :
    CellProp T c := of_decide_eq_true hok
  have ht0 : (0 : ℝ) ≤ c.t0 := by exact_mod_cast k1
  have hw1 : (0 : ℝ) < c.w1 := by exact_mod_cast kw1
  have hw2 : (0 : ℝ) < c.w2 := by exact_mod_cast kw2
  have hr1 : (0 : ℝ) ≤ c.r1 := by exact_mod_cast kr1
  have hBr : (c.B : ℝ) ^ 2 ≤ c.w1 * (c.r1 : ℝ) ^ 2 := by exact_mod_cast kBr
  have hr2 : (0 : ℝ) ≤ c.r2 := by exact_mod_cast kr2
  have hBr2 : (c.B : ℝ) ^ 2 ≤ c.w2 * (c.r2 : ℝ) ^ 2 := by exact_mod_cast kBr2
  have hB0 : (0 : ℝ) ≤ c.B := (cell_pos c hok).2.2.1.le
  have x1 : ((-(c.t0 + 2) : ℚ) : ℝ) < ((glo c - c.r1 : ℚ) : ℝ) := by exact_mod_cast kx1
  have x2 : ((ghi c + c.r1 : ℚ) : ℝ) < ((c.t0 + 2 : ℚ) : ℝ) := by exact_mod_cast kx2
  have x3 : ((-2 : ℚ) : ℝ) < ((plo c - c.r2 : ℚ) : ℝ) := by exact_mod_cast kx3
  have x4 : ((phi c + c.r2 : ℚ) : ℝ) < ((2 : ℚ) : ℝ) := by exact_mod_cast kx4
  have x5 : ((-2 : ℚ) : ℝ) < ((qlo c - c.B : ℚ) : ℝ) := by exact_mod_cast kx5
  have x6 : ((qhi c + c.B : ℚ) : ℝ) < ((2 : ℚ) : ℝ) := by exact_mod_cast kx6
  push_cast at x1 x2 x3 x4 x5 x6
  intro t ht
  have e := cell_all c hok hs h0 t ht
  unfold V at e
  have n1 := mul_nonneg hw1.le (sq_nonneg (g t - evalQ c.pg (t - c.t0)))
  have n2 := mul_nonneg hw2.le (sq_nonneg (p t - evalQ c.pp (t - c.t0)))
  have n3 := sq_nonneg (q t - evalQ c.pq (t - c.t0))
  have e1 : |g t - evalQ c.pg (t - c.t0)| ≤ c.r1 := comp_le hw1 hr1 (by linarith) hBr
  have e2 : |p t - evalQ c.pp (t - c.t0)| ≤ c.r2 := comp_le hw2 hr2 (by linarith) hBr2
  have e3 : |q t - evalQ c.pq (t - c.t0)| ≤ c.B :=
    comp_le (w := 1) (B := (c.B : ℝ)) one_pos hB0 (by linarith) (by linarith)
  have hσ : t - c.t0 ∈ Icc (0 : ℝ) c.h := ⟨by linarith [ht.1], by linarith [ht.2]⟩
  have gl := lower_q c.pg (h := c.h) hσ.1 hσ.2
  have gu := upper_q c.pg (h := c.h) hσ.1 hσ.2
  have pl := lower_q c.pp (h := c.h) hσ.1 hσ.2
  have pu := upper_q c.pp (h := c.h) hσ.1 hσ.2
  have ql := lower_q c.pq (h := c.h) hσ.1 hσ.2
  have qu := upper_q c.pq (h := c.h) hσ.1 hσ.2
  have hglo : ((glo c : ℚ) : ℝ) = ((c.pg.headD 0 - c.h * qabs c.pg.tail c.h : ℚ) : ℝ) := rfl
  have hghi : ((ghi c : ℚ) : ℝ) = ((c.pg.headD 0 + c.h * qabs c.pg.tail c.h : ℚ) : ℝ) := rfl
  have hplo : ((plo c : ℚ) : ℝ) = ((c.pp.headD 0 - c.h * qabs c.pp.tail c.h : ℚ) : ℝ) := rfl
  have hphi : ((phi c : ℚ) : ℝ) = ((c.pp.headD 0 + c.h * qabs c.pp.tail c.h : ℚ) : ℝ) := rfl
  have hqlo : ((qlo c : ℚ) : ℝ) = ((c.pq.headD 0 - c.h * qabs c.pq.tail c.h : ℚ) : ℝ) := rfl
  have hqhi : ((qhi c : ℚ) : ℝ) = ((c.pq.headD 0 + c.h * qabs c.pq.tail c.h : ℚ) : ℝ) := rfl
  rw [← hglo] at gl
  rw [← hghi] at gu
  rw [← hplo] at pl
  rw [← hphi] at pu
  rw [← hqlo] at ql
  rw [← hqhi] at qu
  have hm : (c.t0 : ℝ) ≤ max t 0 := le_max_of_le_left ht.1
  have a1 := abs_le.1 e1
  have a2 := abs_le.1 e2
  have a3 := abs_le.1 e3
  refine ⟨abs_le.2 ⟨by linarith, by linarith⟩, abs_le.2 ⟨by linarith, by linarith⟩,
    abs_le.2 ⟨by linarith, by linarith⟩⟩

end Checked.Hiemenz.HCellWC

namespace Checked.Hiemenz.HUDataC
open Set Checked.Sim Checked.Hiemenz.HCellWC Checked.Hiemenz.HExBase

/-- The clamped flow started at the lower certified value stays inside the clamps on [0, 15/2]. -/
theorem boxC {Y : ℝ → ℝ × ℝ × ℝ}
    (hY : ∀ t ∈ Icc (0 : ℝ) (15 / 2 : ℝ), HasDerivWithinAt Y (vH t (Y t)) (Icc 0 (15 / 2 : ℝ)) t)
    (h0 : Y 0 = (0, 0, 1.2325876568)) :
    ∀ t ∈ Icc (0 : ℝ) (15 / 2), BoxΦ (fun t => (Y t).1) (fun t => (Y t).2.1) (fun t => (Y t).2.2) t := by
  have hX : (((15/2 : ℚ) : ℚ) : ℝ) = (15 / 2 : ℝ) := by norm_num
  have hs : SolC (((15/2 : ℚ) : ℚ) : ℝ) 0 (fun t => (Y t).1) (fun t => (Y t).2.1) (fun t => (Y t).2.2) := by
    rw [hX]
    exact ⟨fun t ht => (hY t ht).fst, fun t ht => (hY t ht).snd.fst, fun t ht => (hY t ht).snd.snd⟩
  have z0 : ((c0.t0 : ℚ) : ℝ) = 0 := by simp [c0]
  have b0 : InBox c0 (fun t => (Y t).1) (fun t => (Y t).2.1) (fun t => (Y t).2.2) := by
    unfold InBox; simp only [z0, h0]
    simp only [V, c0, List.headD_cons]; push_cast; norm_num

  obtain ⟨b1, P0⟩ := segS_q0 (Φ := BoxΦ) (fun c hok _ => box_spec c hok) c6 [c1, c2, c3, c4, c5] c0 seg0_ok hs b0
  rw [z0] at P0
  obtain ⟨b2, P1⟩ := segS_q0 (Φ := BoxΦ) (fun c hok _ => box_spec c hok) c12 [c7, c8, c9, c10, c11] c6 seg1_ok hs b1
  have A1 := glue P0 P1
  obtain ⟨b3, P2⟩ := segS_q0 (Φ := BoxΦ) (fun c hok _ => box_spec c hok) c18 [c13, c14, c15, c16, c17] c12 seg2_ok hs b2
  have A2 := glue A1 P2
  obtain ⟨b4, P3⟩ := segS_q0 (Φ := BoxΦ) (fun c hok _ => box_spec c hok) c24 [c19, c20, c21, c22, c23] c18 seg3_ok hs b3
  have A3 := glue A2 P3
  obtain ⟨b5, P4⟩ := segS_q0 (Φ := BoxΦ) (fun c hok _ => box_spec c hok) c30 [c25, c26, c27, c28, c29] c24 seg4_ok hs b4
  have A4 := glue A3 P4
  obtain ⟨b6, P5⟩ := segS_q0 (Φ := BoxΦ) (fun c hok _ => box_spec c hok) c36 [c31, c32, c33, c34, c35] c30 seg5_ok hs b5
  have A5 := glue A4 P5
  obtain ⟨b7, P6⟩ := segS_q0 (Φ := BoxΦ) (fun c hok _ => box_spec c hok) c42 [c37, c38, c39, c40, c41] c36 seg6_ok hs b6
  have A6 := glue A5 P6
  obtain ⟨b8, P7⟩ := segS_q0 (Φ := BoxΦ) (fun c hok _ => box_spec c hok) c48 [c43, c44, c45, c46, c47] c42 seg7_ok hs b7
  have A7 := glue A6 P7
  obtain ⟨b9, P8⟩ := segS_q0 (Φ := BoxΦ) (fun c hok _ => box_spec c hok) c54 [c49, c50, c51, c52, c53] c48 seg8_ok hs b8
  have A8 := glue A7 P8
  obtain ⟨-, P9⟩ := endS_q0 (Φ := BoxΦ) (fun c hok _ => box_spec c hok) [c55, c56, c57, c58, c59] c54 seg9_ok hs b9
  have A9 := glue A8 P9
  rw [hX] at A9
  exact A9

end Checked.Hiemenz.HUDataC

