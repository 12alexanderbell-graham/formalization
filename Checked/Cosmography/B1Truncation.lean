noncomputable def gL (Ω v : ℝ) : ℝ := 2 / √(Ω + (1 - Ω) * v ^ 6)

lemma gL_anti (Ω : ℝ) (hΩ₀ : 0 ≤ Ω) (hΩ₁ : Ω ≤ 1) (w u : ℝ) (hw : 0 < w) :
    AntitoneOn (gL Ω) (Icc w u) := by
  intro v hv v' hv' hvv
  have h0 : 0 < v := lt_of_lt_of_le hw hv.1
  have hin := inner_pos Ω v hΩ₀ hΩ₁ h0
  unfold gL
  apply div_le_div_of_nonneg_left (by norm_num) (Real.sqrt_pos.2 hin)
  apply Real.sqrt_le_sqrt
  have : v ^ 6 ≤ v' ^ 6 := pow_le_pow_left₀ h0.le hvv 6
  nlinarith [mul_le_mul_of_nonneg_left this (by linarith : 0 ≤ 1 - Ω)]

lemma J_lower (Ω : ℝ) (hΩ₀ : 0 ≤ Ω) (hΩ₁ : Ω ≤ 1) (w h : ℝ) (hw : 0 < w) (hh : 0 < h) (N : ℕ)
    (c : ℕ → ℝ) (hc : ∀ i, 0 ≤ c i) :
    ∑ i ∈ Finset.range N, h * (3 * c i - c i ^ 3 * (Ω + (1 - Ω) * (w + (i + 1) * h) ^ 6))
      ≤ ∫ v in w..w + N * h, gL Ω v := by
  refine le_trans (Finset.sum_le_sum fun i _ => ?_)
    (rsum_le_integral _ w h hh N (gL_anti Ω hΩ₀ hΩ₁ w _ hw))
  apply mul_le_mul_of_nonneg_left _ hh.le
  have hv : 0 < w + (i + 1) * h := by positivity
  have := tangent_le _ (c i) (inner_pos Ω _ hΩ₀ hΩ₁ hv) (hc i)
  unfold gL; rw [div_eq_mul_one_div 2]; linarith

lemma J_upper (Ω : ℝ) (hΩ₀ : 0 ≤ Ω) (hΩ₁ : Ω ≤ 1) (w h : ℝ) (hw : 0 < w) (hh : 0 < h) (N : ℕ)
    (p q : ℕ → ℝ) (hp : ∀ i < N, 0 < p i) (hq : ∀ i < N, 0 < q i)
    (h1 : ∀ i < N, p i ^ 2 ≤ Ω + (1 - Ω) * (w + i * h) ^ 6)
    (h2 : ∀ i < N, Ω + (1 - Ω) * (w + i * h) ^ 6 ≤ q i ^ 2) :
    ∫ v in w..w + N * h, gL Ω v ≤ ∑ i ∈ Finset.range N, h * (2 * (1 / p i -
      (Ω + (1 - Ω) * (w + i * h) ^ 6 - p i ^ 2) / (p i * q i * (p i + q i)))) := by
  refine le_trans (integral_le_lsum _ w h hh N (gL_anti Ω hΩ₀ hΩ₁ w _ hw))
    (Finset.sum_le_sum fun i hi => ?_)
  have hi' := Finset.mem_range.1 hi
  apply mul_le_mul_of_nonneg_left _ hh.le
  have := le_secant _ (p i) (q i) (hp i hi') (hq i hi') (h1 i hi') (h2 i hi')
  unfold gL; rw [div_eq_mul_one_div 2]; linarith



lemma y_mono (Ω a v : ℝ) (ha : a ≤ Ω) (hv0 : 0 ≤ v) (hv : v ≤ 1) :
    a + (1 - a) * v ^ 6 ≤ Ω + (1 - Ω) * v ^ 6 := by
  have : v ^ 6 ≤ 1 := pow_le_one₀ hv0 hv
  nlinarith


