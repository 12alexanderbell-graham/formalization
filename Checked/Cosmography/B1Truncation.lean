/-- **Bridge.** In a flat ΛCDM model on `[t, t₀]` the luminosity distance is
`(1+z)/H₀ · ∫_{√(a(t)/a(t₀))}^{1} 2/√(Ω + (1−Ω)v⁶) dv`. -/
theorem lumDistFlat_flatLCDM (Ω : ℝ) (hΩ₀ : 0 ≤ Ω) (hΩ₁ : Ω ≤ 1)
    (a : ℝ → ℝ) (t t₀ : ℝ) (htt : t ≤ t₀)
    (hpos : ∀ s ∈ Set.Icc t t₀, 0 < a s)
    (hdiff : ∀ s ∈ Set.Icc t t₀, DifferentiableAt ℝ a s)
    (hH₀ : 0 < hubble a t₀)
    (hH : ∀ s ∈ Set.Icc t t₀,
      hubble a s = hubble a t₀ * √(Ω * (1 + redshift a t₀ s) ^ 3 + 1 - Ω)) :
    lumDistFlat a t₀ t = (1 + redshift a t₀ t) / hubble a t₀ *
      ∫ v in √(a t / a t₀)..1, 2 / √(Ω + (1 - Ω) * v ^ 6) := by
  set a₀ := a t₀ with ha₀def
  set H₀ := hubble a t₀ with hH₀def
  have ha₀ : 0 < a₀ := hpos t₀ ⟨htt, le_rfl⟩
  set g : ℝ → ℝ := fun v => 2 / √(Ω + (1 - Ω) * v ^ 6) with hgdef
  have hgc : ContinuousOn g (Ioi 0) := by
    intro v hv
    have hin := inner_pos Ω v hΩ₀ hΩ₁ hv
    apply ContinuousAt.continuousWithinAt
    apply continuousAt_const.div
    · exact (by fun_prop : Continuous fun v : ℝ => Ω + (1 - Ω) * v ^ 6).continuousAt.sqrt
    · exact (Real.sqrt_pos.2 hin).ne'
  set G : ℝ → ℝ := fun x => ∫ v in (1:ℝ)..x, g v with hGdef
  have hG : ∀ x, 0 < x → HasDerivAt G (g x) x := by
    intro x hx
    have hsub : uIcc (1:ℝ) x ⊆ Ioi 0 := by
      intro y hy; rcases mem_uIcc.1 hy with h | h
      · exact lt_of_lt_of_le one_pos h.1
      · exact lt_of_lt_of_le hx h.1
    exact intervalIntegral.integral_hasDerivAt_right ((hgc.mono hsub).intervalIntegrable)
      (hgc.stronglyMeasurableAtFilter isOpen_Ioi x hx) (hgc.continuousAt (Ioi_mem_nhds hx))
  set W : ℝ → ℝ := fun s => √(a s / a₀) with hWdef
  set F : ℝ → ℝ := fun s => G (W s) / (H₀ * a₀) with hFdef
  have hF : ∀ s ∈ uIcc t t₀, HasDerivAt F (1 / a s) s := by
    intro s hs
    rw [uIcc_of_le htt] at hs
    have has := hpos s hs
    have hr : 0 < a s / a₀ := div_pos has ha₀
    have hWs : 0 < W s := Real.sqrt_pos.2 hr
    have hW2 : a s = W s ^ 2 * a₀ := by
      simp only [hWdef]; rw [Real.sq_sqrt hr.le]; field_simp
    have hd : HasDerivAt W ((deriv a s / a₀) / (2 * √(a s / a₀))) s :=
      ((hdiff s hs).hasDerivAt.div_const a₀).sqrt hr.ne'
    have hc := ((hG (W s) hWs).comp s hd).div_const (H₀ * a₀)
    have hin := inner_pos Ω (W s) hΩ₀ hΩ₁ hWs
    have hHs := hH s hs
    simp only [hubble, redshift] at hHs
    rw [← ha₀def, sqrt_alg Ω a₀ (a s) (W s) hWs ha₀ hW2 hin] at hHs
    have hda : deriv a s = a s * H₀ * (√(Ω + (1 - Ω) * W s ^ 6) / W s ^ 3) := by
      rw [hH₀def]; field_simp at hHs ⊢; linarith [hHs]
    exact hc.congr_deriv
      (deriv_alg H₀ a₀ (a s) (deriv a s) _ (W s) hWs (Real.sqrt_pos.2 hin) ha₀ hH₀ hW2 hda)
  have hint : IntervalIntegrable (fun s => 1 / a s) MeasureTheory.volume t t₀ := by
    apply ContinuousOn.intervalIntegrable
    intro x hx
    rw [uIcc_of_le htt] at hx
    exact (continuousAt_const.div (hdiff x hx).continuousAt (hpos x hx).ne').continuousWithinAt
  have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hF hint
  have hW0 : W t₀ = 1 := by
    show √(a t₀ / a₀) = 1
    rw [← ha₀def, div_self ha₀.ne', Real.sqrt_one]
  have hG1 : G 1 = 0 := by simp [hGdef]
  unfold lumDistFlat comoving
  rw [hftc]
  simp only [hFdef, hW0, hG1]
  rw [intervalIntegral.integral_symm]
  simp only [hGdef, hgdef, hWdef]
  field_simp
  ring


lemma gL_nonneg (Ω v : ℝ) : 0 ≤ gL Ω v := div_nonneg (by norm_num) (Real.sqrt_nonneg _)

lemma gL_cont (Ω : ℝ) (hΩ₀ : 0 ≤ Ω) (hΩ₁ : Ω ≤ 1) : ContinuousOn (gL Ω) (Ioi 0) := by
  intro v hv
  have hin := inner_pos Ω v hΩ₀ hΩ₁ hv
  apply ContinuousAt.continuousWithinAt
  apply continuousAt_const.div
  · exact (by fun_prop : Continuous fun v : ℝ => Ω + (1 - Ω) * v ^ 6).continuousAt.sqrt
  · exact (Real.sqrt_pos.2 hin).ne'

/-- Moving the lower limit up decreases the integral (the integrand is nonnegative). -/
lemma J_shift (Ω : ℝ) (hΩ₀ : 0 ≤ Ω) (hΩ₁ : Ω ≤ 1) (w w' : ℝ) (hw : 0 < w) (hww : w ≤ w')
    (hw' : w' ≤ 1) : ∫ v in w'..1, gL Ω v ≤ ∫ v in w..1, gL Ω v := by
  have hint : ∀ x y : ℝ, w ≤ x → w ≤ y → IntervalIntegrable (gL Ω) MeasureTheory.volume x y := by
    intro x y hx hy
    apply (gL_cont Ω hΩ₀ hΩ₁).mono _ |>.intervalIntegrable
    intro z hz; rcases mem_uIcc.1 hz with h | h
    · exact lt_of_lt_of_le hw (le_trans hx h.1)
    · exact lt_of_lt_of_le hw (le_trans hy h.1)
  rw [← intervalIntegral.integral_add_adjacent_intervals (hint w w' le_rfl hww)
    (hint w' 1 hww (by linarith))]
  have : 0 ≤ ∫ v in w..w', gL Ω v :=
    intervalIntegral.integral_nonneg hww (fun v _ => gL_nonneg Ω v)
  linarith

lemma log_ten_lt : Real.log 10 < 10 / 3 * 0.6931471808 := by
  have h1 : Real.log 1000 < Real.log 1024 := Real.log_lt_log (by norm_num) (by norm_num)
  have h2 : Real.log 1000 = 3 * Real.log 10 := by
    rw [show (1000:ℝ) = 10 ^ 3 by norm_num, Real.log_pow]; norm_num
  have h3 : Real.log 1024 = 10 * Real.log 2 := by
    rw [show (1024:ℝ) = 2 ^ 10 by norm_num, Real.log_pow]; norm_num
  linarith [Real.log_two_lt_d9]

/-- `c < 5 log₁₀ X` from `X (1 − κ) > 1`, `κ = (c/5)(10/3) 0.6931471808 ≥ (c/5) ln 10`
(uses `ln X ≥ 1 − 1/X` and `ln 10 < (10/3) ln 2`). -/
lemma five_logb_gt (c X : ℝ) (hX : 0 < X) (hc : 0 ≤ c)
    (h : 1 < X * (1 - c / 5 * (10 / 3 * 0.6931471808))) : c < 5 * Real.logb 10 X := by
  have hl10 : 0 < Real.log 10 := Real.log_pos (by norm_num)
  have hlog := Real.one_sub_inv_le_log_of_pos hX
  set k := c / 5 * (10 / 3 * 0.6931471808) with hk
  have h1 : k < 1 - X⁻¹ := by
    have e : X⁻¹ * (X * (1 - k)) = 1 - k := by field_simp
    have h' : X⁻¹ * 1 < X⁻¹ * (X * (1 - k)) := mul_lt_mul_of_pos_left h (inv_pos.2 hX)
    linarith
  have h2 : c / 5 * Real.log 10 ≤ k := by
    rw [hk]; exact mul_le_mul_of_nonneg_left log_ten_lt.le (by positivity)
  rw [Real.logb, ← mul_div_assoc, lt_div_iff₀ hl10]
  linarith

/-- `ln 10 ·(x + a₂x² + a₃x³)` at the ΛCDM coefficients, in `u = ln(1+z)`. -/
noncomputable def Qc (Ω u : ℝ) : ℝ :=
  u + (3 / 2 - 3 / 4 * Ω) * u ^ 2 + (9 / 8 * Ω ^ 2 - 2 * Ω + 7 / 6) * u ^ 3

lemma poly_eq (Ω H z : ℝ) (hH : H ≠ 0) :
    logPolyDL3 (lusA2 Ω) (lusA3 Ω) H z = Qc Ω (Real.log (1 + z)) / H := by
  have hl : Real.log 10 ≠ 0 := (Real.log_pos (by norm_num)).ne'
  unfold logPolyDL3 lusA2 lusA3 Qc Real.logb
  field_simp

lemma Qc_mono (Ω u v : ℝ) (h1 : 1 / 5 ≤ Ω) (h2 : Ω ≤ 2 / 5) (hu : 0 ≤ u) (huv : u ≤ v) :
    Qc Ω u ≤ Qc Ω v := by
  unfold Qc
  have hb2 : 0 ≤ 3 / 2 - 3 / 4 * Ω := by linarith
  have hb3 : 0 ≤ 9 / 8 * Ω ^ 2 - 2 * Ω + 7 / 6 := by nlinarith [sq_nonneg (Ω - 8 / 9)]
  have hv : 0 ≤ v := le_trans hu huv
  have e2 : u ^ 2 ≤ v ^ 2 := pow_le_pow_left₀ hu huv 2
  have e3 : u ^ 3 ≤ v ^ 3 := pow_le_pow_left₀ hu huv 3
  nlinarith [mul_le_mul_of_nonneg_left e2 hb2, mul_le_mul_of_nonneg_left e3 hb3]

lemma Qc_pos (Ω u : ℝ) (h1 : 1 / 5 ≤ Ω) (h2 : Ω ≤ 2 / 5) (hu : 0 < u) : 0 < Qc Ω u := by
  unfold Qc
  have hb2 : 0 ≤ 3 / 2 - 3 / 4 * Ω := by linarith
  have hb3 : 0 ≤ 9 / 8 * Ω ^ 2 - 2 * Ω + 7 / 6 := by nlinarith [sq_nonneg (Ω - 8 / 9)]
  positivity

lemma log4 : Real.log (1 + 3) = 2 * Real.log 2 := by
  rw [show (1:ℝ) + 3 = 2 ^ 2 by norm_num, Real.log_pow]; norm_num

lemma log8 : Real.log (1 + 7) = 3 * Real.log 2 := by
  rw [show (1:ℝ) + 7 = 2 ^ 3 by norm_num, Real.log_pow]; norm_num

/-- The model at a source of redshift `z`: `a(t)/a(t₀) = 1/(1+z)`. -/
lemma ratio_of_z (a : ℝ → ℝ) (t t₀ z : ℝ) (ha : 0 < a t) (ha₀ : 0 < a t₀)
    (hz : redshift a t₀ t = z) : a t / a t₀ = 1 / (1 + z) := by
  unfold redshift at hz
  have h1 : 1 + z = a t₀ / a t := by linarith
  rw [h1]; field_simp

/-- Lower bounds for `J₃ = ∫_{1/2}^1 gL` and `J₇ = ∫_{√(1/8)}^1 gL` on `[1/5, 2/5]`. -/
lemma J3_lower (Ω : ℝ) (h1 : 1 / 5 ≤ Ω) (h2 : Ω ≤ 2 / 5) :
    (Ω ≤ 3 / 10 → (1588549 / 800000 : ℝ) - (173265881 / 100000000 : ℝ) * Ω ≤
        ∫ v in (1/2:ℝ)..1, gL Ω v) ∧
    (3 / 10 ≤ Ω → (182945119 / 100000000 : ℝ) - (120219491 / 100000000 : ℝ) * Ω ≤
        ∫ v in (1/2:ℝ)..1, gL Ω v) :=
  ⟨fun _ => J3_lower0 Ω (by linarith) (by linarith), fun _ => J3_lower1 Ω (by linarith) (by linarith)⟩

lemma J7_lower (Ω : ℝ) (h1 : 1 / 5 ≤ Ω) (h2 : Ω ≤ 2 / 5) :
    (Ω ≤ 3 / 10 → (141929311 / 50000000 : ℝ) - (284250829 / 100000000 : ℝ) * Ω ≤
        ∫ v in √(1 / (1 + 7))..1, gL Ω v) ∧
    (3 / 10 ≤ Ω → (998388 / 390625 : ℝ) - (47016993 / 25000000 : ℝ) * Ω ≤
        ∫ v in √(1 / (1 + 7))..1, gL Ω v) := by
  have hs0 : 0 < √(1 / (1 + 7) : ℝ) := Real.sqrt_pos.2 (by norm_num)
  have hs : √(1 / (1 + 7) : ℝ) ≤ 3536 / 10000 := by
    rw [show (3536 / 10000 : ℝ) = √((3536 / 10000) ^ 2) from (Real.sqrt_sq (by norm_num)).symm]
    exact Real.sqrt_le_sqrt (by norm_num)
  have hsh := J_shift Ω (by linarith) (by linarith) _ _ hs0 hs (by norm_num)
  exact ⟨fun _ => le_trans (J7_lower0 Ω (by linarith) (by linarith)) hsh,
    fun _ => le_trans (J7_lower1 Ω (by linarith) (by linarith)) hsh⟩

/-- **B1, z = 3.** For every flat ΛCDM model with `Ω ∈ [0.2, 0.4]`, the third-order
log-polynomial at the ΛCDM-implied coefficients (same `H₀`) is positive at `z = 3` and
underestimates the exact distance modulus there by more than 0.09 mag. -/
theorem cubic_misses_z3 (Ω : ℝ) (hΩ₁ : 1 / 5 ≤ Ω) (hΩ₂ : Ω ≤ 2 / 5)
    (a : ℝ → ℝ) (t t₀ : ℝ) (htt : t ≤ t₀)
    (hpos : ∀ s ∈ Set.Icc t t₀, 0 < a s)
    (hdiff : ∀ s ∈ Set.Icc t t₀, DifferentiableAt ℝ a s)
    (hH₀ : 0 < hubble a t₀)
    (hH : ∀ s ∈ Set.Icc t t₀,
      hubble a s = hubble a t₀ * √(Ω * (1 + redshift a t₀ s) ^ 3 + 1 - Ω))
    (hz : redshift a t₀ t = 3) :
    0 < logPolyDL3 (lusA2 Ω) (lusA3 Ω) (hubble a t₀) (redshift a t₀ t) ∧
    9 / 100 < 5 * Real.logb 10
      (lumDistFlat a t₀ t / logPolyDL3 (lusA2 Ω) (lusA3 Ω) (hubble a t₀) (redshift a t₀ t)) := by
  have hΩ₀ : 0 ≤ Ω := by linarith
  have hΩ1 : Ω ≤ 1 := by linarith
  have hbr := lumDistFlat_flatLCDM Ω hΩ₀ hΩ1 a t t₀ htt hpos hdiff hH₀ hH
  have hat : 0 < a t := hpos t ⟨le_rfl, htt⟩
  have hw : √(1 / (1 + 3) : ℝ) = 1 / 2 := by
    rw [show (1 / (1 + 3) : ℝ) = (1 / 2) ^ 2 by norm_num]; exact Real.sqrt_sq (by norm_num)
  rw [ratio_of_z a t t₀ 3 hat (hpos t₀ ⟨htt, le_rfl⟩) hz, hw] at hbr
  change lumDistFlat a t₀ t = (1 + redshift a t₀ t) / hubble a t₀ * ∫ v in (1/2:ℝ)..1, gL Ω v
    at hbr
  rw [poly_eq Ω _ _ hH₀.ne', hbr, hz, log4]
  set J := ∫ v in (1/2:ℝ)..1, gL Ω v with hJ
  set H := hubble a t₀ with hHdef
  have hu0 : 0 < 2 * Real.log 2 := by positivity
  have hQ := Qc_pos Ω _ hΩ₁ hΩ₂ hu0
  refine ⟨div_pos hQ hH₀, ?_⟩
  have hX : (1 + 3) / H * J / (Qc Ω (2 * Real.log 2) / H) = 4 * J / Qc Ω (2 * Real.log 2) := by
    field_simp; ring
  rw [hX]
  have hQm := Qc_mono Ω _ (2 * 0.6931471808) hΩ₁ hΩ₂ hu0.le (by linarith [Real.log_two_lt_d9])
  rcases le_total Ω (3 / 10) with hp | hp
  · have hl := (J3_lower Ω hΩ₁ hΩ₂).1 hp
    have hJ0 : 0 < J := by linarith
    apply five_logb_gt _ _ (by positivity) (by norm_num)
    rw [div_mul_eq_mul_div, one_lt_div hQ]
    have : Qc Ω (2 * 0.6931471808) < 4 * ((1588549 / 800000 : ℝ) - (173265881 / 100000000 : ℝ) * Ω)
        * (1 - 9 / 100 / 5 * (10 / 3 * 0.6931471808)) := by
      unfold Qc; nlinarith [mul_nonneg (sub_nonneg.2 hΩ₁) (sub_nonneg.2 hp)]
    linarith
  · have hl := (J3_lower Ω hΩ₁ hΩ₂).2 hp
    have hJ0 : 0 < J := by linarith
    apply five_logb_gt _ _ (by positivity) (by norm_num)
    rw [div_mul_eq_mul_div, one_lt_div hQ]
    have : Qc Ω (2 * 0.6931471808) < 4 * ((182945119 / 100000000 : ℝ) - (120219491 / 100000000 : ℝ) * Ω)
        * (1 - 9 / 100 / 5 * (10 / 3 * 0.6931471808)) := by
      unfold Qc; nlinarith [mul_nonneg (sub_nonneg.2 hp) (sub_nonneg.2 hΩ₂)]
    linarith

/-- **B1, z = 7.** As `cubic_misses_z3`, at `z = 7`: more than 0.3 mag. -/
theorem cubic_misses_z7 (Ω : ℝ) (hΩ₁ : 1 / 5 ≤ Ω) (hΩ₂ : Ω ≤ 2 / 5)
    (a : ℝ → ℝ) (t t₀ : ℝ) (htt : t ≤ t₀)
    (hpos : ∀ s ∈ Set.Icc t t₀, 0 < a s)
    (hdiff : ∀ s ∈ Set.Icc t t₀, DifferentiableAt ℝ a s)
    (hH₀ : 0 < hubble a t₀)
    (hH : ∀ s ∈ Set.Icc t t₀,
      hubble a s = hubble a t₀ * √(Ω * (1 + redshift a t₀ s) ^ 3 + 1 - Ω))
    (hz : redshift a t₀ t = 7) :
    0 < logPolyDL3 (lusA2 Ω) (lusA3 Ω) (hubble a t₀) (redshift a t₀ t) ∧
    3 / 10 < 5 * Real.logb 10
      (lumDistFlat a t₀ t / logPolyDL3 (lusA2 Ω) (lusA3 Ω) (hubble a t₀) (redshift a t₀ t)) := by
  have hΩ₀ : 0 ≤ Ω := by linarith
  have hΩ1 : Ω ≤ 1 := by linarith
  have hbr := lumDistFlat_flatLCDM Ω hΩ₀ hΩ1 a t t₀ htt hpos hdiff hH₀ hH
  have hat : 0 < a t := hpos t ⟨le_rfl, htt⟩
  rw [ratio_of_z a t t₀ 7 hat (hpos t₀ ⟨htt, le_rfl⟩) hz] at hbr
  change lumDistFlat a t₀ t = (1 + redshift a t₀ t) / hubble a t₀ *
    ∫ v in √(1 / (1 + 7) : ℝ)..1, gL Ω v at hbr
  rw [poly_eq Ω _ _ hH₀.ne', hbr, hz, log8]
  set J := ∫ v in √(1 / (1 + 7) : ℝ)..1, gL Ω v with hJ
  set H := hubble a t₀ with hHdef
  have hu0 : 0 < 3 * Real.log 2 := by positivity
  have hQ := Qc_pos Ω _ hΩ₁ hΩ₂ hu0
  refine ⟨div_pos hQ hH₀, ?_⟩
  have hX : (1 + 7) / H * J / (Qc Ω (3 * Real.log 2) / H) = 8 * J / Qc Ω (3 * Real.log 2) := by
    field_simp; ring
  rw [hX]
  have hQm := Qc_mono Ω _ (3 * 0.6931471808) hΩ₁ hΩ₂ hu0.le (by linarith [Real.log_two_lt_d9])
  rcases le_total Ω (3 / 10) with hp | hp
  · have hl := (J7_lower Ω hΩ₁ hΩ₂).1 hp
    have hJ0 : 0 < J := by linarith
    apply five_logb_gt _ _ (by positivity) (by norm_num)
    rw [div_mul_eq_mul_div, one_lt_div hQ]
    have : Qc Ω (3 * 0.6931471808) < 8 * ((141929311 / 50000000 : ℝ) - (284250829 / 100000000 : ℝ) * Ω)
        * (1 - 3 / 10 / 5 * (10 / 3 * 0.6931471808)) := by
      unfold Qc; nlinarith [mul_nonneg (sub_nonneg.2 hΩ₁) (sub_nonneg.2 hp)]
    linarith
  · have hl := (J7_lower Ω hΩ₁ hΩ₂).2 hp
    have hJ0 : 0 < J := by linarith
    apply five_logb_gt _ _ (by positivity) (by norm_num)
    rw [div_mul_eq_mul_div, one_lt_div hQ]
    have : Qc Ω (3 * 0.6931471808) < 8 * ((998388 / 390625 : ℝ) - (47016993 / 25000000 : ℝ) * Ω)
        * (1 - 3 / 10 / 5 * (10 / 3 * 0.6931471808)) := by
      unfold Qc; nlinarith [mul_nonneg (sub_nonneg.2 hp) (sub_nonneg.2 hΩ₂)]
    linarith

/-- **B1, shape (normalisation-free).** In every flat ΛCDM model with `Ω ∈ [0.2, 0.4]`, with
sources at `z = 3` (time `t₃`) and `z = 7` (time `t₇`), the miss of the ΛCDM-implied cubic
log-polynomial at `z = 7` exceeds its miss at `z = 3` by more than 0.18 mag. A change of `H₀`
(or of any magnitude zero point) in the polynomial shifts both misses equally. -/
theorem cubic_shape_miss (Ω : ℝ) (hΩ₁ : 1 / 5 ≤ Ω) (hΩ₂ : Ω ≤ 2 / 5)
    (a : ℝ → ℝ) (t₇ t₃ t₀ : ℝ) (h₇₃ : t₇ ≤ t₃) (h₃₀ : t₃ ≤ t₀)
    (hpos : ∀ s ∈ Set.Icc t₇ t₀, 0 < a s)
    (hdiff : ∀ s ∈ Set.Icc t₇ t₀, DifferentiableAt ℝ a s)
    (hH₀ : 0 < hubble a t₀)
    (hH : ∀ s ∈ Set.Icc t₇ t₀,
      hubble a s = hubble a t₀ * √(Ω * (1 + redshift a t₀ s) ^ 3 + 1 - Ω))
    (hz₃ : redshift a t₀ t₃ = 3) (hz₇ : redshift a t₀ t₇ = 7) :
    18 / 100 < 5 * Real.logb 10
        (lumDistFlat a t₀ t₇ / logPolyDL3 (lusA2 Ω) (lusA3 Ω) (hubble a t₀) (redshift a t₀ t₇))
      - 5 * Real.logb 10
        (lumDistFlat a t₀ t₃ / logPolyDL3 (lusA2 Ω) (lusA3 Ω) (hubble a t₀) (redshift a t₀ t₃)) := by
  have hΩ₀ : 0 ≤ Ω := by linarith
  have hΩ1 : Ω ≤ 1 := by linarith
  have hsub : Set.Icc t₃ t₀ ⊆ Set.Icc t₇ t₀ := Set.Icc_subset_Icc_left h₇₃
  have hbr3 := lumDistFlat_flatLCDM Ω hΩ₀ hΩ1 a t₃ t₀ h₃₀ (fun s hs => hpos s (hsub hs))
    (fun s hs => hdiff s (hsub hs)) hH₀ (fun s hs => hH s (hsub hs))
  have hbr7 := lumDistFlat_flatLCDM Ω hΩ₀ hΩ1 a t₇ t₀ (le_trans h₇₃ h₃₀) hpos hdiff hH₀ hH
  have ha3 : 0 < a t₃ := hpos t₃ ⟨h₇₃, h₃₀⟩
  have ha7 : 0 < a t₇ := hpos t₇ ⟨le_rfl, le_trans h₇₃ h₃₀⟩
  have hw : √(1 / (1 + 3) : ℝ) = 1 / 2 := by
    rw [show (1 / (1 + 3) : ℝ) = (1 / 2) ^ 2 by norm_num]; exact Real.sqrt_sq (by norm_num)
  rw [ratio_of_z a t₃ t₀ 3 ha3 (hpos t₀ ⟨le_trans h₇₃ h₃₀, le_rfl⟩) hz₃, hw] at hbr3
  rw [ratio_of_z a t₇ t₀ 7 ha7 (hpos t₀ ⟨le_trans h₇₃ h₃₀, le_rfl⟩) hz₇] at hbr7
  change lumDistFlat a t₀ t₃ = (1 + redshift a t₀ t₃) / hubble a t₀ * ∫ v in (1/2:ℝ)..1, gL Ω v
    at hbr3
  change lumDistFlat a t₀ t₇ = (1 + redshift a t₀ t₇) / hubble a t₀ *
    ∫ v in √(1 / (1 + 7) : ℝ)..1, gL Ω v at hbr7
  rw [poly_eq Ω _ (redshift a t₀ t₇) hH₀.ne', poly_eq Ω _ (redshift a t₀ t₃) hH₀.ne', hbr3, hbr7,
    hz₃, hz₇, log4, log8]
  set J3 := ∫ v in (1/2:ℝ)..1, gL Ω v with hJ3def
  set J7 := ∫ v in √(1 / (1 + 7) : ℝ)..1, gL Ω v with hJ7def
  set H := hubble a t₀ with hHdef
  set Q3 := Qc Ω (2 * Real.log 2) with hQ3def
  set Q7 := Qc Ω (3 * Real.log 2) with hQ7def
  have hQ3 : 0 < Q3 := Qc_pos Ω _ hΩ₁ hΩ₂ (by positivity)
  have hQ7 : 0 < Q7 := Qc_pos Ω _ hΩ₁ hΩ₂ (by positivity)
  have hQ7m : Q7 ≤ Qc Ω (3 * 0.6931471808) :=
    Qc_mono Ω _ _ hΩ₁ hΩ₂ (by positivity) (by linarith [Real.log_two_lt_d9])
  have hQ3m : Qc Ω (2 * 0.6931471803) ≤ Q3 :=
    Qc_mono Ω _ _ hΩ₁ hΩ₂ (by norm_num) (by linarith [Real.log_two_gt_d9])
  have hX7 : (1 + 7) / H * J7 / (Q7 / H) = 8 * J7 / Q7 := by field_simp; ring
  have hX3 : (1 + 3) / H * J3 / (Q3 / H) = 4 * J3 / Q3 := by field_simp; ring
  rw [hX7, hX3]
  rcases le_total Ω (3 / 10) with hp | hp
  · have hl3 := (J3_lower Ω hΩ₁ hΩ₂).1 hp
    have hl7 := (J7_lower Ω hΩ₁ hΩ₂).1 hp
    have hu3 := J3_upper0 Ω hΩ₁ hp
    have hJ3 : 0 < J3 := by linarith
    have hJ7 : 0 < J7 := by linarith
    have hX7p : 0 < 8 * J7 / Q7 := by positivity
    have hX3p : 0 < 4 * J3 / Q3 := by positivity
    rw [← mul_sub, ← Real.logb_div hX7p.ne' hX3p.ne']
    apply five_logb_gt _ _ (by positivity) (by norm_num)
    have hX : 8 * J7 / Q7 / (4 * J3 / Q3) = 2 * J7 * Q3 / (J3 * Q7) := by field_simp; ring
    rw [hX, div_mul_eq_mul_div, one_lt_div (by positivity)]
    have hpoly : ((203715349 / 100000000 : ℝ) + (-91364007 / 50000000 : ℝ) * Ω) * Qc Ω (3 * 0.6931471808) <
        2 * ((141929311 / 50000000 : ℝ) - (284250829 / 100000000 : ℝ) * Ω) * Qc Ω (2 * 0.6931471803) * (1 - 18 / 100 / 5 * (10 / 3 * 0.6931471808)) := by
      have h1 : 0 ≤ Ω - 1 / 5 := by linarith
      have h2 : 0 ≤ 3 / 10 - Ω := by linarith
      unfold Qc
      linarith [mul_nonneg (mul_nonneg h1 h1) h1, mul_nonneg (mul_nonneg h1 h1) h2,
        mul_nonneg (mul_nonneg h1 h2) h2, mul_nonneg (mul_nonneg h2 h2) h2]
    have hc0 : 0 ≤ (203715349 / 100000000 : ℝ) + (-91364007 / 50000000 : ℝ) * Ω := by linarith
    have hr0 : 0 ≤ (141929311 / 50000000 : ℝ) - (284250829 / 100000000 : ℝ) * Ω := by linarith
    have e1 : J3 * Q7 ≤ ((203715349 / 100000000 : ℝ) + (-91364007 / 50000000 : ℝ) * Ω) * Qc Ω (3 * 0.6931471808) :=
      mul_le_mul hu3 hQ7m hQ7.le hc0
    have e2 : ((141929311 / 50000000 : ℝ) - (284250829 / 100000000 : ℝ) * Ω) * Qc Ω (2 * 0.6931471803) ≤ J7 * Q3 :=
      mul_le_mul hl7 hQ3m (Qc_pos Ω (2 * 0.6931471803) hΩ₁ hΩ₂ (by norm_num)).le hJ7.le
    nlinarith
  · have hl3 := (J3_lower Ω hΩ₁ hΩ₂).2 hp
    have hl7 := (J7_lower Ω hΩ₁ hΩ₂).2 hp
    have hu3 := J3_upper1 Ω hp hΩ₂
    have hJ3 : 0 < J3 := by linarith
    have hJ7 : 0 < J7 := by linarith
    have hX7p : 0 < 8 * J7 / Q7 := by positivity
    have hX3p : 0 < 4 * J3 / Q3 := by positivity
    rw [← mul_sub, ← Real.logb_div hX7p.ne' hX3p.ne']
    apply five_logb_gt _ _ (by positivity) (by norm_num)
    have hX : 8 * J7 / Q7 / (4 * J3 / Q3) = 2 * J7 * Q3 / (J3 * Q7) := by field_simp; ring
    rw [hX, div_mul_eq_mul_div, one_lt_div (by positivity)]
    have hpoly : ((93266813 / 50000000 : ℝ) + (-62727941 / 50000000 : ℝ) * Ω) * Qc Ω (3 * 0.6931471808) <
        2 * ((998388 / 390625 : ℝ) - (47016993 / 25000000 : ℝ) * Ω) * Qc Ω (2 * 0.6931471803) * (1 - 18 / 100 / 5 * (10 / 3 * 0.6931471808)) := by
      have h1 : 0 ≤ Ω - 3 / 10 := by linarith
      have h2 : 0 ≤ 2 / 5 - Ω := by linarith
      unfold Qc
      linarith [mul_nonneg (mul_nonneg h1 h1) h1, mul_nonneg (mul_nonneg h1 h1) h2,
        mul_nonneg (mul_nonneg h1 h2) h2, mul_nonneg (mul_nonneg h2 h2) h2]
    have hc0 : 0 ≤ (93266813 / 50000000 : ℝ) + (-62727941 / 50000000 : ℝ) * Ω := by linarith
    have hr0 : 0 ≤ (998388 / 390625 : ℝ) - (47016993 / 25000000 : ℝ) * Ω := by linarith
    have e1 : J3 * Q7 ≤ ((93266813 / 50000000 : ℝ) + (-62727941 / 50000000 : ℝ) * Ω) * Qc Ω (3 * 0.6931471808) :=
      mul_le_mul hu3 hQ7m hQ7.le hc0
    have e2 : ((998388 / 390625 : ℝ) - (47016993 / 25000000 : ℝ) * Ω) * Qc Ω (2 * 0.6931471803) ≤ J7 * Q3 :=
      mul_le_mul hl7 hQ3m (Qc_pos Ω (2 * 0.6931471803) hΩ₁ hΩ₂ (by norm_num)).le hJ7.le
    nlinarith

/-- **Witness (global exact flat ΛCDM).** `a(t) = sinh(3t/2)^{2/3}` (so `H = coth(3t/2)`,
`H² = 1 + a⁻³`), observed at `t₀` with `sinh(3t₀/2) = 2`, is flat ΛCDM with `Ω = 1/5` on the
whole interval from a `z = 7` source (time `t₇`) through a `z = 3` source (`t₃`) to `t₀`. -/
theorem exists_flatLCDM_on :
    ∃ (a : ℝ → ℝ) (t₇ t₃ t₀ : ℝ), t₇ ≤ t₃ ∧ t₃ ≤ t₀ ∧
      (∀ s ∈ Set.Icc t₇ t₀, 0 < a s) ∧ (∀ s ∈ Set.Icc t₇ t₀, DifferentiableAt ℝ a s) ∧
      0 < hubble a t₀ ∧
      (∀ s ∈ Set.Icc t₇ t₀,
        hubble a s = hubble a t₀ * √(1 / 5 * (1 + redshift a t₀ s) ^ 3 + 1 - 1 / 5)) ∧
      redshift a t₀ t₃ = 3 ∧ redshift a t₀ t₇ = 7 := by
  set S : ℝ → ℝ := fun s => Real.sinh (3 / 2 * s) with hS
  set a : ℝ → ℝ := fun s => S s ^ (2 / 3 : ℝ) with ha
  have hSt : ∀ y, S (2 / 3 * Real.arsinh y) = y := by
    intro y; simp only [hS]; rw [show 3 / 2 * (2 / 3 * Real.arsinh y) = Real.arsinh y by ring,
      Real.sinh_arsinh]
  have h8 : (0:ℝ) < 8 ^ (3 / 2 : ℝ) := by positivity
  have h8' : (8:ℝ) ≤ 8 ^ (3 / 2 : ℝ) := by
    calc (8:ℝ) = 8 ^ (1:ℝ) := by norm_num
      _ ≤ 8 ^ (3 / 2 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by norm_num)
  set y₇ : ℝ := 2 / 8 ^ (3 / 2 : ℝ) with hy₇
  have hy₇0 : 0 < y₇ := by positivity
  have hy₇1 : y₇ ≤ 1 / 4 := by
    rw [hy₇, div_le_iff₀ h8]; linarith
  set t₇ : ℝ := 2 / 3 * Real.arsinh y₇
  set t₃ : ℝ := 2 / 3 * Real.arsinh (1 / 4)
  set t₀ : ℝ := 2 / 3 * Real.arsinh 2
  have ht₇ : 0 < t₇ := by have := Real.arsinh_pos_iff.2 hy₇0; positivity
  have h73 : t₇ ≤ t₃ := by
    have := Real.arsinh_le_arsinh.2 hy₇1; simp only [t₇, t₃]; linarith
  have h30 : t₃ ≤ t₀ := by
    have := Real.arsinh_le_arsinh.2 (show (1 / 4 : ℝ) ≤ 2 by norm_num); simp only [t₃, t₀]; linarith
  have hSpos : ∀ s, 0 < s → 0 < S s := by
    intro s hs; simp only [hS]; exact Real.sinh_pos_iff.2 (by positivity)
  -- derivative and Hubble rate
  have hderS : ∀ s, HasDerivAt S (Real.cosh (3 / 2 * s) * (3 / 2)) s := by
    intro s
    have h := (Real.hasDerivAt_sinh (3 / 2 * s)).comp s ((hasDerivAt_id s).const_mul (3 / 2))
    rw [mul_one] at h; exact h
  have hdera : ∀ s, 0 < s →
      HasDerivAt a (Real.cosh (3 / 2 * s) * (3 / 2) * (2 / 3) * S s ^ ((2 / 3 : ℝ) - 1)) s := by
    intro s hs
    exact (hderS s).rpow_const (Or.inl (hSpos s hs).ne')
  have hhub : ∀ s, 0 < s → hubble a s = Real.cosh (3 / 2 * s) / S s := by
    intro s hs
    have hSs := hSpos s hs
    unfold hubble
    rw [(hdera s hs).deriv]
    simp only [ha]
    rw [Real.rpow_sub hSs, Real.rpow_one]
    have : 0 < S s ^ (2 / 3 : ℝ) := Real.rpow_pos_of_pos hSs _
    field_simp
  have hcube : ∀ x : ℝ, 0 < x → (x ^ (2 / 3 : ℝ)) ^ 3 = x ^ 2 := by
    intro x hx
    rw [← Real.rpow_natCast, ← Real.rpow_mul hx.le]; norm_num
  have hz3 : ∀ s, 0 < s → (1 + redshift a t₀ s) ^ 3 = 4 / S s ^ 2 := by
    intro s hs
    have hSs := hSpos s hs
    unfold redshift
    simp only [ha]
    rw [hSt 2, show 1 + ((2:ℝ) ^ (2 / 3 : ℝ) / S s ^ (2 / 3 : ℝ) - 1) =
      (2:ℝ) ^ (2 / 3 : ℝ) / S s ^ (2 / 3 : ℝ) by ring, div_pow, hcube 2 (by norm_num),
      hcube _ hSs]
    norm_num
  have hcosh : ∀ s, Real.cosh (3 / 2 * s) = √(1 + S s ^ 2) := by
    intro s
    rw [eq_comm, Real.sqrt_eq_iff_mul_self_eq (by positivity) (Real.cosh_pos _).le]
    simp only [hS]; rw [← sq, Real.cosh_sq]; ring
  have hpos0 : 0 < t₀ := lt_of_lt_of_le ht₇ (le_trans h73 h30)
  have hH0 : hubble a t₀ = √5 / 2 := by
    rw [hhub t₀ hpos0, hcosh, hSt 2]; norm_num
  refine ⟨a, t₇, t₃, t₀, h73, h30, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro s hs; exact Real.rpow_pos_of_pos (hSpos s (lt_of_lt_of_le ht₇ hs.1)) _
  · intro s hs; exact (hdera s (lt_of_lt_of_le ht₇ hs.1)).differentiableAt
  · rw [hH0]; positivity
  · intro s hs
    have hs0 : 0 < s := lt_of_lt_of_le ht₇ hs.1
    have hSs := hSpos s hs0
    rw [hhub s hs0, hH0, hz3 s hs0, hcosh]
    have e : 1 / 5 * (4 / S s ^ 2) + 1 - 1 / 5 = (2 * √(1 + S s ^ 2) / (√5 * S s)) ^ 2 := by
      rw [div_pow, mul_pow, mul_pow, Real.sq_sqrt (by positivity), Real.sq_sqrt (by norm_num)]
      field_simp; ring
    rw [e, Real.sqrt_sq (by positivity)]
    have : (0:ℝ) < √5 := by positivity
    field_simp
  · unfold redshift; simp only [ha]
    rw [hSt 2, hSt, ← Real.div_rpow (by norm_num) (by norm_num),
      show (2:ℝ) / (1 / 4) = 2 ^ (3:ℝ) by norm_num, ← Real.rpow_mul (by norm_num)]
    norm_num
  · unfold redshift; simp only [ha]
    rw [hSt 2, hSt, ← Real.div_rpow (by norm_num) hy₇0.le, hy₇,
      show (2:ℝ) / (2 / 8 ^ (3 / 2 : ℝ)) = 8 ^ (3 / 2 : ℝ) by field_simp,
      ← Real.rpow_mul (by norm_num)]
    norm_num

end Checked.Cosmography.B1
