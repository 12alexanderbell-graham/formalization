    (fun i => (cZ71.getD i 0 : ℝ) / 100000) (fun i => by positivity)
  have e : (3536/10000:ℝ) + ((40:ℕ):ℝ) * (101 / 6250 : ℝ) = 1 := by norm_num
  rw [e] at key
  refine le_trans ?_ key
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, cZ71]
  norm_num
  linarith

