open Set

lemma rsum_le_integral (f : ℝ → ℝ) (x₀ h : ℝ) (hh : 0 < h) (N : ℕ)
    (hf : AntitoneOn f (Icc x₀ (x₀ + N * h))) :
    ∑ i ∈ Finset.range N, h * f (x₀ + (i + 1) * h) ≤ ∫ v in x₀..x₀ + N * h, f v := by
  have hφ : AntitoneOn (fun s => f (x₀ + h * s)) (Icc 0 (0 + (N:ℝ))) := by
    intro s hs s' hs' hss
    simp only [mem_Icc, zero_add] at hs hs'
    exact hf ⟨by nlinarith [hs.1], by nlinarith [hs.2]⟩ ⟨by nlinarith [hs'.1], by nlinarith [hs'.2]⟩
      (by nlinarith)
  have key := hφ.sum_le_integral
  rw [intervalIntegral.integral_comp_add_mul (fun v => f v) hh.ne', smul_eq_mul] at key
  have e : x₀ + h * (0 + (N:ℝ)) = x₀ + N * h := by ring
  have e0 : x₀ + h * 0 = x₀ := by ring
  rw [e, e0] at key
  rw [← Finset.mul_sum]
  have := mul_le_mul_of_nonneg_left key hh.le
  rw [← mul_assoc, mul_inv_cancel₀ hh.ne', one_mul] at this
  convert this using 3 with i _
  push_cast; ring_nf

lemma integral_le_lsum (f : ℝ → ℝ) (x₀ h : ℝ) (hh : 0 < h) (N : ℕ)
    (hf : AntitoneOn f (Icc x₀ (x₀ + N * h))) :
    ∫ v in x₀..x₀ + N * h, f v ≤ ∑ i ∈ Finset.range N, h * f (x₀ + i * h) := by
  have hφ : AntitoneOn (fun s => f (x₀ + h * s)) (Icc 0 (0 + (N:ℝ))) := by
    intro s hs s' hs' hss
    simp only [mem_Icc, zero_add] at hs hs'
    exact hf ⟨by nlinarith [hs.1], by nlinarith [hs.2]⟩ ⟨by nlinarith [hs'.1], by nlinarith [hs'.2]⟩
      (by nlinarith)
  have key := hφ.integral_le_sum
  rw [intervalIntegral.integral_comp_add_mul (fun v => f v) hh.ne', smul_eq_mul] at key
  have e : x₀ + h * (0 + (N:ℝ)) = x₀ + N * h := by ring
  have e0 : x₀ + h * 0 = x₀ := by ring
  rw [e, e0] at key
  rw [← Finset.mul_sum]
  have := mul_le_mul_of_nonneg_left key hh.le
  rw [← mul_assoc, mul_inv_cancel₀ hh.ne', one_mul] at this
  convert this using 3 with i _
  ring_nf

/-- Tangent bound: `1/√y ≥ (3c − c³y)/2` for every `c ≥ 0`, `y > 0`. -/
lemma tangent_le (y c : ℝ) (hy : 0 < y) (hc : 0 ≤ c) : (3 * c - c ^ 3 * y) / 2 ≤ 1 / √y := by
  have hs := Real.sqrt_pos.2 hy
  have hsq := Real.sq_sqrt hy.le
  rw [div_le_div_iff₀ (by norm_num) hs]
  have h0 : 0 ≤ (c * √y - 1) ^ 2 * (c * √y + 2) := by positivity
  have e : (3 * c - c ^ 3 * √y ^ 2) * √y = 2 - (c * √y - 1) ^ 2 * (c * √y + 2) := by ring
  rw [hsq] at e; linarith

/-- Secant bound: for `p ≤ √y ≤ q`, `1/√y ≤ 1/p − (y − p²)/(p q (p+q))`. -/
lemma le_secant (y p q : ℝ) (hp : 0 < p) (hq : 0 < q) (h1 : p ^ 2 ≤ y) (h2 : y ≤ q ^ 2) :
    1 / √y ≤ 1 / p - (y - p ^ 2) / (p * q * (p + q)) := by
  have hy : 0 < y := lt_of_lt_of_le (by positivity) h1
  have hs := Real.sqrt_pos.2 hy
  have hsq := Real.sq_sqrt hy.le
  have hps : p ≤ √y := Real.le_sqrt_of_sq_le h1
  have hsq' : √y ≤ q := by
    rw [show q = √(q^2) from (Real.sqrt_sq hq.le).symm]
    exact Real.sqrt_le_sqrt h2
  rw [div_sub_div _ _ hp.ne' (by positivity), div_le_div_iff₀ hs (by positivity)]
  have h0 : 0 ≤ p * ((√y - p) * (q - √y) * (√y + p + q)) := by
    apply mul_nonneg hp.le
    apply mul_nonneg (mul_nonneg (by linarith) (by linarith)); positivity
  have e : (1 * (p * q * (p + q)) - p * (√y ^ 2 - p ^ 2)) * √y - 1 * (p * (p * q * (p + q)))
      = p * ((√y - p) * (q - √y) * (√y + p + q)) := by ring
  rw [hsq] at e; linarith

lemma inner_pos (Ω v : ℝ) (hΩ₀ : 0 ≤ Ω) (hΩ₁ : Ω ≤ 1) (hv : 0 < v) : 0 < Ω + (1 - Ω) * v ^ 6 := by
  rcases eq_or_lt_of_le hΩ₀ with h | h
  · subst h; have := pow_pos hv 6; linarith
  · have : 0 ≤ (1 - Ω) * v ^ 6 := mul_nonneg (by linarith) (by positivity)
    linarith

lemma sqrt_alg (Ω a₀ as W : ℝ) (hW : 0 < W) (ha₀ : 0 < a₀) (has : as = W ^ 2 * a₀)
    (hin : 0 < Ω + (1 - Ω) * W ^ 6) :
    √(Ω * (1 + (a₀ / as - 1)) ^ 3 + 1 - Ω) = √(Ω + (1 - Ω) * W ^ 6) / W ^ 3 := by
  rw [show Ω * (1 + (a₀ / as - 1)) ^ 3 + 1 - Ω = (√(Ω + (1 - Ω) * W ^ 6) / W ^ 3) ^ 2 by
    rw [div_pow, Real.sq_sqrt hin.le, has]; field_simp; ring]
  exact Real.sqrt_sq (by positivity)

lemma deriv_alg (H₀ a₀ as da S W : ℝ) (hW : 0 < W) (hS : 0 < S) (ha₀ : 0 < a₀) (hH : 0 < H₀)
    (has : as = W ^ 2 * a₀) (hda : da = as * H₀ * (S / W ^ 3)) :
    (2 / S * ((da / a₀) / (2 * W))) / (H₀ * a₀) = 1 / as := by
  subst has; subst hda; field_simp

