/-- Third-order Taylor polynomial of `a/a₀` in `x = H₀ (t₀ − t)`. -/
noncomputable def A3 (q j x : ℝ) : ℝ := 1 - x - q * x ^ 2 / 2 - j * x ^ 3 / 6

/-- Degree-2 truncation of `1/A3`. -/
noncomputable def B2 (q x : ℝ) : ℝ := 1 + x + (1 + q / 2) * x ^ 2

/-- `A3 B2 = 1 + x³ C3`. -/
noncomputable def C3 (q j x : ℝ) : ℝ :=
  -j*q*x^2/12 - j*x^2/6 - j*x/6 - j/6 - q^2*x/4 - q*x/2 - q - 1

/-- `∫₀ˣ B2`: the comoving distance `a₀ H₀ χ` to third order. -/
noncomputable def P3 (q x : ℝ) : ℝ := x + x ^ 2 / 2 + (2 + q) * x ^ 3 / 6

/-- `G(w) = w · S(1 − w)` with `S` the corrected series: `H₀ d_L = S(y)` becomes `a₀H₀χ = G(a/a₀)`. -/
noncomputable def G3 (q j w : ℝ) : ℝ := w * seriesY (correctD2y q j 1) q (1 - w)

/-- `P3 − G3(A3) = x⁴ W3`. -/
noncomputable def W3 (q j x : ℝ) : ℝ :=
  -j^5*x^8/7776 + j^4*q^2*x^8/2592 - 5*j^4*q*x^8/7776 - j^4*q*x^7/648 + 11*j^4*x^8/7776 - j^4*x^6/324 + j^4*x^5/1296 + j^3*q^3*x^7/216 - 5*j^3*q^2*x^7/648 + j^3*q^2*x^6/432 - j^3*q^2*x^5/432 + 11*j^3*q*x^7/648 - 5*j^3*q*x^6/324 - 17*j^3*q*x^5/648 + j^3*q*x^4/144 + 11*j^3*x^6/324 - j^3*x^5/648 - j^3*x^4/36 + j^3*x^3/72 + j^2*q^4*x^6/48 - 5*j^2*q^3*x^6/144 + 5*j^2*q^3*x^5/72 - j^2*q^3*x^4/48 + 11*j^2*q^2*x^6/144 - 5*j^2*q^2*x^5/36 + j^2*q^2*x^4/72 - j^2*q^2*x^3/48 + 11*j^2*q*x^5/36 - 11*j^2*q*x^4/72 - 5*j^2*q*x^3/36 + 7*j^2*q*x^2/72 + 11*j^2*x^4/36 - j^2*x^3/36 - j^2*x^2/8 + j^2*x/12 + j*q^5*x^5/24 - 5*j*q^4*x^5/72 + 23*j*q^4*x^4/96 - j*q^4*x^3/16 + 11*j*q^3*x^5/72 - 5*j*q^3*x^4/12 + 11*j*q^3*x^3/24 - 11*j*q^3*x^2/48 + 11*j*q^2*x^4/12 - 7*j*q^2*x^3/8 + j*q^2*x^2/4 - j*q^2*x/24 + 11*j*q*x^3/6 - 13*j*q*x^2/18 - j*q*x/4 + 5*j*q/12 + 11*j*x^2/9 - j*x/6 - j/3 + q^6*x^4/32 - 5*q^5*x^4/96 + q^5*x^3/4 - q^5*x^2/16 + 11*q^4*x^4/96 - 5*q^4*x^3/12 + 19*q^4*x^2/24 - 3*q^4*x/8 + 11*q^3*x^3/12 - 31*q^3*x^2/24 + 5*q^3*x/4 - 5*q^3/8 + 11*q^2*x^2/4 - 23*q^2*x/12 + 7*q^2/8 + 11*q*x/3 - 4*q/3 + 11/6

/-- `G3(u + e) − G3(u) = e Q3`. -/
noncomputable def Q3 (q j u e : ℝ) : ℝ :=
  e^3*j/6 - e^3*q^2/2 + 5*e^3*q/6 - 11*e^3/6 + 2*e^2*j*u/3 - e^2*j/2 - 2*e^2*q^2*u + 3*e^2*q^2/2 + 10*e^2*q*u/3 - 3*e^2*q - 22*e^2*u/3 + 7*e^2 + e*j*u^2 - 3*e*j*u/2 + e*j/2 - 3*e*q^2*u^2 + 9*e*q^2*u/2 - 3*e*q^2/2 + 5*e*q*u^2 - 9*e*q*u + 7*e*q/2 - 11*e*u^2 + 21*e*u - 19*e/2 + 2*j*u^3/3 - 3*j*u^2/2 + j*u - j/6 - 2*q^2*u^3 + 9*q^2*u^2/2 - 3*q^2*u + q^2/2 + 10*q*u^3/3 - 9*q*u^2 + 7*q*u - 4*q/3 - 22*u^3/3 + 21*u^2 - 19*u + 13/3

lemma idAB3 (q j x : ℝ) : A3 q j x * B2 q x = 1 + x ^ 3 * C3 q j x := by
  unfold A3 B2 C3; ring
lemma idW3 (q j x : ℝ) : P3 q x - G3 q j (A3 q j x) = x ^ 4 * W3 q j x := by
  unfold P3 G3 A3 W3 seriesY correctD2y D1y; ring
lemma idQ3 (q j u e : ℝ) : G3 q j (u + e) - G3 q j u = e * Q3 q j u e := by
  unfold G3 Q3 seriesY correctD2y D1y; ring
lemma hasDerivAt_P3 (q x : ℝ) : HasDerivAt (P3 q) (B2 q x) x := by
  have h := (((hasDerivAt_id x).add ((hasDerivAt_pow 2 x).div_const 2)).add
    (((hasDerivAt_pow 3 x).const_mul (2 + q)).div_const 6))
  convert h using 1
  · funext y; simp [P3]
  · simp [B2]; ring

/-- The key rearrangement: `H₀ d_L − S(y) = (a₀ H₀ χ − G(a/a₀)) / (a/a₀)`. -/
lemma key_alg (q j a₀ b H χ : ℝ) (ha₀ : a₀ ≠ 0) (hb : b ≠ 0) :
    H * (a₀ * (1 + (a₀ / b - 1)) * χ)
      - seriesY (correctD2y q j 1) q ((a₀ / b - 1) / (1 + (a₀ / b - 1)))
      = (a₀ * H * χ - G3 q j (b / a₀)) / (b / a₀) := by
  have e1 : 1 + (a₀ / b - 1) = a₀ / b := by ring
  rw [e1, show (a₀ / b - 1) / (a₀ / b) = 1 - b / a₀ by field_simp]
  unfold G3
  field_simp

/-! ### Analysis helpers (no cosmology) -/

/-- If `R(t₀) = 0` and `R' = o((t − t₀)ⁿ)`, then `R = o((t − t₀)ⁿ⁺¹)` (mean value inequality). -/
lemma littleO_of_hasDerivAt {R R' : ℝ → ℝ} {t₀ : ℝ} {n : ℕ} (hR0 : R t₀ = 0)
    (hd : ∀ᶠ t in 𝓝 t₀, HasDerivAt R (R' t) t)
    (ho : R' =o[𝓝 t₀] fun t => (t - t₀) ^ n) :
    R =o[𝓝 t₀] fun t => (t - t₀) ^ (n + 1) := by
  refine IsLittleO.of_bound fun c hc => ?_
  obtain ⟨δ, hδ, hball⟩ := Metric.eventually_nhds_iff_ball.1 (hd.and (ho.bound hc))
  refine Metric.eventually_nhds_iff_ball.2 ⟨δ, hδ, fun t ht => ?_⟩
  have hsub : Set.uIcc t₀ t ⊆ Metric.ball t₀ δ :=
    (convex_ball t₀ δ).ordConnected.uIcc_subset (Metric.mem_ball_self hδ) ht
  have key := (convex_uIcc t₀ t).norm_image_sub_le_of_norm_hasDerivWithin_le (f := R) (f' := R')
    (C := c * ‖(t - t₀) ^ n‖)
    (fun s hs => ((hball s (hsub hs)).1).hasDerivWithinAt)
    (fun s hs => by
      refine ((hball s (hsub hs)).2).trans ?_
      gcongr
      simp only [norm_pow, Real.norm_eq_abs]
      exact pow_le_pow_left₀ (abs_nonneg _) (Set.abs_sub_left_of_mem_uIcc hs) n)
    Set.left_mem_uIcc Set.right_mem_uIcc
  rw [hR0, sub_zero] at key
  calc ‖R t‖ ≤ c * ‖(t - t₀) ^ n‖ * ‖t - t₀‖ := key
    _ = c * ‖(t - t₀) ^ (n + 1)‖ := by rw [pow_succ, norm_mul]; ring

/-- `t − t₀ = O(f)` when `f(t₀) = 0` and `f'(t₀) ≠ 0`. -/
lemma sub_isBigO_of_hasDerivAt {f : ℝ → ℝ} {f' t₀ : ℝ} (hf : HasDerivAt f f' t₀) (h0 : f t₀ = 0)
    (hf' : f' ≠ 0) : (fun t => t - t₀) =O[𝓝 t₀] f := by
  have hz := hf
  rw [hasDerivAt_iff_isLittleO] at hz
  have h2 : (fun t => t - t₀) =O[𝓝 t₀] (fun t => (t - t₀) • f') := by
    refine IsBigO.of_bound (‖f'‖⁻¹) (Eventually.of_forall fun t => ?_)
    have hn : ‖f'‖ ≠ 0 := norm_ne_zero_iff.2 hf'
    rw [norm_smul, show ‖f'‖⁻¹ * (‖t - t₀‖ * ‖f'‖) = ‖t - t₀‖ by field_simp]
  have h3 := (hz.trans_isBigO h2).right_isBigO_add
  refine h2.trans (h3.congr_right fun t => ?_)
  simp [h0]

/-- `Xⁿ⁺¹ g = o(Xⁿ)` when `X → 0` and `g` is bounded. -/
lemma pow_succ_mul_isLittleO {α : Type*} {L : Filter α} {X : α → ℝ} (hX : Tendsto X L (𝓝 0))
    (n : ℕ) (g : α → ℝ) (hg : g =O[L] (fun _ => (1 : ℝ))) :
    (fun t => X t ^ (n + 1) * g t) =o[L] (fun t => X t ^ n) := by
  have h1 : (fun t => X t) =o[L] (fun _ => (1 : ℝ)) := (isLittleO_one_iff ℝ).2 hX
  have h2 := (isBigO_refl (fun t => X t ^ n) L).mul_isLittleO (h1.mul_isBigO hg)
  refine h2.congr' (Eventually.of_forall fun t => ?_) (Eventually.of_forall fun t => ?_)
  · simp only; ring
  · simp

lemma alg2 (H B A E x C : ℝ) (hw : A + E ≠ 0) (hab : A * B = 1 + x ^ 3 * C) :
    H * (B - (A + E)⁻¹) = H * ((x ^ 3 * C + E * B) * (A + E)⁻¹) := by
  field_simp
  linear_combination H * hab

lemma final_alg (q j a₀ b H χ x E : ℝ) (ha₀ : a₀ ≠ 0) (hb : b ≠ 0)
    (hwE : b / a₀ = A3 q j x + E) :
    H * (a₀ * (1 + (a₀ / b - 1)) * χ)
      - seriesY (correctD2y q j 1) q ((a₀ / b - 1) / (1 + (a₀ / b - 1)))
      = (x ^ 4 * W3 q j x + (a₀ * H * χ - P3 q x) - E * Q3 q j (A3 q j x) E)
        * (A3 q j x + E)⁻¹ := by
  rw [key_alg q j a₀ b H χ ha₀ hb, hwE, div_eq_mul_inv]
  congr 1
  linear_combination idW3 q j x - idQ3 q j (A3 q j x) E

lemma cont_A3 (q j : ℝ) : Continuous (A3 q j) := by unfold A3; fun_prop
lemma cont_B2 (q : ℝ) : Continuous (B2 q) := by unfold B2; fun_prop
lemma cont_C3 (q j : ℝ) : Continuous (C3 q j) := by unfold C3; fun_prop
lemma cont_W3 (q j : ℝ) : Continuous (W3 q j) := by unfold W3; fun_prop
lemma cont_Q3 (q j : ℝ) : Continuous (fun p : ℝ × ℝ => Q3 q j p.1 p.2) := by unfold Q3; fun_prop

lemma bdd_Q3 {α : Type*} {L : Filter α} (q j u₀ : ℝ) {U V : α → ℝ} (hU : Tendsto U L (𝓝 u₀))
    (hV : Tendsto V L (𝓝 0)) : (fun t => Q3 q j (U t) (V t)) =O[L] (fun _ => (1 : ℝ)) :=
  (((cont_Q3 q j).tendsto (u₀, 0)).comp (hU.prodMk_nhds hV)).isBigO_one ℝ

/-- **Luminosity distance to third order in `y`** (flat FLRW, correct `D²_{L,y}`): for every
scale factor that is `C³` at `t₀`, with `a(t₀) ≠ 0` and `H₀ ≠ 0`. -/
theorem lumDist_y_third_order (a : ℝ → ℝ) (t₀ : ℝ) (ha : ContDiffAt ℝ 3 a t₀)
    (ha0 : a t₀ ≠ 0) (hH : hubble a t₀ ≠ 0) :
    (fun t => remainderY correctD2y a t₀ t) =o[𝓝 t₀] (fun t => yred a t₀ t ^ 3) := by
  set a₀ := a t₀ with ha₀
  set H := hubble a t₀ with hHdef
  set q := decel a t₀ with hq
  set j := cosmoCoeff 3 a t₀ with hj
  have hd : DifferentiableAt ℝ a t₀ := ha.differentiableAt (by norm_num)
  -- a ball on which `a` is `C³` and nonzero
  obtain ⟨U, hU, hcd⟩ := ha.contDiffOn le_rfl (by simp)
  have hne : {t | a t ≠ 0} ∈ 𝓝 t₀ := hd.continuousAt.eventually_ne ha0
  obtain ⟨δ, hδ, hball⟩ := Metric.mem_nhds_iff.1 (Filter.inter_mem hU hne)
  set Bl := Metric.ball t₀ δ with hBl
  have hopen : IsOpen Bl := Metric.isOpen_ball
  have hmem : t₀ ∈ Bl := Metric.mem_ball_self hδ
  have hBl_nhds : Bl ∈ 𝓝 t₀ := hopen.mem_nhds hmem
  have hcdB : ContDiffOn ℝ 3 a Bl := hcd.mono fun t ht => (hball ht).1
  have hnz : ∀ t ∈ Bl, a t ≠ 0 := fun t ht => (hball ht).2
  have hcont : ContinuousOn a Bl := hcdB.continuousOn
  -- Taylor's theorem
  have hT := taylor_isLittleO (convex_ball t₀ δ) hmem hcdB
  rw [hopen.nhdsWithin_eq hmem] at hT
  have hid : ∀ k, iteratedDerivWithin k a Bl t₀ = iteratedDeriv k a t₀ :=
    fun k => iteratedDerivWithin_of_isOpen hopen hmem
  have d1 : iteratedDeriv 1 a t₀ = H * a₀ := by
    rw [iteratedDeriv_one]; simp only [hHdef, hubble]; rw [← ha₀]; field_simp
  have hd1 : deriv a t₀ ≠ 0 := by
    intro h0; apply hH; rw [hHdef]; simp [hubble, h0]
  have d2 : iteratedDeriv 2 a t₀ = -q * H ^ 2 * a₀ := by
    rw [iteratedDeriv_succ, iteratedDeriv_one]
    simp only [hq, decel, hHdef, hubble]; rw [← ha₀]; field_simp
  have d3 : iteratedDeriv 3 a t₀ = j * (a₀ * H ^ 3) := by
    simp only [hj, cosmoCoeff, hHdef]
    rw [div_mul_cancel₀]; exact mul_ne_zero ha0 (pow_ne_zero _ hH)
  have hpoly : ∀ t, taylorWithinEval a 3 Bl t₀ t = a₀ * A3 q j (H * (t₀ - t)) := by
    intro t
    rw [taylor_within_apply]
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, hid, smul_eq_mul]
    rw [iteratedDeriv_zero, d1, d2, d3]
    simp only [A3, Nat.factorial, Nat.cast_ofNat]
    push_cast
    ring
  set X : ℝ → ℝ := fun t => H * (t₀ - t) with hX
  set E : ℝ → ℝ := fun t => a t / a₀ - A3 q j (X t) with hE
  have hXc : Continuous X := by fun_prop
  have hXt : Tendsto X (𝓝 t₀) (𝓝 0) := by simpa [hX] using hXc.tendsto t₀
  have htX : ∀ n : ℕ, (fun t => (t - t₀) ^ n) =O[𝓝 t₀] fun t => X t ^ n := by
    intro n
    have : (fun t => t - t₀) =O[𝓝 t₀] X := by
      refine IsBigO.of_bound (‖H‖⁻¹) (Eventually.of_forall fun t => ?_)
      simp only [hX, norm_mul]
      rw [← mul_assoc, inv_mul_cancel₀ (norm_ne_zero_iff.2 hH), one_mul, ← norm_neg]; ring_nf; rfl
    exact this.pow n
  have hXt' : ∀ n : ℕ, (fun t => X t ^ n) =O[𝓝 t₀] fun t => (t - t₀) ^ n := by
    intro n
    have : X =O[𝓝 t₀] (fun t => t - t₀) := by
      refine IsBigO.of_bound (‖H‖) (Eventually.of_forall fun t => ?_)
      simp only [hX, norm_mul, ← norm_neg (t₀ - t)]; ring_nf; rfl
    exact this.pow n
  have hEo : E =o[𝓝 t₀] fun t => X t ^ 3 := by
    have h1 : E = fun t => a₀⁻¹ * (a t - taylorWithinEval a 3 Bl t₀ t) := by
      funext t; simp only [hE, hpoly, hX]; field_simp
    rw [h1]
    exact (hT.const_mul_left a₀⁻¹).trans_isBigO (htX 3)
  have hE0 : Tendsto E (𝓝 t₀) (𝓝 0) := by
    have : Tendsto (fun t => X t ^ 3) (𝓝 t₀) (𝓝 0) := by simpa using hXt.pow 3
    exact hEo.trans_tendsto this
  -- w = a/a₀ = A3(X) + E → 1
  have hA : Continuous (A3 q j) := cont_A3 q j
  have hw1 : Tendsto (fun t => A3 q j (X t) + E t) (𝓝 t₀) (𝓝 1) := by
    have h := ((hA.tendsto 0).comp hXt).add hE0
    rwa [show A3 q j 0 + 0 = 1 by simp [A3]] at h
  have hwinv : (fun t => (A3 q j (X t) + E t)⁻¹) =O[𝓝 t₀] (fun _ => (1 : ℝ)) :=
    (hw1.inv₀ one_ne_zero).isBigO_one ℝ
  have hwE : ∀ t, a t / a₀ = A3 q j (X t) + E t := fun t => by simp only [hE]; ring
  -- the comoving-distance remainder R = a₀ H χ − P3(X)
  set R : ℝ → ℝ := fun t => a₀ * H * comoving a t₀ t - P3 q (X t) with hR
  set R' : ℝ → ℝ := fun t => H * (B2 q (X t) - a₀ / a t) with hR'
  have hfc : ContinuousOn (fun s => 1 / a s) Bl := continuousOn_const.div hcont hnz
  have hderR : ∀ t ∈ Bl, HasDerivAt R (R' t) t := by
    intro t ht
    have hsub : Set.uIcc t t₀ ⊆ Bl := (convex_ball t₀ δ).ordConnected.uIcc_subset ht hmem
    have hχ : HasDerivAt (comoving a t₀) (-(1 / a t)) t :=
      intervalIntegral.integral_hasDerivAt_left ((hfc.mono hsub).intervalIntegrable)
        (hfc.stronglyMeasurableAtFilter hopen t ht) (hfc.continuousAt (hopen.mem_nhds ht))
    have hXd : HasDerivAt X (-H) t := by
      simpa using ((hasDerivAt_id t).const_sub t₀).const_mul H
    have hP := (hasDerivAt_P3 q (X t)).comp t hXd
    have := (hχ.const_mul (a₀ * H)).sub hP
    have e : R' t = a₀ * H * -(1 / a t) - B2 q (X t) * -H := by
      show H * (B2 q (X t) - a₀ / a t) = _
      field_simp; ring
    rw [e]; exact this
  have hR0 : R t₀ = 0 := by simp [hR, comoving, hX, P3]
  have hR'o : R' =o[𝓝 t₀] fun t => (t - t₀) ^ 2 := by
    have hC : Continuous (C3 q j) := cont_C3 q j
    have hB : Continuous (B2 q) := cont_B2 q
    have e1 : ∀ t ∈ Bl, R' t = H * ((X t ^ 3 * C3 q j (X t) + E t * B2 q (X t))
        * (A3 q j (X t) + E t)⁻¹) := by
      intro t ht
      have hw : A3 q j (X t) + E t ≠ 0 := by
        rw [← hwE]; exact div_ne_zero (hnz t ht) ha0
      have hab := idAB3 q j (X t)
      have ha' : a₀ / a t = (A3 q j (X t) + E t)⁻¹ := by rw [← hwE, inv_div]
      show H * (B2 q (X t) - a₀ / a t) = _
      rw [ha']
      exact alg2 H _ _ _ _ _ hw hab
    have b1 : (fun t => X t ^ 3 * C3 q j (X t)) =o[𝓝 t₀] fun t => X t ^ 2 :=
      pow_succ_mul_isLittleO hXt 2 _ (CCS.bdd hXt _ hC)
    have hX32 : (fun t => X t ^ 3) =o[𝓝 t₀] fun t => X t ^ 2 := by
      simpa using pow_succ_mul_isLittleO hXt 2 (fun _ => (1 : ℝ)) (isBigO_refl _ _)
    have b2 : (fun t => E t * B2 q (X t)) =o[𝓝 t₀] fun t => X t ^ 2 := by
      simpa using (hEo.trans hX32).mul_isBigO (CCS.bdd hXt _ hB)
    have b3 := (((b1.add b2).mul_isBigO hwinv).const_mul_left H)
    simp only [mul_one] at b3
    exact (b3.congr' (Filter.eventually_of_mem hBl_nhds fun t ht => (e1 t ht).symm)
      EventuallyEq.rfl).trans_isBigO (hXt' 2)
  have hRo : R =o[𝓝 t₀] fun t => X t ^ 3 :=
    (littleO_of_hasDerivAt hR0 (Filter.eventually_of_mem hBl_nhds hderR) hR'o).trans_isBigO
      (htX 3)
  -- assemble: remainder = (X⁴ W + R − E Q) / w on the ball
  have n1 : (fun t => X t ^ 4 * W3 q j (X t)) =o[𝓝 t₀] fun t => X t ^ 3 :=
    pow_succ_mul_isLittleO hXt 3 _ (CCS.bdd hXt _ (cont_W3 q j))
  have n3 : (fun t => E t * Q3 q j (A3 q j (X t)) (E t)) =o[𝓝 t₀] fun t => X t ^ 3 := by
    simpa using hEo.mul_isBigO (bdd_Q3 q j _ ((hA.tendsto 0).comp hXt) hE0)
  have hN := (((n1.add hRo).sub n3).mul_isBigO hwinv)
  simp only [mul_one] at hN
  have e2 : ∀ t ∈ Bl, remainderY correctD2y a t₀ t = (X t ^ 4 * W3 q j (X t) + R t
      - E t * Q3 q j (A3 q j (X t)) (E t)) * (A3 q j (X t) + E t)⁻¹ := fun t ht =>
    final_alg q j a₀ (a t) H (comoving a t₀ t) (X t) (E t) ha0 (hnz t ht) (hwE t)
  have hfin := hN.congr' (Filter.eventually_of_mem hBl_nhds fun t ht => (e2 t ht).symm)
    EventuallyEq.rfl
  -- X = O(y)
  have hy : HasDerivAt (fun t => yred a t₀ t) (-H) t₀ := by
    have h1 : HasDerivAt (fun t => 1 - a t / a₀) (-(deriv a t₀ / a₀)) t₀ :=
      (hd.hasDerivAt.div_const a₀).const_sub 1
    have h2 : (fun t => 1 - a t / a₀) =ᶠ[𝓝 t₀] fun t => yred a t₀ t :=
      Filter.eventually_of_mem hBl_nhds fun t ht => by
        have := hnz t ht
        simp only [yred, redshift, ← ha₀]
        rw [show 1 + (a₀ / a t - 1) = a₀ / a t by ring, eq_div_iff (div_ne_zero ha0 this)]
        field_simp
    simpa [hHdef, hubble] using h1.congr_of_eventuallyEq h2.symm
  have hy0 : yred a t₀ t₀ = 0 := by
    simp only [yred, redshift, ← ha₀, div_self ha0, sub_self, zero_div]
  have hXy : X =O[𝓝 t₀] fun t => yred a t₀ t := by
    have : X =O[𝓝 t₀] (fun t => t - t₀) := by simpa using hXt' 1
    exact this.trans (sub_isBigO_of_hasDerivAt hy hy0 (neg_ne_zero.2 hH))
  exact hfin.trans_isBigO (hXy.pow 3)

/-- `y` has derivative `−H₀` at `t₀`. -/
lemma hasDerivAt_yred (a : ℝ → ℝ) (t₀ : ℝ) (hd : DifferentiableAt ℝ a t₀) (ha0 : a t₀ ≠ 0) :
    HasDerivAt (fun t => yred a t₀ t) (-hubble a t₀) t₀ := by
  have h1 : HasDerivAt (fun t => 1 - a t / a t₀) (-(deriv a t₀ / a t₀)) t₀ :=
    (hd.hasDerivAt.div_const (a t₀)).const_sub 1
  have hne : ∀ᶠ t in 𝓝 t₀, a t ≠ 0 := hd.continuousAt.eventually_ne ha0
  have h2 : (fun t => 1 - a t / a t₀) =ᶠ[𝓝 t₀] fun t => yred a t₀ t := by
    filter_upwards [hne] with t ht
    simp only [yred, redshift]
    rw [show 1 + (a t₀ / a t - 1) = a t₀ / a t by ring, eq_div_iff (div_ne_zero ha0 ht)]
    field_simp
  simpa [hubble] using h1.congr_of_eventuallyEq h2.symm

/-- The difference between the printed and the corrected remainders is `(D²_corr − D²_printed) y³`. -/
lemma remainder_sub (a : ℝ → ℝ) (t₀ t : ℝ) :
    remainderY printedD2y a t₀ t - remainderY correctD2y a t₀ t
      = (11 - 5 * decel a t₀ + 3 * decel a t₀ ^ 2 - cosmoCoeff 3 a t₀) / 3 * yred a t₀ t ^ 3 := by
  simp only [remainderY, seriesY, printedD2y, correctD2y]; ring

/-- The printed `D²_{L,y}` fails in every flat `C³` model with `a(t₀) ≠ 0`, `H₀ ≠ 0` and
`11 − 5q₀ + 3q₀² − j₀ ≠ 0` (past emission only; the two-sided version follows). -/
theorem printedD2y_fails_past (a : ℝ → ℝ) (t₀ : ℝ) (ha : ContDiffAt ℝ 3 a t₀)
    (ha0 : a t₀ ≠ 0) (hH : hubble a t₀ ≠ 0)
    (hD : 11 - 5 * decel a t₀ + 3 * decel a t₀ ^ 2 - cosmoCoeff 3 a t₀ ≠ 0) :
    ¬ (fun t => remainderY printedD2y a t₀ t) =o[𝓝[<] t₀] (fun t => yred a t₀ t ^ 3) := by
  intro hp
  have hc := (lumDist_y_third_order a t₀ ha ha0 hH).mono (nhdsWithin_le_nhds (s := Set.Iio t₀))
  set c : ℝ := (11 - 5 * decel a t₀ + 3 * decel a t₀ ^ 2 - cosmoCoeff 3 a t₀) / 3 with hcdef
  have hc0 : c ≠ 0 := div_ne_zero hD (by norm_num)
  have hdiff : (fun t => c * yred a t₀ t ^ 3) =o[𝓝[<] t₀] (fun t => yred a t₀ t ^ 3) :=
    (hp.sub hc).congr' (Eventually.of_forall fun t => remainder_sub a t₀ t) EventuallyEq.rfl
  have hself : (fun t => yred a t₀ t ^ 3) =o[𝓝[<] t₀] (fun t => yred a t₀ t ^ 3) :=
    (hdiff.const_mul_left c⁻¹).congr' (Eventually.of_forall fun t => by
      simp only; rw [← mul_assoc, inv_mul_cancel₀ hc0, one_mul]) EventuallyEq.rfl
  have hd : DifferentiableAt ℝ a t₀ := ha.differentiableAt (by norm_num)
  have hev := (hasDerivAt_yred a t₀ hd ha0).eventually_ne (c := 0) (neg_ne_zero.2 hH)
  have hev' : ∀ᶠ t in 𝓝[<] t₀, yred a t₀ t ≠ 0 :=
    nhdsWithin_mono t₀ (fun t (ht : t < t₀) => ne_of_lt ht) hev
  have hfreq : ∃ᶠ t in 𝓝[<] t₀, ‖yred a t₀ t ^ 3‖ ≠ 0 :=
    (hev'.mono fun t ht => by simpa using ht).frequently
  exact isLittleO_irrefl' hfreq hself

/-- The printed `D²_{L,y}` (Bamba et al. 2012, Eq. (10.54)) fails in every flat model, scale factor `C³`
at `t₀` with `a(t₀) ≠ 0`, `H₀ ≠ 0` and `11 − 5q₀ + 3q₀² − j₀ ≠ 0`: the flat `d_L(y)` series with it is
not `d_L + o(y³)` as `t → t₀` (two-sided limit; past-only version: `printedD2y_fails_past`). -/
theorem printedD2y_fails (a : ℝ → ℝ) (t₀ : ℝ) (ha : ContDiffAt ℝ 3 a t₀)
    (ha0 : a t₀ ≠ 0) (hH : hubble a t₀ ≠ 0)
    (hD : 11 - 5 * decel a t₀ + 3 * decel a t₀ ^ 2 - cosmoCoeff 3 a t₀ ≠ 0) :
    ¬ (fun t => remainderY printedD2y a t₀ t) =o[𝓝 t₀] (fun t => yred a t₀ t ^ 3) :=
  fun hp => printedD2y_fails_past a t₀ ha ha0 hH hD
    (hp.mono (nhdsWithin_le_nhds (s := Set.Iio t₀)))

lemma deSitter_vals : hubble Real.exp 0 = 1 ∧ decel Real.exp 0 = -1 ∧ cosmoCoeff 3 Real.exp 0 = 1 := by
  refine ⟨by simp [hubble, Real.deriv_exp], by simp [decel, Real.deriv_exp], ?_⟩
  simp [cosmoCoeff, hubble, Real.deriv_exp, iteratedDeriv_eq_iterate, Real.iter_deriv_exp]

/-- The printed claim is false (witness: flat de Sitter, `a = exp`, `t₀ = 0`). -/
theorem bambaD2yClaim_false : ¬ BambaD2yClaim := by
  intro h
  obtain ⟨hH, hq, hj⟩ := deSitter_vals
  exact printedD2y_fails Real.exp 0 Real.contDiff_exp.contDiffAt (Real.exp_pos 0).ne'
    (by rw [hH]; norm_num) (by rw [hq, hj]; norm_num)
    (h Real.exp 0 Real.contDiff_exp Real.exp_pos (by rw [hH]; norm_num))

/-- The past-only reading is false (flat de Sitter). -/
theorem bambaD2yClaimPast_false : ¬ BambaD2yClaimPast := by
  intro h
  obtain ⟨hH, hq, hj⟩ := deSitter_vals
  exact printedD2y_fails_past Real.exp 0 Real.contDiff_exp.contDiffAt (Real.exp_pos 0).ne'
    (by rw [hH]; norm_num) (by rw [hq, hj]; norm_num)
    (h Real.exp 0 Real.contDiff_exp Real.exp_pos (by rw [hH]; norm_num))

end Checked.Cosmography.BambaY
