  have n1 : 0 ≤ ((841 / 2000 : ℝ) - √(1 / (4 * √2))) * (2 / √(3 + (1 - 3) * (√(1 / (4 * √2))) ^ 6)) :=
    mul_nonneg (by linarith) (by linarith)
  have n2 : 0 ≤ (√(1 / (4 * √2)) - (1051 / 2500 : ℝ)) * (2 / √(3 + (1 - 3) * (1051 / 2500 : ℝ) ^ 6)) :=
    mul_nonneg (by linarith) (by linarith)
  constructor <;> first | linarith | (norm_num at *; linarith)

