/-- The residual at one source from enclosures of its factors. -/
theorem resid3 (Z J L B H₀ κ Zl Zu Jl Ju Ll Lu Bl Bu : ℝ) (hH : 0 < H₀) (hκ : 0 < κ)
    (hZ : Zl ≤ Z) (hZ' : Z ≤ Zu) (hJ : Jl ≤ J) (hJ' : J ≤ Ju) (hL : Ll ≤ L) (hL' : L ≤ Lu)
    (hB : Bl ≤ B) (hB' : B ≤ Bu) (hZl : 0 < Zl) (hJl : 0 < Jl) (hLl : 0 < Ll) (hBl : 0 < Bl)
    (c1 : 98 / 100 * (Lu * Bu) ≤ Zl * Jl * κ) (c2 : Zu * Ju * κ ≤ 102 / 100 * (Ll * Bl)) :
    |5 * Real.logb 10 (Z / H₀ * J / (L / (H₀ * κ) * B)) - 0| ≤ 1 / 20 := by
  have hZ0 : 0 < Z := by linarith
  have hJ0 : 0 < J := by linarith
  have hL0 : 0 < L := by linarith
  have hB0 : 0 < B := by linarith
  have e : Z / H₀ * J / (L / (H₀ * κ) * B) = Z * J * κ / (L * B) := by field_simp
  rw [e]
  have a1 : Zl * Jl ≤ Z * J := mul_le_mul hZ hJ hJl.le hZ0.le
  have a2 : Z * J ≤ Zu * Ju := mul_le_mul hZ' hJ' hJ0.le (by linarith)
  have b1 : Ll * Bl ≤ L * B := mul_le_mul hL hB hBl.le hL0.le
  have b2 : L * B ≤ Lu * Bu := mul_le_mul hL' hB' hB0.le (by linarith)
  have hLB : 0 < L * B := by positivity
  apply resid_small
  · rw [le_div_iff₀ hLB]; nlinarith
  · rw [div_le_iff₀ hLB]; nlinarith

theorem pos3 (L B H₀ κ Ll Bl : ℝ) (hH : 0 < H₀) (hκ : 0 < κ) (hL : Ll ≤ L) (hB : Bl ≤ B) (hLl : 0 < Ll)
    (hBl : 0 < Bl) : 0 < L / (H₀ * κ) * B :=
  mul_pos (div_pos (by linarith) (by positivity)) (by linarith)

/-- The matter-density-three model with its three sources and the cubic `a₂ = 1/4`, `a₃ = 13/5`,
normalisation `κ H₀`: every hypothesis of the headline except the density range and the law, and the three
distance-modulus conditions. -/
theorem om3_data :
    let t₀ := tO 3
    let H₀ := hubble sa t₀
    tS 3 (4 * √2) ≤ tS 3 (2 * √2) ∧ tS 3 (2 * √2) ≤ tS 3 √2 ∧ tS 3 √2 ≤ t₀ ∧
      (∀ s ∈ Set.Icc (tS 3 (4 * √2)) t₀, 0 < sa s) ∧
      (∀ s ∈ Set.Icc (tS 3 (4 * √2)) t₀, DifferentiableAt ℝ sa s) ∧ 0 < H₀ ∧
      (∀ s ∈ Set.Icc (tS 3 (4 * √2)) t₀,
        hubble sa s = H₀ * √(3 * (1 + redshift sa t₀ s) ^ 3 + 1 - 3)) ∧
      redshift sa t₀ (tS 3 √2) = √2 - 1 ∧ redshift sa t₀ (tS 3 (2 * √2)) = 2 * √2 - 1 ∧
      redshift sa t₀ (tS 3 (4 * √2)) = 4 * √2 - 1 ∧ 0 < H₀ * (2739 / 2500 : ℝ) ∧
      0 < logPolyDL3 (1 / 4 : ℝ) (13 / 5 : ℝ) (H₀ * (2739 / 2500 : ℝ)) (redshift sa t₀ (tS 3 √2)) ∧
      0 < logPolyDL3 (1 / 4 : ℝ) (13 / 5 : ℝ) (H₀ * (2739 / 2500 : ℝ)) (redshift sa t₀ (tS 3 (2 * √2))) ∧
      0 < logPolyDL3 (1 / 4 : ℝ) (13 / 5 : ℝ) (H₀ * (2739 / 2500 : ℝ)) (redshift sa t₀ (tS 3 (4 * √2))) ∧
      |5 * Real.logb 10 (lumDistFlat sa t₀ (tS 3 √2) / logPolyDL3 (1 / 4 : ℝ) (13 / 5 : ℝ) (H₀ * (2739 / 2500 : ℝ))
        (redshift sa t₀ (tS 3 √2))) - 0| ≤ 1 / 20 ∧
      |5 * Real.logb 10 (lumDistFlat sa t₀ (tS 3 (2 * √2)) / logPolyDL3 (1 / 4 : ℝ) (13 / 5 : ℝ) (H₀ * (2739 / 2500 : ℝ))
        (redshift sa t₀ (tS 3 (2 * √2)))) - 0| ≤ 1 / 20 ∧
      |5 * Real.logb 10 (lumDistFlat sa t₀ (tS 3 (4 * √2)) / logPolyDL3 (1 / 4 : ℝ) (13 / 5 : ℝ) (H₀ * (2739 / 2500 : ℝ))
        (redshift sa t₀ (tS 3 (4 * √2)))) - 0| ≤ 1 / 20 := by
  intro t₀ H₀
  have hΩ : (1:ℝ) < 3 := by norm_num
  obtain ⟨s1, s2⟩ := sqrt2_bd
  obtain ⟨l1, l2⟩ := log10_bd
  obtain ⟨h0, h1, hc⟩ := tO_props 3 hΩ
  obtain ⟨ht5, -, hz5⟩ := tS_props 3 (4 * √2) hΩ (by linarith)
  obtain ⟨-, -, hz3⟩ := tS_props 3 (2 * √2) hΩ (by linarith)
  obtain ⟨-, h1O, hz1⟩ := tS_props 3 √2 hΩ (by linarith)
  obtain ⟨hp, hd, hH₀, hH⟩ := sa_hyps 3 (tO 3) (tS 3 (4 * √2)) h0 h1 hc ht5
  have hκ : (0:ℝ) < (2739 / 2500 : ℝ) := by norm_num
  have hHp : 0 < H₀ * (2739 / 2500 : ℝ) := mul_pos hH₀ hκ
  have d1 := sa_dL 3 √2 hΩ (by linarith)
  have d3 := sa_dL 3 (2 * √2) hΩ (by linarith)
  have d5 := sa_dL 3 (4 * √2) hΩ (by linarith)
  have p1 := poly3_eq (1 / 4 : ℝ) (13 / 5 : ℝ) (H₀ * (2739 / 2500 : ℝ)) (1 / 2) _ log_s2
  have p3 := poly3_eq (1 / 4 : ℝ) (13 / 5 : ℝ) (H₀ * (2739 / 2500 : ℝ)) (3 / 2) _ log_2s2
  have p5 := poly3_eq (1 / 4 : ℝ) (13 / 5 : ℝ) (H₀ * (2739 / 2500 : ℝ)) (5 / 2) _ log_4s2
  have e1 : √(1 / √2) = √(1 / √2) := rfl
  refine ⟨tS_anti 3 _ _ hΩ (by linarith) (by linarith), tS_anti 3 _ _ hΩ (by linarith) (by linarith), h1O,
    hp, hd, hH₀, hH, hz1, hz3, hz5, hHp, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hz1, p1]; exact pos3 _ _ _ _ _ _ hH₀ hκ l1 B3_1.1 (by norm_num) (by norm_num)
  · rw [hz3, p3]; exact pos3 _ _ _ _ _ _ hH₀ hκ l1 B3_3.1 (by norm_num) (by norm_num)
  · rw [hz5, p5]; exact pos3 _ _ _ _ _ _ hH₀ hκ l1 B3_5.1 (by norm_num) (by norm_num)
  · rw [d1, hz1, p1]
    exact resid3 _ _ _ _ _ _ _ _ _ _ _ _ _ _ hH₀ hκ s1 s2 J3_1.1 J3_1.2 l1 l2 B3_1.1 B3_1.2
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
  · rw [d3, hz3, p3]
    exact resid3 _ _ _ _ _ _ (2 * 1.41421) (2 * 1.41422) _ _ _ _ _ _ hH₀ hκ (by linarith) (by linarith)
      J3_3.1 J3_3.2 l1 l2 B3_3.1 B3_3.2
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
  · rw [d5, hz5, p5]
    exact resid3 _ _ _ _ _ _ (4 * 1.41421) (4 * 1.41422) _ _ _ _ _ _ hH₀ hκ (by linarith) (by linarith)
      J3_5.1 J3_5.2 l1 l2 B3_5.1 B3_5.2
      (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)

/-- Without `Ω ≤ 1`: the model of matter density three (`om3_data`), cubic third coefficient thirteen fifths. -/
theorem third_coefficient_lower_bound_h2 : necessity% Checked.Cosmography.B1A3Bound.third_coefficient_lower_bound 2 := by
  obtain ⟨o53, o31, o10, hp, hd, hH₀, hH, z1, z3, z5, hHp, p1, p3, p5, m1, m3, m5⟩ := om3_data
  exact ⟨3, by norm_num, sa, _, _, _, _, o53, o31, o10, hp, hd, hH₀, hH, z1, z3, z5, _, _, _, 0, hHp,
    p1, p3, p5, m1, m3, m5, by norm_num⟩

/-- Without the expansion law: the same model, the law's density read as one. -/
theorem third_coefficient_lower_bound_h9 : necessity% Checked.Cosmography.B1A3Bound.third_coefficient_lower_bound 9 := by
  obtain ⟨o53, o31, o10, hp, hd, hH₀, -, z1, z3, z5, hHp, p1, p3, p5, m1, m3, m5⟩ := om3_data
  exact ⟨1, by norm_num, le_rfl, sa, _, _, _, _, o53, o31, o10, hp, hd, hH₀, z1, z3, z5, _, _, _, 0, hHp,
    p1, p3, p5, m1, m3, m5, by norm_num⟩

