theorem bksh_poly4 (Ω : ℝ) (ha : (3 / 20 : ℝ) ≤ Ω) (hb : Ω ≤ (1 / 5 : ℝ)) :
    4 * ((219914277 / 100000000 : ℝ) + (-32965389 / 12500000 : ℝ) * Ω) * Qc Ω (3 * 0.6931471808) <
      8 * ((315528157 / 100000000 : ℝ) - (87339413 / 20000000 : ℝ) * Ω) * Qc Ω (2 * 0.6931471803) * (1 - 18 / 100 / 5 * (10 / 3 * 0.6931471808)) := by
  have h1 : 0 ≤ Ω - (3 / 20 : ℝ) := by linarith
  have h2 : 0 ≤ (1 / 5 : ℝ) - Ω := by linarith
  unfold Qc
  nlinarith [mul_nonneg (mul_nonneg h1 h1) h1, mul_nonneg (mul_nonneg h1 h1) h2,
    mul_nonneg (mul_nonneg h1 h2) h2, mul_nonneg (mul_nonneg h2 h2) h2, mul_nonneg h1 h2]

