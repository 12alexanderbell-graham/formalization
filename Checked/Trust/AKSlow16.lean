theorem seg1_ok : chainS (25/4 : ℚ) (5/2 : ℚ) sideS (fun e => linkOK e c16) [c8, c9, c10, c11, c12, c13, c14, c15] = true := by
  decide +kernel

theorem seg2_ok : chainS (25/4 : ℚ) (5/2 : ℚ) sideS (fun e => linkOK e c24) [c16, c17, c18, c19, c20, c21, c22, c23] = true := by
