/-! Falkner–Skan with the adverse pressure-gradient coefficient −1988/10000 (the tabulated row next to separation): the wall shear of every solution with positive second derivative that approaches the edge value faster than every exponential, and the existence of such a solution. Module `NegWallShear`, promoted from `Work/FalknerSkan/Neg1988.lean` (theorems `fs_neg1988_window`, `fs_neg1988_exists_decay` there). -/

namespace Checked.FalknerSkan.NegWallShear

open Set Filter Topology

/-- Falkner–Skan with β = −1988/10000: if (f, p, q) is a solution of f''' + f f'' + β(1 − f'²) = 0 on [0, ∞)
with f(0) = 0, p(0) = 0, p → 1, q > 0 on [0, ∞) and, for every M, `∀ᶠ (η : ℝ) in Filter.atTop, M * (1 - p η) ≤ q η`,
then 0.0052181 < q(0) < 0.0052182. -/
theorem fs_neg_wall_shear_window (f p q : ℝ → ℝ)
    (hf : ∀ η ∈ Ici (0 : ℝ), HasDerivWithinAt f (p η) (Ici 0) η)
    (hp : ∀ η ∈ Ici (0 : ℝ), HasDerivWithinAt p (q η) (Ici 0) η)
    (hq : ∀ η ∈ Ici (0 : ℝ), HasDerivWithinAt q (-(f η * q η) - (-1988 / 10000) * (1 - p η ^ 2)) (Ici 0) η)
    (hf0 : f 0 = 0) (hp0 : p 0 = 0) (hlim : Tendsto p atTop (𝓝 1))
    (hpos : ∀ η ∈ Ici (0 : ℝ), 0 < q η)
    (hdec : ∀ M : ℝ, ∀ᶠ η in atTop, M * (1 - p η) ≤ q η) :
    0.0052181 < q 0 ∧ q 0 < 0.0052182 :=
  Checked.FSAtt.N1988Core.window_core Checked.FSAtt.N1988Lo.chain Checked.FSAtt.N1988Hi.chain
    f p q hf hp hq hf0 hp0 hlim hpos hdec

/-- Falkner–Skan with β = −1988/10000: there is a solution (f, p, q) of f''' + f f'' + β(1 − f'²) = 0 on
[0, ∞) with f(0) = 0, p(0) = 0, p → 1, q > 0 on [0, ∞) and, for every M, `∀ᶠ (η : ℝ) in Filter.atTop, M * (1 - p η) ≤ q η`. -/
theorem fs_neg_wall_shear_exists_decay :
    ∃ f p q : ℝ → ℝ,
      (∀ η ∈ Ici (0 : ℝ), HasDerivWithinAt f (p η) (Ici 0) η) ∧
      (∀ η ∈ Ici (0 : ℝ), HasDerivWithinAt p (q η) (Ici 0) η) ∧
      (∀ η ∈ Ici (0 : ℝ), HasDerivWithinAt q (-(f η * q η) - (-1988 / 10000) * (1 - p η ^ 2)) (Ici 0) η) ∧
      f 0 = 0 ∧ p 0 = 0 ∧ Tendsto p atTop (𝓝 1) ∧
      (∀ η ∈ Ici (0 : ℝ), 0 < q η) ∧
      (∀ M : ℝ, ∀ᶠ η in atTop, M * (1 - p η) ≤ q η) :=
  Checked.FSAtt.N1988Core.exists_core Checked.FSAtt.N1988Lo.chain Checked.FSAtt.N1988Hi.chain

end Checked.FalknerSkan.NegWallShear
