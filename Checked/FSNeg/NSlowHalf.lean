theorem glue {P : ℝ → Prop} {a b : ℝ} (h1 : ∀ t ∈ Icc 0 a, P t) (h2 : ∀ t ∈ Icc a b, P t) :
    ∀ t ∈ Icc 0 b, P t := by
  intro t ht
  rcases le_total t a with h | h
  · exact h1 t ⟨ht.1, h⟩
  · exact h2 t ⟨h, ht.2⟩

/-- Every solution Y of Y' = vN t Y (the clamped adverse-sign K = 10 field) on [0, 5/4] (derivatives within the
interval) with Y(0) = (0, 0, 1/2): Slow: p < 1 and q > 0 on [0, L], and at L: 0 ≤ p, q < 3(1 − p), f > 11/30. -/
theorem chainC {Y : ℝ → ℝ × ℝ × ℝ}
    (hY : ∀ t ∈ Icc (0 : ℝ) (5 / 4 : ℝ), HasDerivWithinAt Y (vN t (Y t)) (Icc 0 (5 / 4 : ℝ)) t)
    (h0 : Y 0 = (0, 0, 1 / 2)) : Slow Y := by
  have hX : (((5/4 : ℚ) : ℚ) : ℝ) = (5 / 4 : ℝ) := by norm_num
  have hs : SolC (((5/4 : ℚ) : ℚ) : ℝ) 0 (fun t => (Y t).1) (fun t => (Y t).2.1) (fun t => (Y t).2.2) := by
    rw [hX]
    exact ⟨fun t ht => (hY t ht).fst, fun t ht => (hY t ht).snd.fst, fun t ht => (hY t ht).snd.snd⟩
  have z0 : ((c0.t0 : ℚ) : ℝ) = 0 := by simp [c0]
  have b0 : InBox c0 (fun t => (Y t).1) (fun t => (Y t).2.1) (fun t => (Y t).2.2) := by
    unfold InBox; simp only [z0, h0]
    simp only [V, c0, List.headD_cons]; push_cast; norm_num

  obtain ⟨b1, P0⟩ := segS_q0 (Φ := (fun _ p q t => p t < 1 ∧ 0 < q t)) (fun c hok hsd => sideS_spec c hok hsd) c10 [c1, c2, c3, c4, c5, c6, c7, c8, c9] c0 seg0_ok hs b0
  rw [z0] at P0
  obtain ⟨E, P1⟩ := endSl_q0 (Φ := (fun _ p q t => p t < 1 ∧ 0 < q t)) (fun c hok hsd => sideS_spec c hok hsd) [c11, c12, c13, c14, c15, c16, c17, c18, c19] c10 seg1_ok hs b1
  have A1 := glue P0 P1
  rw [hX] at E A1
  exact ⟨(5 / 4 : ℝ), by norm_num, A1, E.1, E.2.1, E.2.2⟩

