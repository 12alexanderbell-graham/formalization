  obtain ⟨E, P11⟩ := endSl_q0 (Φ := (fun _ p q t => p t < 1 ∧ 0 < q t)) (fun c hok hsd => sideS_spec c hok hsd) [c89, c90, c91, c92, c93, c94, c95] c88 seg11_ok hs b11
