theorem glue {P : ℝ → Prop} {a b : ℝ} (h1 : ∀ t ∈ Icc 0 a, P t) (h2 : ∀ t ∈ Icc a b, P t) :
    ∀ t ∈ Icc 0 b, P t := by
  intro t ht
  rcases le_total t a with h | h
  · exact h1 t ⟨ht.1, h⟩
  · exact h2 t ⟨h, ht.2⟩

/-- Every solution Y of Y' = vN t Y (the clamped adverse-sign K = 10 field) on [0, 3] (derivatives within the
interval) with Y(0) = (0, 0, 1009619629/1000000000): Slow: p < 1 and q > 0 on [0, L], and at L: 0 ≤ p, q < 3(1 − p), f > 11/30. -/
theorem chainC {Y : ℝ → ℝ × ℝ × ℝ}
    (hY : ∀ t ∈ Icc (0 : ℝ) (3 : ℝ), HasDerivWithinAt Y (vN t (Y t)) (Icc 0 (3 : ℝ)) t)
    (h0 : Y 0 = (0, 0, 1009619629 / 1000000000)) : Slow Y := by
  have hX : (((3 : ℚ) : ℚ) : ℝ) = (3 : ℝ) := by norm_num
  have hs : SolC (((3 : ℚ) : ℚ) : ℝ) 0 (fun t => (Y t).1) (fun t => (Y t).2.1) (fun t => (Y t).2.2) := by
    rw [hX]
    exact ⟨fun t ht => (hY t ht).fst, fun t ht => (hY t ht).snd.fst, fun t ht => (hY t ht).snd.snd⟩
  have z0 : ((c0.t0 : ℚ) : ℝ) = 0 := by simp [c0]
  have b0 : InBox c0 (fun t => (Y t).1) (fun t => (Y t).2.1) (fun t => (Y t).2.2) := by
    unfold InBox; simp only [z0, h0]
    simp only [V, c0, List.headD_cons]; push_cast; norm_num

  obtain ⟨b1, P0⟩ := segS_q0 (Φ := (fun _ p q t => p t < 1 ∧ 0 < q t)) (fun c hok hsd => sideS_spec c hok hsd) c8 [c1, c2, c3, c4, c5, c6, c7] c0 seg0_ok hs b0
  rw [z0] at P0
  obtain ⟨b2, P1⟩ := segS_q0 (Φ := (fun _ p q t => p t < 1 ∧ 0 < q t)) (fun c hok hsd => sideS_spec c hok hsd) c16 [c9, c10, c11, c12, c13, c14, c15] c8 seg1_ok hs b1
  have A1 := glue P0 P1
  obtain ⟨b3, P2⟩ := segS_q0 (Φ := (fun _ p q t => p t < 1 ∧ 0 < q t)) (fun c hok hsd => sideS_spec c hok hsd) c24 [c17, c18, c19, c20, c21, c22, c23] c16 seg2_ok hs b2
  have A2 := glue A1 P2
  obtain ⟨b4, P3⟩ := segS_q0 (Φ := (fun _ p q t => p t < 1 ∧ 0 < q t)) (fun c hok hsd => sideS_spec c hok hsd) c32 [c25, c26, c27, c28, c29, c30, c31] c24 seg3_ok hs b3
  have A3 := glue A2 P3
  obtain ⟨b5, P4⟩ := segS_q0 (Φ := (fun _ p q t => p t < 1 ∧ 0 < q t)) (fun c hok hsd => sideS_spec c hok hsd) c40 [c33, c34, c35, c36, c37, c38, c39] c32 seg4_ok hs b4
  have A4 := glue A3 P4
  obtain ⟨b6, P5⟩ := segS_q0 (Φ := (fun _ p q t => p t < 1 ∧ 0 < q t)) (fun c hok hsd => sideS_spec c hok hsd) c48 [c41, c42, c43, c44, c45, c46, c47] c40 seg5_ok hs b5
  have A5 := glue A4 P5
  obtain ⟨b7, P6⟩ := segS_q0 (Φ := (fun _ p q t => p t < 1 ∧ 0 < q t)) (fun c hok hsd => sideS_spec c hok hsd) c56 [c49, c50, c51, c52, c53, c54, c55] c48 seg6_ok hs b6
  have A6 := glue A5 P6
  obtain ⟨b8, P7⟩ := segS_q0 (Φ := (fun _ p q t => p t < 1 ∧ 0 < q t)) (fun c hok hsd => sideS_spec c hok hsd) c64 [c57, c58, c59, c60, c61, c62, c63] c56 seg7_ok hs b7
  have A7 := glue A6 P7
  obtain ⟨b9, P8⟩ := segS_q0 (Φ := (fun _ p q t => p t < 1 ∧ 0 < q t)) (fun c hok hsd => sideS_spec c hok hsd) c72 [c65, c66, c67, c68, c69, c70, c71] c64 seg8_ok hs b8
  have A8 := glue A7 P8
  obtain ⟨b10, P9⟩ := segS_q0 (Φ := (fun _ p q t => p t < 1 ∧ 0 < q t)) (fun c hok hsd => sideS_spec c hok hsd) c80 [c73, c74, c75, c76, c77, c78, c79] c72 seg9_ok hs b9
  have A9 := glue A8 P9
  obtain ⟨b11, P10⟩ := segS_q0 (Φ := (fun _ p q t => p t < 1 ∧ 0 < q t)) (fun c hok hsd => sideS_spec c hok hsd) c88 [c81, c82, c83, c84, c85, c86, c87] c80 seg10_ok hs b10
