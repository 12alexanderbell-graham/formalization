/-!
# Existence of the Peng–Robinson (revised κ) coexistence state at seven tenths of the critical temperature (run 2026-11-05T1828Z)

Promoted from `Work/Chemistry/PR78Exists.lean` in the same run (imports narrowed, namespace
changed; proofs unchanged). Generated by `runs/2026-11-05T1828Z/scripts/emit_pr78_exists.py` from
`Checked.Chemistry.RKExists`: for each pressure `π`, the maxima of `ψ θ π` on a liquid window and a
gas window (rational endpoints, in the lemmas) are continuous in `π`; for `π` in the window of
`Checked.Chemistry.PR78Reduced.reduced_window` every maximiser is interior, hence a point of the
isotherm; `K_lo`, `K_hi` give opposite signs of the difference of the maxima at the two ends of
the window; the intermediate value theorem gives equal maxima.
-/

namespace Checked.Chemistry.PR78Exists

open Real Set Checked.Chemistry.PR78Reduced

section
variable {θ : ℝ}

/-- `ψ θ` with the volume clamped to `x ≥ 1.1`. -/
noncomputable def ψc (θ p x : ℝ) : ℝ := ψ θ p (max x (11 / 10))

lemma ψc_eq {p x : ℝ} (h : 11 / 10 ≤ x) : ψc θ p x = ψ θ p x := by
  unfold ψc; rw [max_eq_left h]

lemma continuous_ψc : Continuous (fun z : ℝ × ℝ => ψc θ z.1 z.2) := by
  have hm : Continuous (fun z : ℝ × ℝ => max z.2 (11 / 10 : ℝ)) :=
    continuous_snd.max continuous_const
  have h1 : ∀ z : ℝ × ℝ, max z.2 (11 / 10 : ℝ) - 1 ≠ 0 := fun z =>
    (show (0:ℝ) < max z.2 (11 / 10) - 1 by linarith [le_max_right z.2 (11 / 10 : ℝ)]).ne'
  have h0 : ∀ z : ℝ × ℝ, max z.2 (11 / 10 : ℝ) ≠ 0 := fun z =>
    (show (0:ℝ) < max z.2 (11 / 10) by linarith [le_max_right z.2 (11 / 10 : ℝ)]).ne'
  have h2 : ∀ z : ℝ × ℝ, max z.2 (11 / 10 : ℝ) + 1 ≠ 0 := fun z =>
    (show (0:ℝ) < max z.2 (11 / 10) + 1 by linarith [le_max_right z.2 (11 / 10 : ℝ)]).ne'
  have r1 := sqrt2_bounds.2
  have h2 : ∀ z : ℝ × ℝ, max z.2 (11 / 10 : ℝ) + 1 + Real.sqrt 2 ≠ 0 := fun z =>
    (show (0:ℝ) < max z.2 (11 / 10) + 1 + Real.sqrt 2 by
      linarith [le_max_right z.2 (11 / 10 : ℝ), Real.sqrt_nonneg 2]).ne'
  have h3 : ∀ z : ℝ × ℝ, max z.2 (11 / 10 : ℝ) + 1 - Real.sqrt 2 ≠ 0 := fun z =>
    (show (0:ℝ) < max z.2 (11 / 10) + 1 - Real.sqrt 2 by
      linarith [le_max_right z.2 (11 / 10 : ℝ)]).ne'
  show Continuous (fun z : ℝ × ℝ => θ * Real.log (max z.2 (11 / 10) - 1)
    + Real.sqrt 2 / 4 * (Real.log (max z.2 (11 / 10) + 1 + Real.sqrt 2)
      - Real.log (max z.2 (11 / 10) + 1 - Real.sqrt 2)) - z.1 * max z.2 (11 / 10))
  exact ((continuous_const.mul ((hm.sub continuous_const).log h1)).add
    (continuous_const.mul ((((hm.add continuous_const).add continuous_const).log h2).sub
      (((hm.add continuous_const).sub continuous_const).log h3)))).sub (continuous_fst.mul hm)

lemma continuous_ψc_left (p : ℝ) : Continuous (ψc θ p) :=
  continuous_ψc.comp (continuous_const.prodMk continuous_id)

/-- Gas-window maximum minus liquid-window maximum of `ψ θ π`. -/
noncomputable def Dgap (θ p : ℝ) : ℝ :=
  sSup (ψc θ p '' Icc 400 1500) - sSup (ψc θ p '' Icc (11 / 10) (7 / 5))

lemma continuous_Dgap : Continuous (Dgap θ) := by
  show Continuous (fun p => sSup (ψc θ p '' Icc 400 1500) - sSup (ψc θ p '' Icc (11 / 10) (7 / 5)))
  exact ((isCompact_Icc (a := (400:ℝ)) (b := 1500)).continuous_sSup
      (f := fun p x => ψc θ p x) continuous_ψc).sub
    ((isCompact_Icc (a := (11 / 10 : ℝ)) (b := 7 / 5)).continuous_sSup
      (f := fun p x => ψc θ p x) continuous_ψc)

lemma exists_max (p a b : ℝ) (ha : 11 / 10 ≤ a) (hab : a ≤ b) :
    ∃ x ∈ Icc a b, sSup (ψc θ p '' Icc a b) = ψ θ p x ∧ ∀ y ∈ Icc a b, ψ θ p y ≤ ψ θ p x := by
  obtain ⟨x, hx, h1, h2⟩ := (isCompact_Icc (a := a) (b := b)).exists_sSup_image_eq_and_ge
    (nonempty_Icc.2 hab) (continuous_ψc_left (θ := θ) p).continuousOn
  refine ⟨x, hx, ?_, fun y hy => ?_⟩
  · rw [h1, ψc_eq (le_trans ha hx.1)]
  · have := h2 y hy
    rwa [ψc_eq (le_trans ha hy.1), ψc_eq (le_trans ha hx.1)] at this

lemma le_sSup_ψ (p a b z : ℝ) (ha : 11 / 10 ≤ a) (hz : z ∈ Icc a b) :
    ψ θ p z ≤ sSup (ψc θ p '' Icc a b) := by
  rw [← ψc_eq (θ := θ) (p := p) (le_trans ha hz.1)]
  exact le_csSup ((isCompact_Icc (a := a) (b := b)).bddAbove_image
    (continuous_ψc_left p).continuousOn) (mem_image_of_mem _ hz)

/-- Left of a point `d` where `g` stays above `g d`. -/
lemma ψ_le_of_ge {p x d : ℝ} (hx : 1 < x) (hxd : x ≤ d) (h : ∀ y ∈ Icc x d, g θ d ≤ g θ y) :
    ψ θ p x ≤ ψ θ p d + (p - g θ d) * (d - x) := by
  have m := ψ_mono (θ := θ) (p := g θ d) hx h ⟨le_rfl, hxd⟩ ⟨hxd, le_rfl⟩ hxd
  have key : ψ θ p x - ψ θ p d - (p - g θ d) * (d - x) = ψ θ (g θ d) x - ψ θ (g θ d) d := by
    unfold ψ; ring
  linarith

/-- Right of a point `d` where `g` stays below `g d`. -/
lemma ψ_le_of_le {p x d : ℝ} (hd : 1 < d) (hdx : d ≤ x) (h : ∀ y ∈ Icc d x, g θ y ≤ g θ d) :
    ψ θ p x ≤ ψ θ p d - (p - g θ d) * (x - d) := by
  have m := ψ_anti (θ := θ) (p := g θ d) hd h ⟨le_rfl, hdx⟩ ⟨hdx, le_rfl⟩ hdx
  have key : ψ θ p x - ψ θ p d + (p - g θ d) * (x - d) = ψ θ (g θ d) x - ψ θ (g θ d) d := by
    unfold ψ; ring
  linarith

lemma crit_of_max {p x a b : ℝ} (ha : 1 < a) (hax : a < x) (hxb : x < b)
    (hm : ∀ y ∈ Icc a b, ψ θ p y ≤ ψ θ p x) : g θ x = p := by
  have hloc : IsLocalMax (ψ θ p) x := (isMaxOn_iff.2 hm).isLocalMax (Icc_mem_nhds hax hxb)
  have := hloc.hasDerivAt_eq_zero (hasDerivAt_ψ θ p (by linarith))
  linarith

end

section
variable {θ : ℝ} (hθ0 : 7264348479 / 100000000000 ≤ θ) (hθ1 : θ ≤ 3632174889 / 50000000000)
include hθ0 hθ1

lemma gL_anti : AntitoneOn (g θ) (Icc (11 / 10) (7 / 5)) :=
  g_anti (by norm_num) (fun x hx => (q_neg_L hθ0 hθ1 (by linarith [hx.1]) (by linarith [hx.2])).le)

lemma gR_anti : AntitoneOn (g θ) (Icc 400 1500) :=
  g_anti (by norm_num) (fun x hx => (q_neg_right hθ0 hθ1 (by linarith [hx.1])).le)

lemma left_loc {p x : ℝ} (hp1 : 807 / 10000000 ≤ p) (hp2 : p ≤ 16147 / 200000000)
    (hx : x ∈ Icc (11 / 10 : ℝ) (7 / 5))
    (hm : ∀ y ∈ Icc (11 / 10 : ℝ) (7 / 5), ψ θ p y ≤ ψ θ p x) :
    6 / 5 ≤ x ∧ x ≤ 3023021 / 2500000 := by
  have gc : 16147 / 200000000 < g θ (6 / 5) := by
    have := g_mono_θ hθ0 (x := 6 / 5) (by norm_num)
    have : (16147 / 200000000 : ℝ) < g (7264348479 / 100000000000) (6 / 5) := by norm_num [g]
    linarith
  have gd : g θ (3023021 / 2500000) < 807 / 10000000 := (num_lo hθ0 hθ1).2.1
  have c_mem : (6 / 5 : ℝ) ∈ Icc (11 / 10 : ℝ) (7 / 5) := ⟨by norm_num, by norm_num⟩
  have d_mem : (3023021 / 2500000 : ℝ) ∈ Icc (11 / 10 : ℝ) (7 / 5) := ⟨by norm_num, by norm_num⟩
  constructor
  · by_contra hlt
    have hlt' : x < 6 / 5 := not_le.1 hlt
    have b := ψ_le_of_ge (θ := θ) (p := p) (by linarith [hx.1]) hlt'.le (fun y hy =>
      gL_anti hθ0 hθ1 ⟨by linarith [hx.1, hy.1], by linarith [hy.2]⟩ c_mem hy.2)
    have := mul_neg_of_neg_of_pos (by linarith : p - g θ (6 / 5) < 0)
      (by linarith : (0:ℝ) < 6 / 5 - x)
    linarith [hm _ c_mem]
  · by_contra hgt
    have hgt' : 3023021 / 2500000 < x := not_le.1 hgt
    have b := ψ_le_of_le (θ := θ) (p := p) (by norm_num) hgt'.le (fun y hy =>
      gL_anti hθ0 hθ1 d_mem ⟨by linarith [hy.1], by linarith [hy.2, hx.2]⟩ hy.1)
    have := mul_pos (by linarith : (0:ℝ) < p - g θ (3023021 / 2500000))
      (by linarith : (0:ℝ) < x - 3023021 / 2500000)
    linarith [hm _ d_mem]

lemma right_loc {p x : ℝ} (hp1 : 807 / 10000000 ≤ p) (hp2 : p ≤ 16147 / 200000000)
    (hx : x ∈ Icc (400 : ℝ) 1500) (hm : ∀ y ∈ Icc (400 : ℝ) 1500, ψ θ p y ≤ ψ θ p x) :
    886857 / 1000 ≤ x ∧ x ≤ 1000 := by
  have gc : 16147 / 200000000 < g θ (886857 / 1000) := (num_hi hθ0 hθ1).2.1
  have gd : g θ 1000 < 807 / 10000000 := by
    have := g_mono_θ hθ1 (x := 1000) (by norm_num)
    have : g (3632174889 / 50000000000) 1000 < (807 / 10000000 : ℝ) := by norm_num [g]
    linarith
  have c_mem : (886857 / 1000 : ℝ) ∈ Icc (400 : ℝ) 1500 := ⟨by norm_num, by norm_num⟩
  have d_mem : (1000 : ℝ) ∈ Icc (400 : ℝ) 1500 := ⟨by norm_num, by norm_num⟩
  constructor
  · by_contra hlt
    have hlt' : x < 886857 / 1000 := not_le.1 hlt
    have b := ψ_le_of_ge (θ := θ) (p := p) (by linarith [hx.1]) hlt'.le (fun y hy =>
      gR_anti hθ0 hθ1 ⟨by linarith [hx.1, hy.1], by linarith [hy.2]⟩ c_mem hy.2)
    have := mul_neg_of_neg_of_pos (by linarith : p - g θ (886857 / 1000) < 0)
      (by linarith : (0:ℝ) < 886857 / 1000 - x)
    linarith [hm _ c_mem]
  · by_contra hgt
    have hgt' : 1000 < x := not_le.1 hgt
    have b := ψ_le_of_le (θ := θ) (p := p) (by norm_num) hgt'.le (fun y hy =>
      gR_anti hθ0 hθ1 d_mem ⟨by linarith [hy.1], by linarith [hy.2, hx.2]⟩ hy.1)
    have := mul_pos (by linarith : (0:ℝ) < p - g θ 1000)
      (by linarith : (0:ℝ) < x - 1000)
    linarith [hm _ d_mem]

lemma Dgap_lo : 0 < Dgap θ (807 / 10000000) := by
  obtain ⟨x, hx, hS, hm⟩ := exists_max (θ := θ) (807 / 10000000) (11 / 10) (7 / 5) le_rfl (by norm_num)
  obtain ⟨c1, d1⟩ := left_loc hθ0 hθ1 le_rfl (by norm_num) hx hm
  obtain ⟨n1, n2, n3⟩ := num_lo hθ0 hθ1
  have hg : g θ x = 807 / 10000000 :=
    crit_of_max (by norm_num : (1:ℝ) < 11 / 10) (by linarith) (by linarith) hm
  have hx0 : (6046041 / 5000000 : ℝ) ≤ x := by
    by_contra h
    have h' := not_le.1 h
    have := gL_anti hθ0 hθ1 hx ⟨by norm_num, by norm_num⟩ h'.le
    linarith
  have hb := ψ_le_of_ge (θ := θ) (p := 807 / 10000000) (by linarith) d1 (fun y hy =>
    gL_anti hθ0 hθ1 ⟨by linarith [hy.1], by linarith [hy.2]⟩ ⟨by norm_num, by norm_num⟩ hy.2)
  have hprod := mul_le_mul_of_nonneg_left
    (by linarith : (3023021 / 2500000 : ℝ) - x ≤ 3023021 / 2500000 - 6046041 / 5000000)
    (by linarith : (0:ℝ) ≤ 807 / 10000000 - g θ (3023021 / 2500000))
  have hcomm : (807 / 10000000 - g θ (3023021 / 2500000)) * (3023021 / 2500000 - 6046041 / 5000000)
      = (3023021 / 2500000 - 6046041 / 5000000) * (807 / 10000000 - g θ (3023021 / 2500000)) :=
    mul_comm _ _
  have hK := K_lo hθ0 hθ1
  have hR := le_sSup_ψ (θ := θ) (807 / 10000000) 400 1500 (887247 / 1000) (by norm_num)
    ⟨by norm_num, by norm_num⟩
  unfold Dgap
  rw [hS]
  linarith

lemma Dgap_hi : Dgap θ (16147 / 200000000) < 0 := by
  obtain ⟨y, hy, hS, hm⟩ := exists_max (θ := θ) (16147 / 200000000) 400 1500 (by norm_num) (by norm_num)
  obtain ⟨c2, d2⟩ := right_loc hθ0 hθ1 (by norm_num) le_rfl hy hm
  obtain ⟨n1, n2, n3⟩ := num_hi hθ0 hθ1
  have hg : g θ y = 16147 / 200000000 :=
    crit_of_max (by norm_num : (1:ℝ) < 400) (by linarith) (by linarith) hm
  have hy0 : y ≤ 443429 / 500 := by
    by_contra h
    have h' := not_le.1 h
    have := gR_anti hθ0 hθ1 ⟨by norm_num, by norm_num⟩ hy h'.le
    linarith
  have hb := ψ_le_of_ge (θ := θ) (p := 16147 / 200000000) (by linarith) hy0 (fun z hz =>
    gR_anti hθ0 hθ1 ⟨by linarith [hz.1, hy.1], by linarith [hz.2]⟩ ⟨by norm_num, by norm_num⟩ hz.2)
  have hprod := mul_le_mul_of_nonneg_left
    (by linarith : (443429 / 500 : ℝ) - y ≤ 443429 / 500 - 886857 / 1000)
    (by linarith : (0:ℝ) ≤ 16147 / 200000000 - g θ (443429 / 500))
  have hcomm : (16147 / 200000000 - g θ (443429 / 500)) * (443429 / 500 - 886857 / 1000)
      = (443429 / 500 - 886857 / 1000) * (16147 / 200000000 - g θ (443429 / 500)) :=
    mul_comm _ _
  have hK := K_hi hθ0 hθ1
  have hL := le_sSup_ψ (θ := θ) (16147 / 200000000) (11 / 10) (7 / 5) (3023021 / 2500000) le_rfl
    ⟨by norm_num, by norm_num⟩
  unfold Dgap
  rw [hS]
  linarith

/-- **Existence** in reduced variables, for every `θ` in the certified interval. -/
theorem reduced_exists :
    ∃ x₁ x₂ p, 1 < x₁ ∧ x₁ < x₂ ∧ g θ x₁ = p ∧ g θ x₂ = p ∧ ψ θ p x₁ = ψ θ p x₂ := by
  obtain ⟨p, hp, hD⟩ := intermediate_value_Icc'
    (by norm_num : (807 / 10000000 : ℝ) ≤ 16147 / 200000000)
    (continuous_Dgap (θ := θ)).continuousOn
    (show (0:ℝ) ∈ Icc (Dgap θ (16147 / 200000000)) (Dgap θ (807 / 10000000)) from
      ⟨(Dgap_hi hθ0 hθ1).le, (Dgap_lo hθ0 hθ1).le⟩)
  obtain ⟨x, hx, hSx, hmx⟩ := exists_max (θ := θ) p (11 / 10) (7 / 5) le_rfl (by norm_num)
  obtain ⟨y, hy, hSy, hmy⟩ := exists_max (θ := θ) p 400 1500 (by norm_num) (by norm_num)
  obtain ⟨c1, d1⟩ := left_loc hθ0 hθ1 hp.1 hp.2 hx hmx
  obtain ⟨c2, d2⟩ := right_loc hθ0 hθ1 hp.1 hp.2 hy hmy
  have hgx := crit_of_max (by norm_num : (1:ℝ) < 11 / 10) (by linarith) (by linarith) hmx
  have hgy := crit_of_max (by norm_num : (1:ℝ) < 400) (by linarith) (by linarith) hmy
  unfold Dgap at hD
  rw [hSx, hSy] at hD
  exact ⟨x, y, p, by linarith [hx.1], by linarith [hx.2, hy.1], hgx, hgy, by linarith⟩

end

/-! ## Back to molar volumes -/

open Checked.Records Checked.Chemistry.CubicEOS Checked.Chemistry.Coexistence

set_option maxHeartbeats 4000000 in
/-- The reduced temperature `θ = R (0.7 T_c) b / a(0.7 T_c)` of the PR fluid at ω = 1 lies in the
certified interval (from the critical point; same steps as `Checked.Chemistry.PR78Core.pr78_unique_core`). -/
lemma theta_bounds (R ac b Tc vc : ℝ) (hac : 0 < ac) (hb : 0 < b) (hvc : b < vc)
    (hc : IsCriticalIsotherm (cubicP R ac b 2 (-1) Tc) vc) :
    7264348479 / 100000000000 ≤ R * (7 / 10 * Tc) * b / (ac * (1 + 343383 / 200000 * (1 - Real.sqrt (7 / 10))) ^ 2) ∧
      R * (7 / 10 * Tc) * b / (ac * (1 + 343383 / 200000 * (1 - Real.sqrt (7 / 10))) ^ 2) ≤ 3632174889 / 50000000000 := by
  have hD : 0 < vc ^ 2 + 2 * b * vc + (-1) * b ^ 2 := by nlinarith
  obtain ⟨hf, hx1, -, h2, h3⟩ := reduced R ac b 2 (-1) Tc vc hac hb (by norm_num) hvc hD hc
  set Pc := cubicP R ac b 2 (-1) Tc vc with hPc
  set x := vc / b with hx
  unfold critCubic at hf
  obtain ⟨lo, hi⟩ := root_bounds 3 x (3951373 / 1000000) (39513731 / 10000000) hx1
    (by linear_combination hf) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
  have hx1' : 0 < x - 1 := by linarith
  have hDx : 0 < x ^ 2 + 2 * x - 1 := by nlinarith
  have hNx : 0 < x ^ 2 - 2 * x - 1 := by nlinarith
  have hNne : x ^ 2 - 2 * x - 1 ≠ 0 := hNx.ne'
  have hDne : x ^ 2 + 2 * x - 1 ≠ 0 := hDx.ne'
  have hx1ne : x - 1 ≠ 0 := hx1'.ne'
  have h2xne : 2 * x + 2 ≠ 0 := by linarith
  have e2 : ((x - 1) * (2 * x + 2) - (x ^ 2 + 2 * x + -1)) / ((x - 1) ^ 2 * (2 * x + 2))
      = (x ^ 2 - 2 * x - 1) / ((x - 1) ^ 2 * (2 * x + 2)) := by congr 1; ring
  have e3 : (x ^ 2 + 2 * x + -1) ^ 2 * ((x - 1) * (2 * x + 2) - (x ^ 2 + 2 * x + -1)) /
      ((x - 1) ^ 4 * (2 * x + 2) ^ 2)
      = (x ^ 2 + 2 * x - 1) ^ 2 * (x ^ 2 - 2 * x - 1) / ((x - 1) ^ 4 * (2 * x + 2) ^ 2) := by
    congr 1; ring
  rw [e2] at h2
  rw [e3] at h3
  set Ob := (x ^ 2 - 2 * x - 1) / ((x - 1) ^ 2 * (2 * x + 2)) with hOb
  set Oa := (x ^ 2 + 2 * x - 1) ^ 2 * (x ^ 2 - 2 * x - 1) / ((x - 1) ^ 4 * (2 * x + 2) ^ 2) with hOa
  have hOb0 : 0 < Ob := by positivity
  have hOa0 : 0 < Oa := by positivity
  -- R T_c ≠ 0 and P_c > 0 are forced by the critical point
  have hRT : R * Tc ≠ 0 := by
    intro h0
    rw [h0, div_zero] at h2
    linarith
  have hPc0 : 0 < Pc := by
    have : 0 < ac * Pc / (R * Tc) ^ 2 := by rw [h3]; exact hOa0
    have hsq : 0 < (R * Tc) ^ 2 := by positivity
    have := (div_pos_iff_of_pos_right hsq).1 this
    exact pos_of_mul_pos_right this hac.le
  have hRT0 : 0 < R * Tc := by
    have : 0 < b * Pc / (R * Tc) := by rw [h2]; exact hOb0
    rcases lt_or_gt_of_ne hRT with hn | hp
    · exfalso
      have : b * Pc / (R * Tc) < 0 := div_neg_of_pos_of_neg (by positivity) hn
      linarith
    · exact hp
  -- θ at the critical point
  have hθc : R * Tc * b / ac = (x - 1) ^ 2 * (2 * x + 2) / (x ^ 2 + 2 * x - 1) ^ 2 := by
    have e : R * Tc * b / ac = (b * Pc / (R * Tc)) / (ac * Pc / (R * Tc) ^ 2) := by
      field_simp
    rw [e, h2, h3, hOb, hOa]
    exact Checked.Chemistry.PR78Core.alg_theta x hx1ne h2xne hDne hNne
  -- the Soave factor at 0.7 T_c
  have hS0 : (418330013 / 500000000) < Real.sqrt (7 / 10) := (Real.lt_sqrt (by norm_num)).2 (by norm_num)
  have hS1 : Real.sqrt (7 / 10) < (836660027 / 1000000000) := (Real.sqrt_lt' (by norm_num)).2 (by norm_num)
  set s := Real.sqrt (7 / 10) with hs
  have hk : (0.379642 + 1.48503 * 1 - 0.164423 * 1 ^ 2 + 0.016666 * 1 ^ 3 : ℝ) = 343383 / 200000 := by norm_num
  set α := (1 + 343383 / 200000 * (1 - s)) ^ 2 with hα
  have hα0 : (1 + 343383 / 200000 * (1 - (836660027 / 1000000000))) ^ 2 ≤ α :=
    pow_le_pow_left₀ (by norm_num) (by linarith) 2
  have hα1 : α ≤ (1 + 343383 / 200000 * (1 - (418330013 / 500000000))) ^ 2 :=
    pow_le_pow_left₀ (by linarith) (by linarith) 2
  have hαpos : 0 < α := lt_of_lt_of_le (by norm_num) hα0
  have ha0 : 0 < ac * α := mul_pos hac hαpos
  -- bounds of θ_c
