/-- Core of `Checked.Chemistry.PR78Acentric.pr78_omega1_exists` (same statement). -/
theorem pr78_exists_core (R ac b Tc vc : ℝ) (hac : 0 < ac) (hb : 0 < b) (hvc : b < vc)
    (hc : IsCriticalIsotherm (cubicP R ac b 2 (-1) Tc) vc) :
    ∃ vl vg ps, b < vl ∧
      IsMaxwellCoexistence
        (cubicP R (ac * (1 + (0.379642 + 1.48503 * 1 - 0.164423 * 1 ^ 2 + 0.016666 * 1 ^ 3) * (1 - Real.sqrt (7 / 10))) ^ 2)
          b 2 (-1) (7 / 10 * Tc)) vl vg ps ∧
      RoundsTo (ps / cubicP R ac b 2 (-1) Tc vc) 0.0100 4 ∧
      RoundsTo (acentric ps (cubicP R ac b 2 (-1) Tc vc)) 1.000 3 := by
  obtain ⟨t0, t1⟩ := theta_bounds R ac b Tc vc hac hb hvc hc
  have hk : (0.379642 + 1.48503 * 1 - 0.164423 * 1 ^ 2 + 0.016666 * 1 ^ 3 : ℝ) = 343383 / 200000 := by norm_num
  have hα : 0 < (1 + 343383 / 200000 * (1 - Real.sqrt (7 / 10)) : ℝ) ^ 2 := by
    have : Real.sqrt (7 / 10) < 1 := (Real.sqrt_lt' (by norm_num)).2 (by norm_num)
    have : (0:ℝ) < 1 + 343383 / 200000 * (1 - Real.sqrt (7 / 10)) := by nlinarith
    positivity
  have ha0 : 0 < ac * (1 + 343383 / 200000 * (1 - Real.sqrt (7 / 10))) ^ 2 := mul_pos hac hα
  set a := ac * (1 + 343383 / 200000 * (1 - Real.sqrt (7 / 10))) ^ 2 with ha
  set T := 7 / 10 * Tc with hT
  obtain ⟨x₁, x₂, p, h1, h12, hg1, hg2, hψ⟩ := reduced_exists (θ := R * T * b / a) t0 t1
  have hb0 : b ≠ 0 := hb.ne'
  have hK : 0 < a / b ^ 2 := by positivity
  have hl : b < b * x₁ := by nlinarith
  have hlg : b * x₁ < b * x₂ := mul_lt_mul_of_pos_left h12 hb
  have hM : IsMaxwellCoexistence (cubicP R a b 2 (-1) T) (b * x₁) (b * x₂) (a / b ^ 2 * p) := by
    refine ⟨hlg, ?_, ?_, ?_⟩
    · rw [cubicP_eq_g R a b T ha0 hb hl, mul_div_cancel_left₀ _ hb0, hg1]
    · rw [cubicP_eq_g R a b T ha0 hb (by linarith), mul_div_cancel_left₀ _ hb0, hg2]
    · rw [integral_cubicP R a b T ha0 hb hl hlg, mul_div_cancel_left₀ _ hb0,
        mul_div_cancel_left₀ _ hb0]
      have key : ψ (R * T * b / a) 0 x₂ - ψ (R * T * b / a) 0 x₁ = p * (x₂ - x₁) := by
        unfold ψ at hψ ⊢
        linear_combination -1 * hψ
      rw [key]
      ring
  rw [hk]
  obtain ⟨r1, r2⟩ := Checked.Chemistry.PR78Core.pr78_unique_core R ac b Tc vc (b * x₁) (b * x₂) (a / b ^ 2 * p)
    hac hb hvc hc hl (by rw [hk]; exact hM)
  exact ⟨b * x₁, b * x₂, a / b ^ 2 * p, hl, hM, r1, r2⟩

end Checked.Chemistry.PR78Exists
