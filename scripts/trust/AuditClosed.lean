import Work
/-!
# Closed audits stay closed (run 2026-11-04T1028Z; red team G, defect d03)

The records (STATE, run READMEs, the validation packet) say that blind restatements were "closed in
Lean" in `Work/**/*Audit*.lean`. The `work` CI job allows `sorry` (blind restatements are drafts), so a
closed audit theorem could silently be reopened with `sorry` and every check stayed green (d03).

`scripts/trust/audits.txt` lists every theorem of a `Work` module whose name contains `Audit` that
was closed (no `sorryAx` among its axioms) when the list was written. This script fails if a listed
theorem is missing or now depends on `sorryAx` or on any axiom outside the standard three.
`check_audits.py --base` makes the list shrink-only (a removal needs a LEDGER.md line naming it).
`AUDIT_WRITE=1 lake env lean scripts/trust/AuditClosed.lean` rewrites the list (growth is free).
-/
open Lean Elab Command

run_cmd do
  let env ← getEnv
  let std : List Name := [``propext, ``Classical.choice, ``Quot.sound]
  let mods := env.header.moduleNames
  let path : System.FilePath := "scripts/trust/audits.txt"
  if (← IO.getEnv "AUDIT_WRITE").isSome then
    let mut names : Array String := #[]
    for (n, ci) in env.constants.map₁.toList do
      if let .thmInfo _ := ci then
        if let some idx := env.getModuleIdxFor? n then
          let m := mods[idx.toNat]!
          if (`Work).isPrefixOf m && ((toString m).splitOn "Audit").length > 1 && !n.isInternal then
            let ax ← collectAxioms n
            if ax.all (std.contains ·) then names := names.push (toString n)
    let sorted := names.qsort (· < ·)
    IO.FS.writeFile path ("# Closed audit theorems (Work/**/*Audit*.lean; standard axioms only). Generated by\n" ++
      "# AUDIT_WRITE=1 lake env lean scripts/trust/AuditClosed.lean; checked in CI; shrink-only (check_audits.py --base).\n" ++
      String.join (sorted.toList.map (· ++ "\n")))
    logInfo m!"audits.txt written: {sorted.size} closed audit theorems"
  else
    let lines := (← IO.FS.lines path).filter fun l => !l.isEmpty && !l.startsWith "#"
    let mut bad : Array String := #[]
    for l in lines do
      let n := l.toName
      if !env.contains n then bad := bad.push s!"{l}: no such constant (a closed audit theorem was removed or renamed)"
      else
        let ax ← collectAxioms n
        let extra := ax.filter (!std.contains ·)
        if !extra.isEmpty then bad := bad.push s!"{l}: depends on {extra.toList} (a closed audit was reopened)"
    if bad.isEmpty then logInfo m!"closed audits: {lines.size} theorems, all on standard axioms"
    else throwError m!"closed audits reopened or removed:\n{String.intercalate "\n" bad.toList}"
