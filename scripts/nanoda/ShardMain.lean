import Export
import Std.Data.HashMap
open Lean

/-!
Sharded lean4export driver (part of the judge, annex 39.5; run 2026-11-07T0428Z, see LEDGER).

Identical to lean4export's own `Main.lean` (pinned tag v4.35.0) in what it exports for each constant
(`initState`, `dumpMetadata`, `dumpConstant`, the same per-constant reset of `noMDataExprs`) and in which
constants exist (`env.constants`, non-internal, exactly the default list of `Main.lean`). The only
difference: shard `i` of `k` exports only the constants whose defining module `m` satisfies
`shardOf m k = i` (plus, as always, everything they depend on). The shards partition the default list,
so the union of the `k` exports covers every constant of the unsharded export, and each shard is a
self-contained environment that nanoda checks on its own. Why: one export of all of `Checked` grew to
135 M lines and took 5 h 06 min on the CI runner (run 42306265048), past the 6-hour job limit once the
build is added; per-shard exporter state stays small.

Usage: exportshard <Module> <i> <k>        (prints the export to stdout, counts to stderr)

Assignment (run 2026-11-19T0228Z, see LEDGER): a module listed in `scripts/nanoda/shard_assignment.txt` (read from
the working directory; `<module> <shard>` per line, generated by `scripts/leanchecker_shard.py --assign` from measured
replay times) goes to its listed shard mod `k`; any other module keeps its FNV-1a shard. The shard is still a function
of the module name, so the shards still partition the default list. Why: the FNV-1a partition gave shard 2 about three
times the work of the others (nanoda shard 2 over 150 min, shards 0, 1, 3 in 92-100 min on 2026-11-19).

Assumed theorems of other shards (run 2026-11-20T1428Z, see LEDGER; `exportshard <Module> <i> <k> <assumed-file>`):
the per-declaration profile of nanoda (CI 44736861516, `.github/workflows/nanoda-profile.yml`) showed that about half
of every shard's work was re-checking the proofs of other shards' Checked modules, reached as dependencies (the
kernel-decided data modules `LE52QData`, `LE72QDataP*`, … in every shard, 2,700-6,300 worker-seconds per shard). With a
fourth argument, a theorem that (a) is not internal, (b) is defined in a module under `Checked`, and (c) has its module
in another shard is exported as an `axiom` with the same name, universe parameters and type, and its name is written
to `<assumed-file>` (one per line, components joined by dots as nanoda prints names) for nanoda's `permitted_axioms`.
Such a theorem is in that other shard's own list (a, c), so it is exported there in full and checked there; a shard
passes only if all `k` shards pass. So every theorem of the default list is still checked by nanoda, once, in its
own shard, and a shard assumes only statements that another shard checks; the theorem order of the environment is
acyclic, so the assumptions are well-founded (the same argument as leanchecker's per-module replay, which trusts the
imports it loads). Definitions, inductives and every other kind are exported as before (their values are needed for
reduction). Turning a theorem into an axiom can only make fewer terms type-check (an axiom never unfolds), so it
cannot make a shard pass that would fail. The driver refuses to run if the dot-joined name of an assumed theorem
equals that of any real axiom of the environment (nanoda compares names as such strings). Without the fourth
argument the export is exactly as before.
-/

/-- FNV-1a over the module name's string: deterministic across processes and machines. -/
def shardOf (m : Name) (k : Nat) : Nat :=
  let h := m.toString.foldl (fun (h : UInt64) c => (h ^^^ c.toNat.toUInt64) * 1099511628211) 14695981039346656037
  (h % k.toUInt64).toNat

/-- The committed assignment (module name string -> shard); empty if the file is absent. A malformed line fails. -/
def loadAssign : IO (Std.HashMap String Nat) := do
  let p : System.FilePath := "scripts/nanoda/shard_assignment.txt"
  if !(← p.pathExists) then return {}
  let mut m : Std.HashMap String Nat := {}
  for l in (← IO.FS.readFile p).splitOn "\n" do
    let l := l.replace "\r" ""
    if l == "" || l.startsWith "#" then continue
    match l.splitOn " " with
    | [a, b] =>
      match b.toNat? with
      | some n =>
        if m.contains a then throw (IO.userError s!"module listed twice: {a}")
        m := m.insert a n
      | none => throw (IO.userError s!"bad shard in line: {l}")
    | _ => throw (IO.userError s!"bad line: {l}")
  return m

/-- Emit the JSON object of one export line, as lean4export's `dumpConstant.dumpObj` does. -/
def emitObj (fields : List (String × Json)) : M Unit :=
  IO.println <| Json.mkObj fields |>.compress

/-- Export `c` and everything it needs, as lean4export's `dumpConstant` does, except that a theorem with
`assumed c = true` is exported as an axiom (name, universe parameters, type) and its value is not visited; its name is
added to `out`. Dependencies are emitted before the constant (post-order), so `dumpConstant` finds them visited. -/
partial def emitShard (assumed : Name → Bool) (out : IO.Ref (Array Name)) (c : Name) : M Unit := do
  if (← get).visitedConstants.contains c then return
  let some declar := (← read).env.find? c | dumpConstant c  -- lean4export's own handling of a missing constant
  if (declar.isUnsafe || declar.isPartial) && !(← get).exportUnsafe then return
  match declar with
  | .thmInfo val =>
    if assumed c then
      for d in val.type.getUsedConstants do emitShard assumed out d
      if (← get).visitedConstants.contains c then return
      modify fun st => { st with visitedConstants := st.visitedConstants.insert c }
      emitObj [
        ("axiom", Json.mkObj [
          ("name", ← dumpName val.name),
          ("levelParams", ← dumpUparams val.levelParams),
          ("type", ← dumpExpr val.type),
          ("isUnsafe", false)
        ])
      ]
      out.modify (·.push c)
    else
      for d in val.type.getUsedConstants do emitShard assumed out d
      for d in val.value.getUsedConstants do emitShard assumed out d
      dumpConstant c
  | .defnInfo val =>
    for d in val.type.getUsedConstants do emitShard assumed out d
    for d in val.value.getUsedConstants do emitShard assumed out d
    dumpConstant c
  | .opaqueInfo val =>
    for d in val.type.getUsedConstants do emitShard assumed out d
    for d in val.value.getUsedConstants do emitShard assumed out d
    dumpConstant c
  | _ => dumpConstant c  -- inductives, constructors, recursors, quotients, axioms: exactly lean4export

def main (args : List String) : IO UInt32 := do
  initSearchPath (← findSysroot)
  let (mod, iS, kS, assumedOut?) ← match args with
    | [m, a, b] => pure (m, a, b, none)
    | [m, a, b, f] => pure (m, a, b, some f)
    | _ => IO.eprintln "usage: exportshard <Module> <i> <k> [<assumed-file>]"; return 2
  let some i := iS.toNat? | return 2
  let some k := kS.toNat? | return 2
  if k == 0 || i ≥ k then IO.eprintln "need 0 ≤ i < k"; return 2
  let env ← importModules #[{ module := Syntax.decodeNameLit ("`" ++ mod) |>.get! }] {}
  let all := env.constants.toList.map Prod.fst |>.filter (!·.isInternal)
  let modOf (c : Name) : Name :=
    match env.getModuleIdxFor? c with
    | some idx => env.header.moduleNames[idx.toNat]!
    | none => mod.toName  -- constants added outside any imported module (none expected)
  let asg ← loadAssign
  let shardOfMod (m : Name) : Nat :=
    match asg.get? m.toString with
    | some n => n % k
    | none => shardOf m k
  IO.eprintln s!"exportshard: {asg.size} modules in scripts/nanoda/shard_assignment.txt"
  let mine := all.filter (fun c => shardOfMod (modOf c) == i)
  IO.eprintln s!"exportshard: shard {i} of {k}: {mine.length} of {all.length} constants"
  match assumedOut? with
  | none =>
    M.run env do
      let _ ← initState env []
      dumpMetadata
      for c in mine do
        modify (fun st => { st with noMDataExprs := {} })
        dumpConstant c
    return 0
  | some outPath =>
    let assumed (c : Name) : Bool :=
      !c.isInternal && (modOf c).getRoot == `Checked && shardOfMod (modOf c) != i &&
        (match env.find? c with | some (.thmInfo _) => true | _ => false)
    let out ← IO.mkRef (#[] : Array Name)
    M.run env do
      let _ ← initState env []
      dumpMetadata
      for c in mine do
        modify (fun st => { st with noMDataExprs := {} })
        emitShard assumed out c
    let names ← out.get
    let strs := names.map (·.toString (escape := false))
    -- nanoda matches permitted axioms by these strings: none may be the string of a real axiom of the environment
    let mut axStrs : Std.HashMap String Name := {}
    for (n, ci) in env.constants.toList do
      if let .axiomInfo _ := ci then axStrs := axStrs.insert (n.toString (escape := false)) n
    for (s, n) in strs.zip names do
      if let some a := axStrs.get? s then
        IO.eprintln s!"exportshard: assumed theorem {n} has the same name string as the axiom {a}; refusing"
        return 1
    IO.FS.writeFile outPath (String.intercalate "\n" strs.toList ++ (if strs.isEmpty then "" else "\n"))
    IO.eprintln s!"exportshard: shard {i} of {k}: {names.size} theorems of other shards' Checked modules exported as assumed axioms (checked in their own shards)"
    return 0
